function curriculumChunk5_() {
  return {"grade6":{"g6-main-w4-lab":{"id":"g6-main-w4-lab","number":8,"week":4,"track":"main","type":"lab","title":"Output Triage Clinic (Lab)","summary":"Groups rotate through four output stations, diagnose each as correct, incorrect or unclear, choose a verification action, and rank them all on a trust ladder they must defend.","duration":"45 minutes","strands":["CE"],"objectives":["Apply a triage routine to a set of curated outputs and record correct/incorrect/unclear with reasons.","Rank outputs from most to least trustworthy and defend the order.","Choose a verification action for each untrustworthy output."],"sections":[{"type":"text","heading":"Output Triage Clinic (Lab)","body":["Welcome to the triage clinic. Each output is a patient waiting for a diagnosis - correct, incorrect, or unclear - and a treatment: the action you would take to verify it. By the end you will have ranked them all on a trust ladder."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run the triage routine across a full set of outputs.","I can rank outputs by trustworthiness and defend my order.","I can choose a verification action for outputs I cannot trust."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Triage","definition":"Quickly sorting items by how they need to be handled."},{"term":"Verification action","definition":"The concrete step you take to check whether an output is true."},{"term":"Trust ladder","definition":"An ordering of outputs from most to least trustworthy."},{"term":"Risk check","definition":"Asking what could go wrong if an output were used as-is."}],"role":"vocabulary"},{"type":"text","heading":"Match the check to the output","body":["A fact needs a trusted source. A summary needs comparing back to the original text. A vague instruction needs a clearer prompt before you can even judge it.","Choosing the right check is what turns a guess into a verified judgement."],"role":"explain"},{"type":"text","heading":"Rank and defend","body":["After triaging, place your outputs on the [[trust ladder]] from most to least trustworthy.","Be ready to defend your order using signals, not preferences: what evidence puts one output above another?"],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Rotate through four stations. Triage each output, choose a verification action, then rank them all on the trust ladder and prepare to defend your order."],"items":["Read the task and output at each station.","Assign a verdict and write a checkable reason.","Choose a verification action that fits the output type.","Rank all outputs on the trust ladder.","Agree your group's defence and one risk of the least trustworthy output."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which verification action was hardest to choose, and why?","Did any output move up or down the ladder after you discussed it?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one verification action you will reuse in a future task.","Describe how you would explain your ranking to another group."],"role":"reflect"}],"worksheet":{"title":"Week 4 - Lab - Worksheet | Output Triage Clinic (Lab)","questions":[{"id":"g6-main-w4-lab-aq1","type":"matching","marks":4,"prompt":"At each clinic station, match the output to the verification action that fits it.","left":[{"id":"L1","text":"An output that states the Burj Khalifa is 828 m tall."},{"id":"L2","text":"An output that summarises the article your group read at the station."},{"id":"L3","text":"An output that says \"follow the steps in the usual order\" without listing any steps."},{"id":"L4","text":"An output that says 4 tickets at 25 AED each cost 90 AED in total."}],"right":[{"id":"R1","text":"Look the height up in a trusted reference or official website."},{"id":"R2","text":"Put it side by side with the original article and see whether it matches."},{"id":"R3","text":"Write a clearer prompt asking for the steps to be listed one by one."},{"id":"R4","text":"Work the calculation out yourself and compare the totals."}],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Well matched - a claimed fact needs a trusted source, a summary needs the original text, a vague output needs a clearer prompt, and a calculation you can redo yourself.","incorrect":"Match the check to the kind of output: facts go to a trusted source, summaries go back to the original text, vague outputs need re-prompting before they can be judged, and sums can simply be redone."},"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"}},{"id":"g6-main-w4-lab-aq2","type":"mcq","marks":2,"prompt":"Your group put Output A above Output B on the trust ladder. Which defence of that order uses a trust signal rather than a preference?","options":[{"id":"a","text":"A gives a source we looked up and it matched; B states a number with no source anyone can check."},{"id":"b","text":"A is shorter and easier to read than B."},{"id":"c","text":"A sounds more sure of itself than B does."},{"id":"d","text":"Most of our group liked A better than B."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is a signal-based defence: it points to evidence - a source that was checked - that another group could check too.","incorrect":"Length, confidence and what your group likes are preferences; a defence has to point to evidence, such as a source that was checked or a match to the task."}},{"id":"g6-main-w4-lab-aq3","type":"ordering","marks":4,"prompt":"Put the five steps of the clinic routine in the order your group should work through them.","items":[{"id":"i1","text":"Read the task and the output at the station."},{"id":"i2","text":"Assign a verdict and write a checkable reason."},{"id":"i3","text":"Choose a verification action that fits that type of output."},{"id":"i4","text":"Rank all the outputs on the trust ladder."},{"id":"i5","text":"Agree your group's defence of the order and one risk of the least trustworthy output."}],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Yes - you can only rank outputs against each other once every one of them has its own verdict, reason and check.","incorrect":"Each output is triaged and given a check first; the ladder compares outputs, so it can only be built after every station has a verdict and reason, and the defence comes last."},"answer":["i1","i3","i2","i4","i5"]},{"id":"g6-main-w4-lab-aq4","type":"multi","marks":3,"prompt":"Select ALL the outputs that belong near the BOTTOM of the trust ladder, as the least trustworthy.","options":[{"id":"a","text":"An output that gives a statistic but names no source, so nobody in the group can check it."},{"id":"b","text":"An output whose date clashes with the date printed on the station card."},{"id":"c","text":"An output that answers a different question from the one the task asked."},{"id":"d","text":"An output that matched the original article line by line when the group compared them."},{"id":"e","text":"An output that sets its answer out in a neatly labelled table."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Good - no source, a clash with the station card, and answering the wrong task are all trust signals pushing an output down the ladder.","incorrect":"Low trust comes from signals: nothing to check against, a clash with a source, or not answering the task. A neat table is only presentation, and an output that matched the original belongs near the top."}},{"id":"g6-main-w4-lab-aq5","type":"fillBlank","marks":2,"prompt":"Complete the clinic's rule for choosing a check. Write one word in each gap.\nA claimed fact needs a trusted ______, but a summary needs comparing back to the ______ text.","blanks":["",""],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Exactly - the check has to match the output: facts are checked against a trusted source, summaries against the text they came from.","incorrect":"A fact is checked against a trusted source, but a summary can only be checked against the original text it was made from - a website cannot tell you whether the summary matches your article."},"answer":[["source","sources","a source","the source"],["original","the original","originals"]]}]},"formative":{"targets":"Directly checks 'identifies when outputs are incorrect or unclear'","check":"Completed clinic record sheet plus a defended trust-ladder ranking","successCriteria":"Triages the full set with valid reasons, chooses a verification action each, and defends a sensible ranking.","evidence":"Clinic record sheet and trust ladder photo."}},"g6-main-w5-core":{"id":"g6-main-w5-core","number":9,"week":5,"track":"main","type":"core","title":"Risks and Responsible Use","summary":"Students meet the two basic risk families of AI use - accuracy and safety/privacy - name who each risk could affect, and agree responsible-use rules that reduce them.","duration":"45 minutes","strands":["GE"],"objectives":["Identify at least two basic risks of using AI tools (e.g., incorrect output, unsafe or private data use).","Explain why each risk matters and who it could affect.","State one responsible-use rule that reduces a risk."],"sections":[{"type":"text","heading":"Risks and Responsible Use","body":["An AI answer can look helpful and still put someone at risk - through a mistake you did not check, or through personal data you should never have shared.","Today you learn to spot those risks and to name the rule that keeps people safe."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can name two genuine risks of using an AI tool.","I can explain who each risk could affect.","I can state a responsible-use rule that reduces a risk."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Risk","definition":"Something that could go wrong when using a tool."},{"term":"Accuracy risk","definition":"The danger of acting on an incorrect output."},{"term":"Privacy","definition":"Keeping personal or identifying information safe and unshared."},{"term":"Personal data","definition":"Information that identifies a person, like a name, address, or photo."},{"term":"Responsible-use rule","definition":"An agreed habit that reduces a risk."}],"role":"vocabulary"},{"type":"text","heading":"Two risk families","body":["**Accuracy risk** is the danger of using a confident but incorrect output without checking it. The mistake can spread into your work and anyone who trusts it.","**Safety and privacy risk** is the danger of entering [[personal data]] or identifying data, which may be stored or used to train future systems and could expose you or someone else."],"role":"explain"},{"authored":true,"type":"diagram","variant":"branch","label":"Two families, different responses","heading":"What kind of risk is this?","source":"Something that could go wrong","altText":"A risk splits into two families: the output being wrong, and the tool being used unsafely. Each has a different response.","branches":[{"label":"The output is wrong","detail":"→ check it before anyone acts on it"},{"label":"The use is unsafe","detail":"→ change what goes in, or do not use it","accent":true}],"caption":"Naming the family tells you the response. **Checking harder does not fix a privacy problem**, and removing personal details does not make a wrong fact right.","role":"diagram"},{"type":"text","heading":"Every risk has a who","body":["A real risk always names who could be harmed - you, a classmate, or your family.","[[Responsible-use rule]]s are simple habits, agreed together, that reduce a risk: verify before you use, never enter personal data, and tell an adult if you are unsure."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Sort each scenario into a risk family, name who is affected, and choose a responsible-use rule that would reduce the risk."],"items":["Read the scenario card.","Decide: accuracy risk or safety/privacy risk.","Name who could be affected.","Attach a responsible-use rule that reduces the risk."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which risk do you think is easiest to forget about, and why?","Is a rule useful if it is too hard to follow?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one responsible-use rule you will follow from now on.","Describe a situation where you would refuse to enter data into a tool."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Core - Worksheet | Risks and Responsible Use","questions":[{"id":"g6-main-w5-core-aq1","type":"mcq","marks":2,"prompt":"Layla asks an AI tool what time the school science fair opens. She copies the answer straight onto a poster that goes up in the main corridor. Which risk family is this, and who could it affect?","options":[{"id":"a","text":"Accuracy risk - if the time is wrong, everyone who reads the poster could arrive at the wrong time."},{"id":"b","text":"Accuracy risk - but only Layla is affected, because it is her poster."},{"id":"c","text":"Safety and privacy risk - the AI tool now knows when the science fair is."},{"id":"d","text":"Safety and privacy risk - Layla typed a question into a tool that may store what she asks."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Exactly - an unchecked output is an accuracy risk, and the harm spreads to everyone who trusts the work it goes into.","incorrect":"No personal data was entered here, so this is an accuracy risk - and a wrong time on a public poster reaches far more people than just Layla."}},{"id":"g6-main-w5-core-aq2","type":"multi","marks":3,"prompt":"Ravi wants an AI tool to tidy up the wording of a party invitation. Before he types his draft into the tool, which details should he take out?","options":[{"id":"a","text":"His classmate Sara Ahmed's full name"},{"id":"b","text":"His home address, Villa 12, Al Rayyan Street"},{"id":"c","text":"His mother's mobile number"},{"id":"d","text":"The fact that the party starts at four o'clock"},{"id":"e","text":"The fact that there will be pizza and a cake"}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - names, addresses and phone numbers identify real people, so they are the parts that create a privacy risk if the tool stores them.","incorrect":"The risk is in details that identify a person - a full name, an address, a phone number. A start time and a menu identify nobody."}},{"id":"g6-main-w5-core-aq3","type":"matching","marks":3,"prompt":"Match each situation to the responsible-use rule that would reduce its risk.","left":[{"id":"L1","text":"Omar pastes an AI answer about how volcanoes form straight into his science report."},{"id":"L2","text":"Mei types a classmate's full name and home address into a chatbot so it can write a thank-you note."},{"id":"L3","text":"Yusuf finds a new AI app online and is not sure whether it is safe to use for homework."}],"right":[{"id":"R1","text":"Never enter personal or identifying data into an AI tool."},{"id":"R2","text":"Tell an adult if you are unsure about a tool."},{"id":"R3","text":"Check the output against a trusted source before you use it."}],"answer":{"L1":"R3","L2":"R1","L3":"R2"},"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Good matching - a rule only counts as useful when it actually reduces the particular risk in front of you.","incorrect":"Ask what could go wrong in each case: a wrong fact needs checking, identifying details should never be typed in, and an unknown tool needs an adult."}},{"id":"g6-main-w5-core-aq4","type":"ordering","marks":4,"prompt":"Put the four steps of the risk-check routine into the order the lesson uses them.","items":[{"id":"i1","text":"Name who could be affected."},{"id":"i2","text":"Read the scenario."},{"id":"i3","text":"Attach a responsible-use rule that reduces the risk."},{"id":"i4","text":"Decide whether it is an accuracy risk or a safety and privacy risk."}],"answer":["i2","i4","i1","i3"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is the chain - risk, then who, then rule. The rule comes last because it has to fit the risk you named.","incorrect":"You cannot pick a rule until you know what the risk is and who it could harm, so the rule is always the last step."}},{"id":"g6-main-w5-core-aq5","type":"truefalse","marks":1,"prompt":"True or false: a mistake in an AI answer only affects the person who asked the question.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Correct - an unchecked mistake spreads into your work and on to anyone who trusts it, which is why every risk has a who.","incorrect":"Think about where the answer ends up: in a report, a poster or a message, so the mistake reaches everyone who trusts that work."}}]},"formative":{"targets":"Directly checks 'recognises basic risks (incorrect outputs, unsafe use)'","check":"Risk-spotting exit card: name two risks + one responsible-use rule","successCriteria":"Names two genuine risks, explains who is affected, and states a matching responsible-use rule.","evidence":"Risk-spotting card."}},"g6-main-w5-lab":{"id":"g6-main-w5-lab","number":10,"week":5,"track":"main","type":"lab","title":"Class AI Risk Audit (Lab)","summary":"Groups act as a class safety board, auditing an anonymised AI use-log against the rules, ranking the gaps on a likelihood-impact matrix, and proposing one rule to fix the top-priority risk.","duration":"45 minutes","strands":["GE"],"objectives":["Audit the class's own AI use against a responsible-use rule set and propose one improvement.","Rank risks by likelihood and impact on a simple risk matrix and choose which to mitigate first.","Write one responsible-use rule to close a gap found in the audit."],"sections":[{"type":"text","heading":"Class AI Risk Audit (Lab)","body":["Today your group becomes a class safety board. You will audit how AI has actually been used, rank the risks you find, and decide which one to fix first - then write the rule that fixes it."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can audit our AI use against a rule set and find a gap.","I can place risks on a matrix by likelihood and impact.","I can propose one rule to reduce the highest-priority risk."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Audit","definition":"Checking real practice against a set of rules to find gaps."},{"term":"Likelihood","definition":"How often a risk could happen."},{"term":"Impact","definition":"How much harm a risk would cause."},{"term":"Mitigate","definition":"To reduce a risk, often by adding a rule."},{"term":"Gap","definition":"A place where practice does not meet the rule."}],"role":"vocabulary"},{"type":"text","heading":"Audit against the rules","body":["An [[audit]] compares what actually happened with what should happen. You read the anonymised class use-log and flag any entry that breaks or stretches a responsible-use rule.","The log is anonymised on purpose: you fix systems and habits, *never* blame a person."],"role":"explain"},{"type":"text","heading":"Rank, then rule","body":["Place each flagged risk on the matrix by its [[likelihood]] and [[impact]], then pick the highest-priority one.","Finally, write one realistic responsible-use rule that would close that gap - and be ready to pitch it for the class charter."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Audit the anonymised use-log, flag the gaps, plot the risks on the matrix, and propose one rule to fix the top-priority risk."],"items":["Read each log entry against the rule set.","Flag gaps and name the risk and who it affects.","Plot risks on the likelihood-impact matrix.","Circle the highest-priority risk.","Write and pitch one mitigation rule."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which risk surprised you as higher priority than expected?","How do you make a rule strong but still realistic?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one change you will make to your own AI use after this audit.","Explain why anonymising the log matters."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Lab - Worksheet | Class AI Risk Audit (Lab)","questions":[{"id":"g6-main-w5-lab-aq1","type":"ordering","marks":4,"prompt":"Your group is the class safety board. Put the five audit steps into the order you carry them out.","items":[{"id":"i1","text":"Plot each flagged risk on the likelihood-impact matrix."},{"id":"i2","text":"Read each log entry against the rule set."},{"id":"i3","text":"Write and pitch one rule that would close the gap."},{"id":"i4","text":"Flag the gaps and name the risk and who it affects."},{"id":"i5","text":"Circle the highest-priority risk."}],"answer":["i2","i4","i1","i5","i3"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is the audit order - you can only rank risks you have found, and you only write a rule once you know which risk comes first.","incorrect":"An audit compares practice with the rules first. Ranking comes after flagging, and the rule is written for the risk you circled."}},{"id":"g6-main-w5-lab-aq2","type":"multi","marks":3,"prompt":"Which of these entries in the anonymised class use-log are genuine gaps your board should flag?","options":[{"id":"a","text":"A demo prompt was typed in with a student's full name still in it."},{"id":"b","text":"An AI answer about rainfall was pasted into a report without being checked anywhere else."},{"id":"c","text":"A class photo was uploaded to a tool to turn it into a cartoon poster."},{"id":"d","text":"A student asked the teacher whether a new app was safe before using it."},{"id":"e","text":"A student checked an AI fact against the textbook before putting it in their work."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Yes - a gap is a place where practice does not meet the rule, and identifying data or unchecked output are exactly that.","incorrect":"Asking an adult and checking a fact against a trusted source are the rules being followed, not gaps - the gaps are the names, the photo and the unchecked answer."}},{"id":"g6-main-w5-lab-aq3","type":"matching","marks":4,"prompt":"Match each flagged risk to where it belongs on the likelihood-impact matrix.","left":[{"id":"L1","text":"Real names are typed into prompts in most lessons, and a named student could be exposed to strangers."},{"id":"L2","text":"An AI sentence is copied into a personal rough draft most weeks, and nobody but the writer ever reads that draft."},{"id":"L3","text":"One unchecked AI statistic has been printed once all year - in the newsletter sent to every family."},{"id":"L4","text":"A tool once mis-spelled a group's name on a practice slide, which was deleted a minute later."}],"right":[{"id":"R1","text":"Low likelihood, high impact"},{"id":"R2","text":"High likelihood, high impact"},{"id":"R3","text":"Low likelihood, low impact"},{"id":"R4","text":"High likelihood, low impact"}],"answer":{"L1":"R2","L2":"R4","L3":"R1","L4":"R3"},"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Well placed - likelihood is how often it could happen and impact is how much harm it would cause, and they are judged separately.","incorrect":"Judge the two axes one at a time: how often does it happen, and how much harm does it do when it does? Something frequent can still be low impact."}},{"id":"g6-main-w5-lab-aq4","type":"mcq","marks":2,"prompt":"Your board has plotted these four risks on the likelihood-impact matrix. Which one should the class mitigate first?","options":[{"id":"a","text":"The unchecked statistic in the newsletter, because it reached every family."},{"id":"b","text":"Real names typed into prompts, because it happens often and a named student could be exposed."},{"id":"c","text":"AI sentences copied into private rough drafts, because it happens most weeks."},{"id":"d","text":"The mis-spelled group name, because it is the one everybody noticed."}],"answer":"b","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - the risk that is high on both axes is the one to mitigate first, not the one that is merely frequent or merely serious.","incorrect":"Compare both axes. The newsletter is serious but rare, the rough drafts are frequent but harmless - only the names are high on likelihood and impact."}},{"id":"g6-main-w5-lab-aq5","type":"fillBlank","marks":2,"prompt":"Complete your board's recommendation.","stem":"Before any prompt is typed, replace every real name with the words '___'. This closes the gap because identifying data is never entered, so the ___ of a student being exposed drops.","blanks":["",""],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is a realistic mitigation - swapping the name keeps the prompt useful while moving the risk down the likelihood axis.","incorrect":"A workable rule keeps the task possible: use a general word like 'a student' instead of a real name, which makes exposure far less likely."},"answer":[["a student","student","a classmate","classmate","a pupil","pupil","a person","person","someone","anonymous","student a","a learner","learner","a child","child","student 1","pupil a","a name","initials"],["likelihood","likelyhood","chance","probability"]]}]},"formative":{"targets":"Directly checks 'recognises basic risks (incorrect outputs, unsafe use)'","check":"Completed audit sheet with a matrix-placed priority risk and a proposed mitigation rule","successCriteria":"Finds a genuine gap, places risks sensibly on the matrix, and proposes a realistic rule that reduces the top risk.","evidence":"Audit sheet and risk matrix photo."}},"g6-main-w6-core":{"id":"g6-main-w6-core","number":11,"week":6,"track":"main","type":"core","title":"Bringing the Strands Together","summary":"Students run one guided challenge through all four strands and explain how each link in the chain shaped the next.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Complete a guided challenge combining the concept, a prompted solution, an output check and a risk check.","Explain how the system type and prompt shaped the output.","Identify one responsible-use choice made."],"sections":[{"type":"text","body":["This term you learned four skills one at a time. Today you discover they were never separate - they form one chain, from understanding the system to writing a prompt, checking the output, and using it responsibly. Put all four hats on at once."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can complete a guided challenge that uses all four strands.","I can explain how the system type and prompt shaped the output.","I can name one responsible-use choice I made."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Integration","definition":"Connecting separate skills into one process."},{"term":"System type","definition":"Whether a system is rule-based or learning-based."},{"term":"Prompt","definition":"The instruction you give an AI tool to guide its output."},{"term":"Triage","definition":"Judging an output as correct, incorrect, or unclear."},{"term":"Risk check","definition":"Asking what could go wrong and choosing a responsible action."}],"role":"vocabulary"},{"type":"text","heading":"One connected chain","body":["The [[system type]] shapes what you can expect. The [[prompt]] shapes the output. The output needs a [[triage]]. And the whole process needs a [[risk check]].","Each strand feeds the next - miss one link and the chain weakens."],"role":"explain"},{"authored":true,"type":"diagram","variant":"flow","label":"The whole term in one line","heading":"Four skills, one chain","altText":"A chain of four steps: work out the system type, write a structured prompt, triage the output, then run a risk check.","nodes":[{"label":"Name the system","detail":"rule-based or learning"},{"label":"Write the prompt","detail":"goal, context, format"},{"label":"Triage the output","detail":"correct, incorrect, unclear"},{"label":"Check the risk","detail":"and choose what to do","accent":true}],"edges":[{"label":"so you know what to expect"},{"label":"so the output is worth judging"},{"label":"so you know what you are risking"}],"caption":"Each step only makes sense because of the one before it. **Skip the first and you do not know what the tool was ever going to be able to do.**","role":"diagram"},{"type":"text","heading":"Explain the links","body":["It is not enough to complete each step; you should be able to explain how one shaped the next.","For example: because the prompt was specific, the output stayed on task, which made triage easier and the risk lower."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Run one guided challenge through all four strands, then explain how the system and prompt shaped the output and name one responsible-use choice you made."],"items":["Name the system type behind the task.","Write or choose a clear prompt.","Triage the curated output.","Run a basic risk check and note a responsible-use choice.","Explain how the system and prompt shaped the output."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which strand was strongest in your work, and which needs practice?","How would a weaker prompt have changed the whole chain?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write which strand you will focus on before the signature solution.","Explain one link in the chain in your own words."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Core - Worksheet | Bringing the Strands Together","questions":[{"id":"g6-main-w6-core-aq1","type":"ordering","marks":4,"autoMarked":true,"prompt":"Mia wants to use an AI tool to help plan a class assembly. Put the four links of the chain in the order the lesson says they should happen, from first to last.","items":[{"id":"i1","text":"Triage the output as correct, incorrect or unclear"},{"id":"i2","text":"Run a risk check and choose a responsible action"},{"id":"i3","text":"Work out the system type so you know what to expect from the tool"},{"id":"i4","text":"Write a clear prompt to guide the output"}],"answer":["i3","i4","i1","i2"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is the chain: the system type tells you what to expect, the prompt shapes the output, the output is then triaged, and the risk check covers the whole process.","incorrect":"Each link feeds the next - you need to know the system type before you can write a good prompt, and you cannot triage or risk-check an output you have not produced yet."}},{"id":"g6-main-w6-core-aq2","type":"mcq","marks":2,"autoMarked":true,"prompt":"Layla is using a learning-based summarising tool on a news article. Instead of \"Summarise this article in three sentences, covering only its main argument\", she types \"Tell me about this\". Using the chain from the lesson, what is the most likely knock-on effect?","options":[{"id":"a","text":"The output wanders off the main argument, which makes the triage harder and leaves more risk of using something wrong"},{"id":"b","text":"The output stays exactly on task, but the tool takes longer to produce it"},{"id":"c","text":"The tool stops being a learning system and starts working from fixed rules instead"},{"id":"d","text":"The triage step is no longer needed, because a short prompt always gives a short output"}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Exactly - a vague prompt weakens every link after it: the output drifts, the triage gets harder, and the risk goes up.","incorrect":"The prompt cannot change what kind of system you are using; what it changes is the output, and a drifting output is harder to triage and riskier to use."}},{"id":"g6-main-w6-core-aq3","type":"multi","marks":3,"autoMarked":true,"prompt":"Omar has an AI-written summary he plans to put in a class newsletter. Which of these are genuine risk-reduction choices, as the lesson describes a risk check? Select all that apply.","options":[{"id":"a","text":"Taking his classmates' names and phone numbers out of the prompt before he sends it"},{"id":"b","text":"Checking a surprising fact in the summary against the original article before he shares it"},{"id":"c","text":"Marking the parts he could not check as unclear and leaving them out until he can check them"},{"id":"d","text":"Making the prompt much longer, so the tool has more words to work with"},{"id":"e","text":"Accepting the summary because it is written in confident, well-organised language"},{"id":"f","text":"Choosing whichever tool gives him an answer fastest"}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Each of those names something that could go wrong and does something about it - that is what a risk check is for.","incorrect":"A risk check asks what could go wrong and then acts on it. Length, confident wording and speed do not reduce any risk - confident wording can even hide a mistake."}},{"id":"g6-main-w6-core-aq4","type":"truefalse","marks":1,"autoMarked":true,"prompt":"True or false? Once you have written a very specific prompt, you can skip the triage step, because a specific prompt guarantees the output is correct.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - a specific prompt makes the triage easier, but it never replaces it; every output still has to be judged correct, incorrect or unclear.","incorrect":"A good prompt only makes the output easier to check. Miss the triage link and the chain weakens, however carefully you wrote the prompt."}},{"id":"g6-main-w6-core-aq5","type":"matching","marks":4,"autoMarked":true,"prompt":"Match each link in the chain to the job it does for the link that follows it.","left":[{"id":"L1","text":"Naming the system type"},{"id":"L2","text":"Writing a specific prompt"},{"id":"L3","text":"Triaging the output"},{"id":"L4","text":"Running a risk check"}],"right":[{"id":"R1","text":"Tells you what sort of results you can expect before you start"},{"id":"R2","text":"Keeps the output on task, so it is easier to judge"},{"id":"R3","text":"Decides whether what you got is correct, incorrect or unclear"},{"id":"R4","text":"Asks what could go wrong and picks a responsible action"}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is the whole chain in one table - each link does a different job, and each one hands something to the next.","incorrect":"Look at what each link produces: the system type sets your expectations, the prompt steers the output, the triage judges it, and the risk check decides what to do about what could go wrong."}}]},"formative":{"targets":"Integrates all Term-1 Emerging outcomes before the signature solution","check":"Guided integration task reviewed against project success criteria; forward feedback","successCriteria":"Connects system+prompt to output, triages the output, and names a risk-reduction choice.","evidence":"Integration task + feedback note."}},"g6-main-w6-lab":{"id":"g6-main-w6-lab","number":12,"week":6,"track":"main","type":"lab","title":"Integrated Build-and-Check (Lab)","summary":"Students run a full build-and-check task across four stations, record accuracy and risk verdicts, decide whether to use the output, and diagnose their weakest strand.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Run a small integrated build-and-check task end-to-end and record the checks made.","Identify which strand most needs work before the signature solution.","Evaluate the final output for accuracy and risk before deciding to use it."],"sections":[{"type":"text","body":["This is your dress rehearsal. You will run a real task from start to finish - build it with a system and a prompt, then check it for accuracy and risk before deciding whether to use it. By the end you will know exactly which strand to sharpen before the signature solution."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run a build-and-check task through all four strands end-to-end.","I can record the accuracy and risk checks I made.","I can name which strand I most need to improve."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Build-and-check","definition":"Producing an AI solution and then testing it before use."},{"term":"Accuracy verdict","definition":"Whether the output is correct, incorrect, or unclear."},{"term":"Risk verdict","definition":"How risky the output is and what would reduce it."},{"term":"Mitigation","definition":"An action that reduces a risk."},{"term":"Weakest link","definition":"The strand most likely to fail under pressure."}],"role":"vocabulary"},{"type":"text","heading":"Build, then check","body":["Building means choosing a suitable system and designing a clear [[prompt]] to reach a useful output.","Checking means triaging that output for accuracy and running a risk assessment before you decide to use it. Building without checking just produces confident mistakes."],"role":"explain"},{"type":"text","heading":"Decide and diagnose","body":["Your final call is **use**, **do not use**, or **use-with-changes** - and you must justify it with your two verdicts.","Then diagnose your [[weakest link]]: the strand where your evidence was thinnest. That is your focus before the signature solution."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Run the four stations end-to-end. Build with a system and prompt, check for accuracy and risk, decide whether to use the output, and diagnose your weakest strand."],"items":["Name the system type and why it suits the task.","Design a clear, specific prompt.","Triage the curated output for accuracy.","Run a risk assessment and choose a mitigation.","Decide use / do not use / use-with-changes and diagnose your weakest strand."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Did your accuracy verdict or your risk verdict decide your use decision?","Which strand was your weakest link, and how will you strengthen it?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write your focus strand and one action to improve it before the signature solution.","Explain why building without checking is risky."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Lab - Worksheet | Integrated Build-and-Check (Lab)","questions":[{"id":"g6-main-w6-lab-aq1","type":"ordering","marks":4,"autoMarked":true,"prompt":"Put the five steps of a build-and-check task in the order the lesson runs them, from first to last.","items":[{"id":"i1","text":"Triage the output for accuracy against the source"},{"id":"i2","text":"Decide use, do not use, or use-with-changes"},{"id":"i3","text":"Choose a system that suits the task and say why"},{"id":"i4","text":"Assess the risk in the output and choose a mitigation"},{"id":"i5","text":"Design a clear, specific prompt and produce the output"}],"answer":["i3","i5","i1","i4","i2"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is build-and-check in order: you build with a system and a prompt, then check accuracy and risk, and only then decide.","incorrect":"You build first and check second, and the decision comes last - it has to be made using both verdicts, so it cannot come before them."}},{"id":"g6-main-w6-lab-aq2","type":"mcq","marks":2,"autoMarked":true,"prompt":"Sara's build-and-check record says: accuracy verdict - two of the three facts match the article, the third cannot be found in it; risk verdict - low, because no personal data was used. Which decision best fits her two verdicts?","options":[{"id":"a","text":"Use-with-changes: take out or verify the fact she could not find, then use the rest"},{"id":"b","text":"Use: the risk verdict is low, so the output is safe to use exactly as it is"},{"id":"c","text":"Do not use: an output with even one unchecked detail has to be thrown away completely"},{"id":"d","text":"Use: two facts out of three are correct, so most of the output is right"}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Use-with-changes is a real third option: the low risk does not excuse the unchecked fact, but one unchecked fact does not waste the whole output either.","incorrect":"A low risk verdict does not cancel out an accuracy problem, and one unchecked fact does not ruin everything - fix the weak part and use the rest."}},{"id":"g6-main-w6-lab-aq3","type":"matching","marks":4,"autoMarked":true,"prompt":"Match each station in the lab to the piece of evidence it should leave in your build-and-check record.","left":[{"id":"L1","text":"System station"},{"id":"L2","text":"Prompt station"},{"id":"L3","text":"Accuracy station"},{"id":"L4","text":"Risk station"}],"right":[{"id":"R1","text":"A named system type with a reason why it suits this task"},{"id":"R2","text":"The exact instruction you gave the tool, written out"},{"id":"R3","text":"A verdict of correct, incorrect or unclear with a reason you can check against the source"},{"id":"R4","text":"A named thing that could go wrong plus the mitigation you chose for it"}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Four stations, four pieces of evidence - that record is what makes your final decision defensible.","incorrect":"Each station leaves its own evidence: a justified system choice, the prompt itself, an accuracy verdict with a checkable reason, and a risk with its mitigation."}},{"id":"g6-main-w6-lab-aq4","type":"multi","marks":3,"autoMarked":true,"prompt":"Yusuf has to justify his use decision. Which of these actually support that decision, according to the lesson? Select all that apply.","options":[{"id":"a","text":"His accuracy verdict, with a reason he can check against the source"},{"id":"b","text":"His risk verdict, with the mitigation he chose"},{"id":"c","text":"The parts he marked unclear in his accuracy verdict, named so someone else can check them"},{"id":"d","text":"The output is neatly laid out and sounds confident"},{"id":"e","text":"The tool produced the answer in under two seconds"},{"id":"f","text":"The output is longer and more detailed than his classmates' outputs"}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"A use decision rests on the two verdicts and on being honest about what you could not check - not on how the output looks.","incorrect":"Neat layout, speed and length tell you nothing about whether the output is true or safe - that is exactly how building without checking produces confident mistakes."}},{"id":"g6-main-w6-lab-aq5","type":"truefalse","marks":1,"autoMarked":true,"prompt":"True or false? Hamad finished the risk station faster than any other station, so that speed is good evidence that risk is his strongest strand.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - you diagnose your strands by how thin or thick your recorded evidence is, not by how quickly you got through a station.","incorrect":"Finishing fast often means thin evidence. Your weakest link is the strand where the evidence you recorded was thinnest, whatever the clock said."}}]},"formative":{"targets":"Integrates all Term-1 Emerging outcomes end-to-end as a rehearsal for the signature solution","check":"Completed build-and-check record with accuracy verdict, risk verdict, use decision, and weakeststrand diagnosis","successCriteria":"Runs all four strands end-to-end, records both checks, makes a justified use decision, and names a weakest strand.","evidence":"Build-and-check record."}}}};
}

