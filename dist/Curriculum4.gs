function curriculumChunk4_() {
  return {"grade6":{"g6-main-w10-lab":{"id":"g6-main-w10-lab","number":20,"week":10,"track":"main","type":"lab","title":"Showcase Carousel and Reflection (Lab)","summary":"Learners run a showcase carousel, give and collect strand-tagged peer feedback, and consolidate the term into a four-strand Emerging summary with one Term-2 goal.","duration":"1 x 45-minute period","strands":["CU","SD","CE","GE"],"objectives":["Present the solution in a showcase carousel and give structured peer feedback.","Consolidate reflections into a Term-2 goal across the four strands.","Confirm the responsible-use message for every solution on display."],"sections":[{"type":"text","body":["Welcome to the showcase. Today your class becomes a gallery of AI-supported solutions. You will present, learn from each other with honest feedback, and pull your whole term together into one clear goal for next time."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can present my solution in a showcase carousel and give structured peer feedback.","I can consolidate my reflections into a Term-2 goal across the four strands.","I can confirm my solution is responsible to use and honest about its limits."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Carousel","definition":"A rotation where you present at your station and visit others."},{"term":"Two stars and a wish","definition":"Two things done well and one thing to improve."},{"term":"Consolidate","definition":"To gather many notes into one clear summary."},{"term":"Responsible use","definition":"No personal data, honest about limits, fair to users."},{"term":"Proficient","definition":"The next tier of skill you aim for in Term 2."}],"role":"vocabulary"},{"type":"text","heading":"Feedback that helps","body":["In the [[carousel]] you present in 60 seconds and then visit other stations. Leave '[[two stars and a wish]]', and tag each comment to a strand.","Good feedback is specific, kind and tied to evidence. A helpful wish is a gift, not a criticism."],"role":"explain"},{"type":"text","heading":"Your term in one picture","body":["Gather your feedback and notes into the four-strand summary: what you can now do in concepts, design and build, evaluate and use, and wider effects.","Then set one specific Term-2 goal toward [[Proficient]], and confirm every solution is responsible to use."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Set up your station, present in the carousel, give and collect feedback, then consolidate your term into a four-strand summary and one goal."],"items":["Set up your station with your frozen solution, evidence and responsible-use message.","Present in 60 seconds with two justified choices.","Rotate to at least two stations and leave strand-tagged feedback.","Collect the feedback left at your station.","Complete the four-strand Emerging summary.","Set one Term-2 goal and confirm responsible use."],"role":"activity"},{"type":"list","heading":"Think about it","items":["What is the most useful wish someone gave you, and why?","How will you keep your future solutions responsible and fair?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write your four-strand summary, one line per strand.","Set one specific Term-2 goal that moves you toward Proficient."],"role":"reflect"}],"worksheet":{"questions":[{"id":"g6-main-w10-lab-aq1","type":"mcq","marks":2,"prompt":"You are leaving 'two stars and a wish' at someone's station. Which wish is the most useful feedback?","options":[{"id":"a","text":"Wish: your station was a bit boring to watch."},{"id":"b","text":"Wish: make it better before you show it to anyone else."},{"id":"c","text":"Wish (Wider effects): say who might be left out if the whole school used it, and how you would stop that happening."},{"id":"d","text":"Wish: I really liked your colours, well done!"}],"answer":"c","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That wish is specific, kind and tagged to a strand, so the person knows exactly what to work on next.","incorrect":"A useful wish names one thing to improve and which strand it belongs to — 'boring', 'make it better' and a compliment all leave the person with nothing to act on."}},{"id":"g6-main-w10-lab-aq2","type":"multi","marks":3,"prompt":"Every station needs a responsible-use message. Which statements belong in that message? Select all that apply.","options":[{"id":"a","text":"We do not store anyone's name or photo."},{"id":"b","text":"Our checker gets unusual items wrong about one time in five, so check its answer before you act on it."},{"id":"c","text":"We tested it with items from lots of different homes so it works fairly for everyone."},{"id":"d","text":"Our solution loads in under two seconds."},{"id":"e","text":"We chose a purple background so the station looks smart."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Responsible use means no personal data, honesty about limits, and fairness to users — those three statements cover exactly that.","incorrect":"Loading speed and the look of your station may be good work, but they say nothing about personal data, limits or fairness."}},{"id":"g6-main-w10-lab-aq3","type":"matching","marks":4,"prompt":"Each carousel comment has to be tagged to a strand. Match each comment to the strand it belongs to.","left":[{"id":"l1","text":"Star: you explained clearly why your solution follows rules instead of learning from examples."},{"id":"l2","text":"Star: your station showed a working prototype that sorts an item into a category."},{"id":"l3","text":"Wish: try it on more items whose answers you already know, so your evidence is stronger."},{"id":"l4","text":"Wish: say who might be treated unfairly if your solution was used everywhere."}],"right":[{"id":"r1","text":"Understanding concepts"},{"id":"r2","text":"Design and build"},{"id":"r3","text":"Evaluate and use responsibly"},{"id":"r4","text":"Wider effects"}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Tagging works by what the comment is about: explaining ideas, building the thing, gathering evidence that it works, or who it affects.","incorrect":"Read what each comment actually praises or asks for — an explanation, a build, more testing evidence, or the effect on people — and the strand follows."}},{"id":"g6-main-w10-lab-aq4","type":"truefalse","marks":1,"prompt":"A wish should be kept general and vague so that nobody feels criticised.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Correct — good feedback is specific, kind and tied to evidence, so a specific wish is a gift rather than a criticism.","incorrect":"A vague wish is kind but useless; being specific and tying the comment to evidence is what makes it helpful."}},{"id":"g6-main-w10-lab-aq5","type":"ordering","marks":4,"prompt":"Put the showcase carousel steps into the order that makes each step possible.","items":[{"id":"s1","text":"Set up your station with your frozen solution, your evidence and your responsible-use message."},{"id":"s2","text":"Present your solution in 60 seconds with two justified choices."},{"id":"s3","text":"Rotate to other stations and leave strand-tagged feedback there."},{"id":"s4","text":"Collect the feedback other people left at your station."},{"id":"s5","text":"Complete your four-strand summary and set one Term-2 goal."}],"answer":["s1","s2","s3","s4","s5"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"You can only give feedback once stations are set up and presented, and you can only summarise your term once your feedback is collected.","incorrect":"The summary and goal come last, because they are built from the feedback you collect after presenting and visiting other stations."}}]},"formative":{"targets":"Summative Term-1 task samples all four strands at Emerging; reflection informs Term 2","check":"Structured peer feedback across the carousel plus a completed four-strand summary and Term-2 goal","successCriteria":"Gives specific strand-tagged feedback, confirms responsible use, and sets one clear Term-2 goal.","evidence":"Feedback slips + completed four-strand Emerging summary with goal."}},"g6-main-w2-core":{"id":"g6-main-w2-core","number":3,"week":2,"track":"main","type":"core","title":"Rules vs Learning - How Each System Works","summary":"Two features - where the logic comes from and how a system handles something new - let you classify any everyday system as rule-based or learning.","duration":"45 minutes","strands":["CU"],"objectives":["Distinguish a rule-based system from a learning system using two clear features.","Give one everyday example of each and explain the difference.","Use the terms rule-based, learning, data and model accurately."],"sections":[{"type":"text","body":["Two machines can do the same job in totally different ways. Today you learn the two features that reveal which is which - and you will never be fooled by a shiny screen again."],"role":"intro"},{"authored":true,"type":"diagram","variant":"compare","label":"The difference you are looking for","heading":"Two ways a system can reach an answer","altText":"Two columns. A rule-based system takes an input, follows a rule a person wrote, and gives an output. A learning system takes labelled examples, finds a pattern itself, and uses that pattern on a new input.","caption":"Both give an answer. The difference is **where the rule came from** — a person wrote it, or the system found it.","left":{"title":"Rule-based system","steps":["An input arrives","Follow the rule a person wrote","Give the answer"]},"right":{"title":"Learning system","accent":true,"steps":["Study labelled examples","Find the pattern itself","Use it on a new input"]},"role":"diagram"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-based system","definition":"Logic written by a person as fixed steps."},{"term":"learning system","definition":"A system that builds a model from data instead of fixed rules."},{"term":"data","definition":"The labelled examples a learning system is shown."},{"term":"model","definition":"The pattern a learning system builds from its data."},{"term":"feature","definition":"A true characteristic you use to classify a system, not a surface look."}],"role":"vocabulary"},{"type":"text","heading":"Two features that decide it","body":["**Feature one** - where does the logic come from? In a [[rule-based system]] a person writes it. In a [[learning system]] it comes from data.","**Feature two** - what happens with something new? A rule-based system only handles cases its rules cover. A learning system can handle new cases that look like its examples."],"role":"explain"},{"type":"text","heading":"Data is not the model","body":["Be careful with words. The [[data]] is the examples. The [[model]] is the pattern built from them. Change the data and you can change the model.","A learning system does not understand meaning - it matches patterns. Always check its answers."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build the feature chart, then use it to classify everyday systems you meet in the UAE."],"items":["Copy the two-column feature chart.","Add an example to each row.","Classify two everyday systems.","Underline the feature that decided each answer.","Write two sentences using data and model correctly."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which feature is the strongest proof of a learning system?","Why is 'it looks modern' not a good reason?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the two features you now use to classify systems.","Write one system you are still unsure about and why."],"role":"reflect"}],"worksheet":{"title":"Week 2 Core worksheet - Rules vs Learning - How Each System Works","questions":[{"id":"g6-main-w2-core-aq1","type":"mcq","marks":2,"prompt":"A metro ticket gate opens only when a valid card is tapped. An engineer wrote out every condition the gate checks before it opens. Which classification and reason is correct?","options":[{"id":"a","text":"Rule-based, because a person wrote the logic the gate follows."},{"id":"b","text":"Learning, because it builds a model from the thousands of cards tapped each day."},{"id":"c","text":"Rule-based, because the gate is simple and does not have a modern screen."},{"id":"d","text":"Learning, because it deals with a new passenger it has never seen before."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"Exactly - the deciding feature is where the logic came from, and here a person wrote it as fixed steps.","incorrect":"Handling lots of taps, or looking plain, are surface traits; what decides it is that a person wrote the conditions rather than the system finding them in data."}},{"id":"g6-main-w2-core-aq2","type":"matching","marks":4,"prompt":"Each clue below is evidence about a system. Match each clue to what it proves about that system.","left":[{"id":"L1","text":"You can open the file and read every step the machine follows, written out by its maker."},{"id":"L2","text":"The system was shown thousands of labelled examples before it worked at all."},{"id":"L3","text":"It refuses any case its maker did not write a step for."},{"id":"L4","text":"It handled a phrase correctly that nobody had ever typed into it before."}],"right":[{"id":"R1","text":"Rule-based: the logic came from a person."},{"id":"R2","text":"Learning: the logic came from data."},{"id":"R3","text":"Rule-based: it only handles cases its rules cover."},{"id":"R4","text":"Learning: it handles new cases that look like its examples."}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"You used both features: where the logic came from, and what happens when something new arrives.","incorrect":"Two clues are about where the logic came from and two are about what happens with a new case - sort them by which feature each one is really telling you about."}},{"id":"g6-main-w2-core-aq3","type":"multi","marks":3,"prompt":"Select every piece of evidence that would be good proof that a system is a learning system.","options":[{"id":"a","text":"It was shown labelled examples before it could do the job."},{"id":"b","text":"It gets new cases right that look like its examples."},{"id":"c","text":"Changing the examples it was shown changes the answers it gives."},{"id":"d","text":"Its screen is colourful and it updates every month."},{"id":"e","text":"It gives its answer almost instantly."},{"id":"f","text":"A person wrote out every step it follows."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"All three are about data building the logic - that is real proof, unlike how the system looks or how fast it is.","incorrect":"Speed and a modern look are surface traits, and a person writing every step is proof of the opposite; pick the clues that point to data building the logic."}},{"id":"g6-main-w2-core-aq4","type":"truefalse","marks":1,"prompt":"True or false: because a shopping app looks modern and changes its layout often, we can be sure it is a learning system.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - looking modern is a surface trait, and a rule-based system can be given a shiny new layout at any time.","incorrect":"A new look tells you nothing about where the logic came from; you would need evidence that the system built its logic from examples."}},{"id":"g6-main-w2-core-aq5","type":"fillBlank","marks":2,"prompt":"A spellchecker flags a word only when that word is missing from a fixed list its makers typed in. Complete the classification sentence.","stem":"This is a {{1}} system, because the logic came from a {{2}}.","blanks":["",""],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"A fixed list typed in by its makers is logic written by a person, so this is rule-based.","incorrect":"Ask where the logic came from: nobody showed this spellchecker labelled examples - a person typed the list, so it is rule-based."},"answer":[["rule-based","rule based","rulebased","a rule-based","rule-based one"],["person","a person","human","a human","people","programmer","the makers","maker"]]}]},"formative":{"targets":"Directly checks 'recognises the difference between rule-based and learning systems'","check":"Exit ticket: classify two systems and give the feature that distinguishes them","successCriteria":"Correctly classifies both and names a distinguishing feature (not a surface trait).","evidence":"Exit slips sorted secure / partial / not-yet."}},"g6-main-w2-lab":{"id":"g6-main-w2-lab","number":4,"week":2,"track":"main","type":"lab","title":"Train a Simple Model (Lab)","summary":"Groups build a training set of safe, non-personal examples, train a classifier, test it on held-back examples, and check how their choices shaped the model.","duration":"45 minutes","strands":["CU"],"objectives":["Train a simple classifier on non-personal examples (objects/drawings/sounds) and test it on new examples.","Explain how the training examples shaped what the model learned.","Run a basic risk and data-safety check on the training set."],"sections":[{"type":"text","body":["Today you become a model trainer. You choose the examples, and the examples decide what your model learns - so choose wisely and keep them safe."],"role":"intro"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"training data","definition":"The examples the model learns from."},{"term":"testing data","definition":"New examples, held back, used to check the model."},{"term":"model","definition":"The pattern the system builds from the training data."},{"term":"classifier","definition":"A model that sorts examples into categories."},{"term":"data-safety rule","definition":"Use only non-personal examples - never faces, voices or names."}],"role":"vocabulary"},{"type":"text","heading":"Train, then test","body":["First you show the model many labelled [[training data]] examples. It finds the pattern and builds a [[model]].","Then you test it on new examples it has never seen. If it still gets them right, it really learned. If not, it only memorised."],"role":"explain"},{"type":"text","heading":"Your examples shape the model","body":["If all your apple pictures are red, the model learns 'red', not 'apple', and fails on a green one. Variety and fairness matter, not just how many.","**Golden rule:** only non-personal examples. No faces, no voices, no names ever go into a training set."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build a training set of safe, non-personal examples, train a model, then test it on new examples and check your data is safe."],"items":["Pick two categories of non-personal items.","Collect and label 8-10 training examples each.","Hide 3 testing examples per category.","Train using training examples only.","Test the held-back examples and log the results.","Complete the data-safety and risk check."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which testing example fooled the model, and why?","How did your choice of examples change what it learned?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write how your training examples shaped the model.","Write one data-safety rule you followed today."],"role":"reflect"}],"worksheet":{"title":"Week 2 Lab worksheet - Train a Simple Model","questions":[{"id":"g6-main-w2-lab-aq1","type":"ordering","marks":4,"prompt":"Put the lab steps in the order that gives a fair test of the model.","items":[{"id":"i1","text":"Pick two categories of non-personal items."},{"id":"i2","text":"Collect and label 8-10 examples of each category."},{"id":"i3","text":"Hide 3 examples of each category so the model will never see them."},{"id":"i4","text":"Train the model using the remaining examples only."},{"id":"i5","text":"Run the hidden examples through the model and log the results."}],"answer":["i1","i2","i3","i4","i5"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"The testing examples have to be set aside before training, or the model has already seen them and the test proves nothing.","incorrect":"Check where the hiding step sits: examples must be held back before training, otherwise you are testing the model on work it already memorised."}},{"id":"g6-main-w2-lab-aq2","type":"mcq","marks":2,"prompt":"A group trained a 'cup' classifier. Every cup in their training examples was white. When they tested a red cup that had been held back, the model said 'not a cup'. What is the best explanation?","options":[{"id":"a","text":"The model learned 'white' as well as 'cup', because every training example shared that colour."},{"id":"b","text":"The model simply did not have enough training examples."},{"id":"c","text":"The red cup was a testing example, and models always get testing examples wrong."},{"id":"d","text":"The model memorised the red cup during training and got confused."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"When every example shares a feature, the model learns that feature too - this is the red-cup version of the red-apple problem.","incorrect":"More examples of the same white cups would not help, and the red cup was never in training; the problem is that the training examples had no variety in colour."}},{"id":"g6-main-w2-lab-aq3","type":"multi","marks":3,"prompt":"A group wants to find out whether their model really learned 'circle' or only memorised their pictures. Select every action that would help them find out.","options":[{"id":"a","text":"Test it on circles that were held back and never used in training."},{"id":"b","text":"Include circles of different sizes and colours among the testing examples."},{"id":"c","text":"Write down the prediction for each example before running it through the model."},{"id":"d","text":"Test it again using the same pictures it was trained on."},{"id":"e","text":"Add more copies of the training pictures to the testing set."},{"id":"f","text":"Judge the model by how quickly it gives each answer."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"Unseen and varied examples, with your prediction written first, is what turns a test into real evidence.","incorrect":"Anything the model has already seen will be answered correctly whether it learned or memorised, and speed says nothing about what it learned."}},{"id":"g6-main-w2-lab-aq4","type":"truefalse","marks":1,"prompt":"True or false: a model that gets every training example right but fails almost every held-back example has learned its categories well.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"Correct - getting the training examples right only shows it memorised them; real learning shows up on examples it has never seen.","incorrect":"Scoring well on the examples it was trained on is easy; because it fails the held-back examples, this model memorised rather than learned."}},{"id":"g6-main-w2-lab-aq5","type":"fillBlank","marks":2,"prompt":"Complete the lab's rules about safe data and a fair check.","stem":"Training examples must be non-{{1}}, which means no faces, voices or names. The examples you hide are called {{2}} data, and they are a fair check only because the model never saw them during {{3}}.","blanks":["","",""],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"evidenceType":"product","feedback":{"correct":"Safe data and a clean split between training and testing are the two things that make your log trustworthy.","incorrect":"The golden rule is non-personal examples only, and the held-back set is the testing data - it works as a check because it stayed out of training."},"answer":[["personal","non-personal","personal data"],["testing","test","testing data","test data"],["training","the training","training time","the training stage"]]}]},"formative":{"targets":"Deepens 'recognises the difference between rule-based and learning systems' by building a learning system and seeing how data shapes it","check":"Training-and-testing log with results and an explanation of how the data shaped the model","successCriteria":"Trains and tests a model on separate example sets and explains how the training examples changed what it learned.","evidence":"Completed training/testing log plus the data-safety and risk check."}},"g6-main-w3-core":{"id":"g6-main-w3-core","number":5,"week":3,"track":"main","type":"core","title":"Structured Prompts to Complete a Task","summary":"Students learn the Goal-Context-Format prompt structure, use it to complete a defined task on a teacher-operated tool, judge whether the task was completed, and make one adjustment to complete it more fully.","duration":"1 x 45-minute period","strands":["SD"],"objectives":["Use a structured prompt to complete a defined task with an AI tool.","Describe the input structure used and whether the task was completed.","Adjust the prompt once to complete the task more fully."],"sections":[{"type":"text","heading":"Structured Prompts to Complete a Task","body":["Ask an AI tool a vague question and you get a vague answer. Learn to structure your prompt and you can actually get a task done. Today you learn the trick: **Goal, Context, Format**."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can write a structured prompt with a clear goal, context and format.","I can say whether the task was completed and why.","I can improve my prompt once to complete the task more fully."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"prompt","definition":"The instruction you give an AI tool."},{"term":"structured prompt","definition":"A prompt with a clear goal, context and format."},{"term":"goal","definition":"What you want the tool to do."},{"term":"context","definition":"The details the tool needs to do it."},{"term":"format","definition":"How you want the answer to look."}],"role":"vocabulary"},{"type":"text","heading":"Goal, Context, Format","body":["A vague prompt like 'tell me about the desert' leaves the tool guessing. A [[structured prompt]] tells it exactly what to do.","**Goal**: what you want. **Context**: the details it needs. **Format**: how the answer should look. Together they make the task far more likely to be completed."],"role":"explain"},{"authored":true,"type":"diagram","variant":"parts","label":"The shape of a structured prompt","heading":"One prompt, three slots","whole":"A structured prompt","altText":"A single bar split into three labelled slots — Goal, Context and Format — which together make a prompt the tool can act on.","parts":[{"label":"Goal","detail":"What you want it to do"},{"label":"Context","detail":"What it needs to know first"},{"label":"Format","detail":"How the answer should look","accent":true}],"result":"A prompt the tool can act on","caption":"Leave a slot empty and the tool fills it with a guess of its own. **Format is the one most often left out**, and it is why an answer comes back in the wrong shape.","role":"diagram"},{"type":"text","heading":"Check, then improve","body":["Once you get an output, compare it to the task. Did it do everything you asked? If not, change one thing in your prompt and try again.","Two safety rules: never put personal data in a prompt, and always verify the answer - a confident output can still be wrong."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Write a structured prompt for a real task, judge whether it completed the task, and improve it once."],"items":["Underline what 'complete' means for your task.","Write your prompt with Goal, Context and Format.","Watch the teacher run it on the approved tool.","Judge whether the task was completed.","Adjust your prompt once and verify the output."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which part of the structure helped most?","How did you know the task was or was not complete?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the one adjustment that improved your result.","Write one safety rule you used today."],"role":"reflect"}],"worksheet":{"title":"Week 3 - Core - Worksheet | Structured Prompts to Complete a Task","questions":[{"id":"g6-main-w3-core-aq1","type":"mcq","marks":2,"prompt":"Maya's task: give Grade 6 students exactly three bullet points on our school's recycling rules. She typed the prompt 'Tell me about recycling.' The tool returned six long paragraphs about recycling around the world. Which single adjustment does the most to complete Maya's task?","options":[{"id":"a","text":"Run the same prompt again, because the tool gives a different answer each time."},{"id":"b","text":"Add 'make it shorter' to the end of the prompt she already used."},{"id":"c","text":"Rewrite it as 'Summarise our school's recycling rules for Grade 6 students in exactly three bullet points.'"},{"id":"d","text":"Paste the six paragraphs back in and ask the tool whether they are correct."}],"answer":"c","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"That rewrite supplies the goal (summarise the rules), the context (our school, Grade 6) and the format (exactly three bullets), so the tool can actually complete the task.","incorrect":"The output missed the task on goal, context and format at once, so the fix has to put all three in - shortening or re-running a vague prompt still leaves the tool guessing."}},{"id":"g6-main-w3-core-aq2","type":"matching","marks":4,"prompt":"Omar is writing a prompt for a class task. Match each line he wrote to the part of a structured prompt it belongs to.","left":[{"id":"L1","text":"Write a packing list for our Grade 6 desert field trip."},{"id":"L2","text":"The trip is one day in February and we walk for two hours in the sun."},{"id":"L3","text":"Give it as a numbered list of eight items, each under six words."},{"id":"L4","text":"I am Omar Al Hosani, Class 6B, phone 050 ..."}],"right":[{"id":"R1","text":"Goal - what you want the tool to do"},{"id":"R2","text":"Context - the details the tool needs"},{"id":"R3","text":"Format - how the answer should look"},{"id":"R4","text":"Leave this out - personal data never goes in a prompt"}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Goal, context and format each do a different job, and personal details do none of them - they only put you at risk.","incorrect":"Ask what each line is for: the goal names the task, the context gives the tool the facts it needs, the format shapes the answer, and a name or phone number belongs in none of them."}},{"id":"g6-main-w3-core-aq3","type":"ordering","marks":4,"prompt":"Put the steps of today's task in the order the lesson used them.","items":[{"id":"i1","text":"Write down exactly what 'complete' would mean for this task."},{"id":"i2","text":"Write the prompt with a goal, context and format."},{"id":"i3","text":"Watch the prompt run on the approved tool."},{"id":"i4","text":"Compare the output with the task and judge whether it was completed."},{"id":"i5","text":"Change one thing in the prompt, run it again and verify the new output."}],"answer":["i1","i2","i3","i4","i5"],"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Deciding what 'complete' means first is what lets you judge the output honestly and choose a useful adjustment afterwards.","incorrect":"You cannot judge an output before you have decided what completing the task looks like, and the adjustment only makes sense after you have seen where the first output fell short."}},{"id":"g6-main-w3-core-aq4","type":"truefalse","marks":1,"prompt":"True or false: if the output is long, well written and sounds confident, that is enough to show the task was completed.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - you judge an output against what the task asked for, because a confident answer can still be incomplete or wrong.","incorrect":"Sounding right is not the same as being right: check the output against the task you set, not against how polished it reads."}},{"id":"g6-main-w3-core-aq5","type":"multi","marks":3,"prompt":"The task was: three bullet points on the water cycle for Grade 6, each under twelve words. The output came back with five bullets, two of them about twenty words long, and one bullet states something the science textbook says is wrong. Which of these show the task was NOT completed? Choose all that apply.","options":[{"id":"a","text":"There are five bullets when the task asked for three."},{"id":"b","text":"Two of the bullets run to about twenty words."},{"id":"c","text":"One bullet is wrong when checked against the science textbook."},{"id":"d","text":"The answer is set out as bullet points instead of a paragraph."},{"id":"e","text":"The bullets are written in a friendly tone, which nobody asked for."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Number, length and accuracy were all part of the task, so each of those three misses counts - and a wrong fact fails the task even when the format is perfect.","incorrect":"Compare the output with the task line by line: bullets were requested and the tone was never specified, so only the count, the length and the wrong fact are genuine misses."}}]},"formative":{"targets":"Directly checks 'uses AI tools with structured prompts to complete tasks'","check":"Task-completion log: structured prompt, output, 'task complete?' + one adjustment","successCriteria":"Completes the task using a structured prompt and records one adjustment that improved completion.","evidence":"Task-completion log."}},"g6-main-w3-lab":{"id":"g6-main-w3-lab","number":6,"week":3,"track":"main","type":"lab","title":"Prompt-to-Task Workshop (Lab)","summary":"Students tackle a richer multi-requirement task with two different prompt structures, compare them on completion and accuracy, and turn the stronger one into a reusable template with a verification step and risk check built in.","duration":"1 x 45-minute period","strands":["SD"],"objectives":["Complete a second, richer task and compare which prompt structure worked better.","Design a reusable prompt structure for a class of tasks.","Evaluate the outputs for accuracy and run a basic risk check."],"sections":[{"type":"text","heading":"Prompt-to-Task Workshop (Lab)","body":["You can structure one prompt - now build something reusable. Today you compare prompt structures on a richer task and design a template you and your class can use again and again."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can complete a richer task with a structured prompt and compare two structures.","I can design a reusable prompt template for similar tasks.","I can check an output for accuracy and complete a risk check."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"richer task","definition":"A task with several requirements to complete."},{"term":"prompt structure","definition":"The order and parts of a prompt, such as Goal-Context-Format."},{"term":"reusable template","definition":"A prompt skeleton with slots that works for many similar tasks."},{"term":"verification","definition":"Checking an output against a reliable source."},{"term":"risk check","definition":"A quick check for personal data and possible errors."}],"role":"vocabulary"},{"type":"text","heading":"Compare, then reuse","body":["A [[richer task]] has several requirements, so a weak prompt structure leaves parts unfinished. Run two structures on the same task and compare which completes it and which is more accurate.","Then turn the winner into a [[reusable template]] - a prompt with labelled slots you can fill in for any similar task."],"role":"explain"},{"type":"text","heading":"Build in the checks","body":["Every good template forces two checks: verify the output against a reliable source, and run a [[risk check]] for personal data and errors.","This is how real AI solutions are designed - and it is the foundation for your signature activity in the coming weeks."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Complete a richer task with two structures, compare them, then design a reusable template with checks built in."],"items":["List the three requirements of the task.","Draft two structured prompts with different orders.","Compare which output completed the task and check accuracy.","Turn the stronger structure into a reusable template.","Add a verification step and a risk check."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which structure completed more of the task, and how do you know?","Where should the verify step sit in your template?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the biggest difference between your two structures.","Write how your template forces an accuracy check."],"role":"reflect"}],"worksheet":{"title":"Week 3 - Lab - Worksheet | Prompt-to-Task Workshop (Lab)","questions":[{"id":"g6-main-w3-lab-aq1","type":"mcq","marks":2,"prompt":"The task had three requirements: name three school clubs, give the start time, and use a friendly tone. Structure A produced six lines that named three clubs, gave the start time and sounded friendly - but one club it named closed last year. Structure B produced twelve detailed lines, named two clubs, gave no start time and sounded friendly. Which judgement is the strongest?","options":[{"id":"a","text":"Structure B is stronger because it gave far more detail than Structure A."},{"id":"b","text":"Structure A is stronger on completion, but its club list must be corrected after checking the school's club page."},{"id":"c","text":"Structure A is stronger, and because it met all three requirements there is nothing left to check."},{"id":"d","text":"Neither is stronger, because each output has a problem of some kind."}],"answer":"b","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"You compared on completion and on accuracy: A met all three requirements, and the wrong club name is a fault to fix by verifying, not a reason to prefer the longer output.","incorrect":"More words is not more complete, and meeting every requirement still does not prove the facts are right - judge completion first, then verify the winner against a reliable source."}},{"id":"g6-main-w3-lab-aq2","type":"multi","marks":3,"prompt":"Which features make a prompt a reusable template rather than a one-off prompt? Choose all that apply.","options":[{"id":"a","text":"It uses labelled slots such as 'Goal: [task]' that you fill in for each new task."},{"id":"b","text":"It ends with a step that checks the output against a reliable source."},{"id":"c","text":"It tells you to keep personal data out of the context."},{"id":"d","text":"It is longer and uses more words than a one-off prompt."},{"id":"e","text":"It names the exact topic of the first task you used it for."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Slots let the template travel to new tasks, and the built-in verify and risk checks are what stop it being reused carelessly.","incorrect":"A template is reusable because of its slots and its built-in checks - extra length adds nothing, and naming one task's topic locks the template to that task."}},{"id":"g6-main-w3-lab-aq3","type":"ordering","marks":4,"prompt":"Put the steps of the workshop in the order that lets you compare fairly and end with a template you can trust.","items":[{"id":"i1","text":"List the requirements the task has to meet."},{"id":"i2","text":"Draft two prompts that use different structures."},{"id":"i3","text":"Run both and mark which requirements each output met."},{"id":"i4","text":"Check the facts in the stronger output against a reliable source."},{"id":"i5","text":"Turn the stronger structure into a template with labelled slots and a verify step."}],"answer":["i1","i2","i3","i4","i5"],"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"The requirements come first because they are what you mark both structures against, and you only build a template out of a structure you have checked for accuracy.","incorrect":"You need the requirements before you can say which structure completed more, and you should not turn a structure into a template until its output has survived an accuracy check."}},{"id":"g6-main-w3-lab-aq4","type":"fillBlank","marks":2,"prompt":"Complete the sentence about your template: A reusable template uses labelled ___ so the same skeleton fits many similar tasks, and it finishes with a step that tells you to ___ the output against a reliable source.","blanks":["",""],"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Slots make the template reusable and the verify step makes it safe to reuse - a template without one is only half a template.","incorrect":"A template needs both halves: labelled slots you fill in for each task, and a final instruction to verify the output against a reliable source."},"answer":[["slots","slot","labelled slots","gaps","gap","placeholders","placeholder","blanks","blank"],["verify","verifies","verifying","verification","check","checks","checking","fact-check","fact check"]]},{"id":"g6-main-w3-lab-aq5","type":"truefalse","marks":1,"prompt":"True or false: once your template has worked well on one task, you can use its output on a different task without checking it.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - a template is a strong starting point, not a guarantee, so every new task still needs its output verified and risk-checked.","incorrect":"A template that worked once only makes a good output more likely; the verify and risk steps are built in precisely because each new task can still go wrong."}}]},"formative":{"targets":"Extends 'uses AI tools with structured prompts to complete tasks' toward reusable, evaluated solutions","check":"A reusable prompt template plus a comparison of two structures with accuracy checks","successCriteria":"Compares two structures on completion and accuracy and designs a reusable template with a verification step.","evidence":"Comparison notes and the reusable template with its risk check."}},"g6-main-w4-core":{"id":"g6-main-w4-core","number":7,"week":4,"track":"main","type":"core","title":"Judging Outputs - Correct, Incorrect, Unclear","summary":"Students learn to give every AI output one of three verdicts - correct, incorrect or unclear - and to back each judgement with a reason they can check.","duration":"45 minutes","strands":["CE"],"objectives":["Identify, in a set of outputs, which are incorrect or unclear and say why.","Explain one signal that an output cannot be trusted as-is.","Recommend one action to take when an output is unclear."],"sections":[{"type":"text","heading":"Judging Outputs - Correct, Incorrect, Unclear","body":["An answer can sound perfectly sure of itself and still be wrong. Today you become the judge who decides whether an output is correct, incorrect, or simply unclear - and you learn to back up every judgement with a reason."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can sort outputs into correct, incorrect, and unclear.","I can give a reason for each judgement I make.","I can name one action to take when an output cannot be trusted."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Output","definition":"The text or answer an AI tool produces after you give it a prompt."},{"term":"Verdict","definition":"The judgement you give an output: correct, incorrect, or unclear."},{"term":"Source","definition":"A trusted place, like a textbook or official website, you check an answer against."},{"term":"Hallucination","definition":"When an AI tool states something made up as if it were a fact."},{"term":"Verify","definition":"To check whether something is true using a reliable source."}],"role":"vocabulary"},{"type":"text","heading":"Sounds right is not the same as is right","body":["A language model writes by predicting which words usually come next. That makes its answers smooth and confident, but confidence is a writing style, not proof.","Your job is to separate 'sounds right' from 'is right' by checking the output against the task you set and a source you trust."],"role":"explain"},{"type":"text","heading":"Three verdicts","body":["**Correct** means the output matches the task and agrees with a trusted source.","**Incorrect** means it clashes with something you can check now - a fact, a number, or your instruction.","**Unclear** means it is vague, incomplete, or you cannot [[verify]] it yet, so it needs more checking before use."],"role":"explain"},{"authored":true,"type":"diagram","variant":"branch","label":"What to do with an output","heading":"Three verdicts, not two","source":"An output you have just read","altText":"One output leads to three possible verdicts: correct, incorrect, or unclear.","branches":[{"label":"Correct","detail":"You checked it against something else"},{"label":"Incorrect","detail":"You found something that is wrong"},{"label":"Unclear","detail":"You could not check it either way","accent":true}],"caption":"**Unclear is a real verdict**, not a way of avoiding one. It records what you were unable to check, which is information the next person needs.","role":"diagram"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["You will triage three short outputs. For each, give a verdict and a six-word reason. Remember: a reason must point to a check, not a feeling."],"items":["Read the task the output was meant to answer.","Read the output carefully.","Check it against the task and any source given.","Write your verdict: correct, incorrect, or unclear.","Add a short reason and, if needed, one action."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which signal most often warned you an output was not trustworthy?","When an output is unclear, is it safer to pause or to proceed?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you will now check before trusting an AI answer.","Describe a time a confident answer turned out to be wrong."],"role":"reflect"}],"worksheet":{"title":"Week 4 - Core - Worksheet | Judging Outputs - Correct, Incorrect, Unclear","questions":[{"id":"g6-main-w4-core-aq1","type":"mcq","marks":2,"prompt":"Your task was: \"Using the class fact sheet, write how long the River Nile is.\" The fact sheet on your desk says the Nile is 6,650 km long. The AI output says: \"The River Nile is about 4,000 km long.\" Which verdict fits, and why?","options":[{"id":"a","text":"Incorrect - it clashes with the length on the fact sheet, which you can check right now."},{"id":"b","text":"Unclear - the word \"about\" means the output is not giving an exact number."},{"id":"c","text":"Correct - it answers the task by giving a length in kilometres, as the task asked."},{"id":"d","text":"Unclear - you would need to find a second source before you could decide."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Exactly - when an output clashes with a source you can check now, the verdict is incorrect, not unclear.","incorrect":"You already have a source in front of you and 4,000 km clashes with its 6,650 km, so this is incorrect - 'unclear' is only for outputs you cannot check yet."}},{"id":"g6-main-w4-core-aq2","type":"multi","marks":3,"prompt":"A reason must point to a check, not to a feeling. Select ALL the reasons below that are checkable reasons for a verdict.","options":[{"id":"a","text":"The number in the output disagrees with the number on our fact sheet."},{"id":"b","text":"The output names \"a recent study\" but gives no title or date, so I cannot verify it."},{"id":"c","text":"The task asked for two examples and the output gives none."},{"id":"d","text":"It just feels wrong when I read it."},{"id":"e","text":"It is written confidently and has no spelling mistakes, so it must be right."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Good - each of those points to something another person could check: a source, a missing detail, or the task itself.","incorrect":"A checkable reason points to the task or to a source that someone else could look at; how an answer feels or how confident it sounds is not something anyone can check."}},{"id":"g6-main-w4-core-aq3","type":"matching","marks":3,"prompt":"Match each output to the verdict it should be given.","left":[{"id":"L1","text":"The date in the output clashes with the date printed on the source card you were given."},{"id":"L2","text":"The output does what the task asked and matches the trusted website you checked it against."},{"id":"L3","text":"The output says \"a recent study proved this\" but gives no title, date or place you could look up."}],"right":[{"id":"R1","text":"Incorrect"},{"id":"R2","text":"Correct"},{"id":"R3","text":"Unclear"}],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"That is the triage routine working: a clash means incorrect, a match with a trusted source means correct, and something you cannot check yet means unclear.","incorrect":"Ask what you can check right now: a clash with a source is incorrect, a match is correct, and something with nothing to check against is unclear - not wrong, just not yet checkable."},"answer":{"L1":"R1","L2":"R2","L3":"R3"}},{"id":"g6-main-w4-core-aq4","type":"truefalse","marks":1,"prompt":"True or false: an output that is written smoothly and sounds confident is more likely to be correct than one that is written awkwardly.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Right - a language model predicts likely words, so confidence is a writing style and tells you nothing about whether the facts are true.","incorrect":"Smooth, confident writing is just the style a language model produces; only a check against the task or a trusted source tells you whether it is right."}},{"id":"g6-main-w4-core-aq5","type":"ordering","marks":4,"prompt":"Put the five steps of the triage routine in the order you should carry them out.","items":[{"id":"i1","text":"Read the task the output was meant to answer."},{"id":"i2","text":"Read the output carefully."},{"id":"i3","text":"Check the output against the task and any source you were given."},{"id":"i4","text":"Write your verdict: correct, incorrect, or unclear."},{"id":"i5","text":"Add a short checkable reason and, if needed, one action."}],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Yes - you read the task before the output, because you cannot judge an answer until you know what was asked, and the verdict only comes after the check.","incorrect":"The task comes first (you cannot judge an answer without knowing what was asked), then the output, then the check - and only then do you write the verdict and its reason."},"answer":["i1","i2","i3","i4","i5"]}]},"formative":{"targets":"Directly checks 'identifies when outputs are incorrect or unclear'","check":"Output-triage exit card: flag correct / incorrect / unclear with a reason each","successCriteria":"Correctly triages at least 2 of 3 outputs and gives a valid reason for each judgement.","evidence":"Output-triage card."}}}};
}

