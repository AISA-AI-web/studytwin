function curriculumChunk4_() {
  return {"grade6":{"g6-main-w5-core":{"id":"g6-main-w5-core","number":9,"week":5,"track":"main","type":"core","title":"Risks and Responsible Use","summary":"Students meet the two basic risk families of AI use - accuracy and safety/privacy - name who each risk could affect, and agree responsible-use rules that reduce them.","duration":"45 minutes","strands":["GE"],"objectives":["Identify at least two basic risks of using AI tools (e.g., incorrect output, unsafe or private data use).","Explain why each risk matters and who it could affect.","State one responsible-use rule that reduces a risk."],"sections":[{"type":"text","heading":"Risks and Responsible Use","body":["An AI answer can look helpful and still put someone at risk - through a mistake you did not check, or through personal data you should never have shared.","Today you learn to spot those risks and to name the rule that keeps people safe."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can name two genuine risks of using an AI tool.","I can explain who each risk could affect.","I can state a responsible-use rule that reduces a risk."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Risk","definition":"Something that could go wrong when using a tool."},{"term":"Accuracy risk","definition":"The danger of acting on an incorrect output."},{"term":"Privacy","definition":"Keeping personal or identifying information safe and unshared."},{"term":"Personal data","definition":"Information that identifies a person, like a name, address, or photo."},{"term":"Responsible-use rule","definition":"An agreed habit that reduces a risk."}],"role":"vocabulary"},{"type":"text","heading":"Two risk families","body":["**Accuracy risk** is the danger of using a confident but incorrect output without checking it. The mistake can spread into your work and anyone who trusts it.","**Safety and privacy risk** is the danger of entering [[personal data]] or identifying data, which may