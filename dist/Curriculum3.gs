function curriculumChunk3_() {
  return {"grade6":{"g6-main-w10-core":{"id":"g6-main-w10-core","number":19,"week":10,"track":"main","type":"core","title":"Showcase, Assessment & Reflection","summary":"Learners present their finished solution with two justified choices, complete a short Term-1 assessment sampling all four strands, and set a goal for next term.","duration":"1 x 45-minute period","strands":["CU","SD","CE","GE"],"objectives":["Present the finished solution and explain at least two design/evaluation choices.","Demonstrate the term's key outcomes in a short assessment task.","State one thing learned and set one goal for next term."],"sections":[{"type":"text","body":["This is your moment to show what you built and what you learned. You will present your finished solution, explain the choices behind it, complete a short assessment, and set a goal to grow even more next term."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can present my finished solution and explain at least two design or evaluation choices.","I can show the term's key outcomes in a short assessment task.","I can state one thing I learned and set one goal for next term."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Pitch","definition":"A short, clear explanation of your solution and its value."},{"term":"Justify","definition":"To give the reason and evidence behind a choice."},{"term":"Assessment","definition":"A task that shows what you have learned across the strands."},{"term":"Reflection","definition":"Thinking about what worked and what you would do next."},{"term":"Goal","definition":"A clear target for your next step of learning."}],"role":"vocabulary"},{"type":"text","heading":"A pitch that tells the truth","body":["A strong [[pitch]] names your user, the problem, how your solution works, and the evidence that it is accurate, useful and safe.","Explain two choices by giving reasons, not just descriptions. Be honest about one limit. Honesty makes your work more trustworthy, not weaker."],"role":"explain"},{"type":"text","heading":"Show the whole term, then look ahead","body":["The short [[assessment]] lets you show all four strands: understanding, building, evaluating and using responsibly, and wider effects.","Finish by naming one thing you learned and setting a [[goal]] for next term, aiming toward the Proficient tier."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Complete the short assessment, then present your solution and justify two choices before setting your next-term goal."],"items":["Set out your evidence from the term.","Complete the short assessment task on your own.","Prepare a 60-second pitch with two justified choices.","Present to your group and answer one 'why' question.","Write one thing learned and one Term-2 goal."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which of your two choices are you proudest of, and why?","What limit of your solution is important to be honest about?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you learned this term.","Set one goal for Term 2 that moves you toward Proficient."],"role":"reflect"}],"worksheet":{"questions":[{"id":"g6-main-w10-core-q1","type":"shortText","prompt":"Write two design or evaluation choices and give a reason and evidence for each.","title":"My two justified choices","stem":"Choice 1: ... because ... evidence ...\nChoice 2: ... because ... evidence ...","autoMarked":false,"lookFor":"Explains two design/evaluation choices with reasons and evidence. For a design choice, look for a reason, not just a description (model: 'I used a rule-based check because recycling categories have fixed correct answers'). For an evaluation choice, it should link to accuracy or fairness (model: 'I tested with six known-answer cases because one lucky example is not enough evidence').","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-core-q2","type":"shortText","prompt":"Answer the four short prompts, one for each strand, at Emerging level.","title":"Term-1 assessment task","stem":"Concepts: ...\nDesign & build: ...\nEvaluate & use: ...\nWider effects: ...","autoMarked":false,"lookFor":"Shows each strand at Emerging in the task. Approaching shows most strands at Emerging; not yet means several strands are not yet shown.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-core-q3","type":"shortText","prompt":"For each strand, note your evidence and your confidence.","title":"Strand evidence tracker","stem":"Strand | My evidence | Confidence | Next step","autoMarked":false,"lookFor":"Evidence is the assessed task plus the reflection, with results reported per strand. Feedback flags each student's next tier target (to Proficient) for Term 2.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-core-q4","type":"shortText","prompt":"One thing I learned this term is ... and my goal for next term is ...","title":"Exit ticket","autoMarked":false,"lookFor":"States one learning and one clear next-term goal. Goal should aim toward Proficient (model: 'I learned to re-test after changes; my goal is to build a solution with balanced data next term').","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-core-q5","type":"shortText","prompt":"Explain a trade-off you made between two choices and why it was worth it.","title":"Challenge (stretch)","autoMarked":false,"lookFor":"Stretch / next tier: learners explain a trade-off between two choices, reaching Extended abstract thinking.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]}]}},"g6-main-w10-lab":{"id":"g6-main-w10-lab","number":20,"week":10,"track":"main","type":"lab","title":"Showcase Carousel and Reflection (Lab)","summary":"Learners run a showcase carousel, give and collect strand-tagged peer feedback, and consolidate the term into a four-strand Emerging summary with one Term-2 goal.","duration":"1 x 45-minute period","strands":["CU","SD","CE","GE"],"objectives":["Present the solution in a showcase carousel and give structured peer feedback.","Consolidate reflections into a Term-2 goal across the four strands.","Confirm the responsible-use message for every solution on display."],"sections":[{"type":"text","body":["Welcome to the showcase. Today your class becomes a gallery of AI-supported solutions. You will present, learn from each other with honest feedback, and pull your whole term together into one clear goal for next time."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can present my solution in a showcase carousel and give structured peer feedback.","I can consolidate my reflections into a Term-2 goal across the four strands.","I can confirm my solution is responsible to use and honest about its limits."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Carousel","definition":"A rotation where you present at your station and visit others."},{"term":"Two stars and a wish","definition":"Two things done well and one thing to improve."},{"term":"Consolidate","definition":"To gather many notes into one clear summary."},{"term":"Responsible use","definition":"No personal data, honest about limits, fair to users."},{"term":"Proficient","definition":"The next tier of skill you aim for in Term 2."}],"role":"vocabulary"},{"type":"text","heading":"Feedback that helps","body":["In the [[carousel]] you present in 60 seconds and then visit other stations. Leave '[[two stars and a wish]]', and tag each comment to a strand.","Good feedback is specific, kind and tied to evidence. A helpful wish is a gift, not a criticism."],"role":"explain"},{"type":"text","heading":"Your term in one picture","body":["Gather your feedback and notes into the four-strand summary: what you can now do in concepts, design and build, evaluate and use, and wider effects.","Then set one specific Term-2 goal toward [[Proficient]], and confirm every solution is responsible to use."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Set up your station, present in the carousel, give and collect feedback, then consolidate your term into a four-strand summary and one goal."],"items":["Set up your station with your frozen solution, evidence and responsible-use message.","Present in 60 seconds with two justified choices.","Rotate to at least two stations and leave strand-tagged feedback.","Collect the feedback left at your station.","Complete the four-strand Emerging summary.","Set one Term-2 goal and confirm responsible use."],"role":"activity"},{"type":"list","heading":"Think about it","items":["What is the most useful wish someone gave you, and why?","How will you keep your future solutions responsible and fair?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write your four-strand summary, one line per strand.","Set one specific Term-2 goal that moves you toward Proficient."],"role":"reflect"}],"worksheet":{"questions":[{"id":"g6-main-w10-lab-q1","type":"shortText","prompt":"For two peers, write two stars and a wish, each tagged to a strand.","title":"Carousel feedback slips","stem":"Star (strand): ...\nStar (strand): ...\nWish (strand): ...","autoMarked":false,"lookFor":"Gives specific 'two stars and a wish' tagged to strands. A star must name a strand and evidence (model: 'Star (Evaluate & use): you tested with six known-answer cases, which is strong evidence'). A wish should be specific and kind (model: 'Wish (Wider effects): explain who might be treated unfairly and how you would prevent it').","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-lab-q2","type":"shortText","prompt":"Write one Emerging statement per strand, then set one Term-2 goal.","title":"Four-strand Emerging summary and goal","stem":"Concepts: I can ...\nDesign & build: I can ...\nEvaluate & use: I can ...\nWider effects: I can ...\nTerm-2 goal: ...","autoMarked":false,"lookFor":"Summarises all four strands at Emerging with evidence - one clause per strand at Emerging (model: 'I can explain rule-based vs learning, build a solution, evaluate it for risk, and consider wider effects'). The goal should be specific and tied to a strand toward Proficient (model: 'Next term I will use balanced data so my solution is fairer to all users').","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-lab-q3","type":"shortText","prompt":"For each strand, record your Emerging evidence and next-term focus.","title":"End-of-term reflection tracker","stem":"Strand | Emerging evidence | Feedback received | Term-2 focus","autoMarked":false,"lookFor":"Evidence is the feedback slips plus the completed four-strand Emerging summary with goal. Teacher flags each learner's next-tier target for Term 2.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-lab-q4","type":"shortText","prompt":"My proudest strand this term is ... and my Term-2 goal toward Proficient is ...","title":"Exit ticket","autoMarked":false,"lookFor":"Sets a specific goal and confirms responsible use; setting a goal or confirming responsible use but not both is only Approaching.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w10-lab-q5","type":"shortText","prompt":"Combine feedback from several peers into one improved design idea to try in Term 2, and explain your choice.","title":"Challenge (stretch)","autoMarked":false,"lookFor":"Stretch / next tier: learners synthesise feedback from several peers into one improved design idea for Term 2.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]}]}},"g6-main-w2-core":{"id":"g6-main-w2-core","number":3,"week":2,"track":"main","type":"core","title":"Rules vs Learning - How Each System Works","summary":"Two features - where the logic comes from and how a system handles something new - let you classify any everyday system as rule-based or learning.","duration":"45 minutes","strands":["CU"],"objectives":["Distinguish a rule-based system from a learning system using two clear features.","Give one everyday example of each and explain the difference.","Use the terms rule-based, learning, data and model accurately."],"sections":[{"type":"text","body":["Two machines can do the same job in totally different ways. Today you learn the two features that reveal which is which - and you will never be fooled by a shiny screen again."],"role":"intro"},{"authored":true,"type":"diagram","variant":"compare","label":"The difference you are looking for","heading":"Two ways a system can reach an answer","altText":"Two columns. A rule-based system takes an input, follows a rule a person wrote, and gives an output. A learning system takes labelled examples, finds a pattern itself, and uses that pattern on a new input.","caption":"Both give an answer. The difference is **where the rule came from** — a person wrote it, or the system found it.","left":{"title":"Rule-based system","steps":["An input arrives","Follow the rule a person wrote","Give the answer"]},"right":{"title":"Learning system","accent":true,"steps":["Study labelled examples","Find the pattern itself","Use it on a new input"]},"role":"diagram"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-based system","definition":"Logic written by a person as fixed steps."},{"term":"learning system","definition":"A system that builds a model from data instead of fixed rules."},{"term":"data","definition":"The labelled examples a learning system is shown."},{"term":"model","definition":"The pattern a learning system builds from its data."},{"term":"feature","definition":"A true characteristic you use to classify a system, not a surface look."}],"role":"vocabulary"},{"type":"text","heading":"Two features that decide it","body":["**Feature one** - where does the logic come from? In a [[rule-based system]] a person writes it. In a [[learning system]] it comes from data.","**Feature two** - what happens with something new? A rule-based system only handles cases its rules cover. A learning system can handle new cases that look like its examples."],"role":"explain"},{"type":"text","heading":"Data is not the model","body":["Be careful with words. The [[data]] is the examples. The [[model]] is the pattern built from them. Change the data and you can change the model.","A learning system does not understand meaning - it matches patterns. Always check its answers."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build the feature chart, then use it to classify everyday systems you meet in the UAE."],"items":["Copy the two-column feature chart.","Add an example to each row.","Classify two everyday systems.","Underline the feature that decided each answer.","Write two sentences using data and model correctly."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which feature is the strongest proof of a learning system?","Why is 'it looks modern' not a good reason?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the two features you now use to classify systems.","Write one system you are still unsure about and why."],"role":"reflect"}],"worksheet":{"title":"Week 2 Core worksheet - Rules vs Learning - How Each System Works","questions":[{"id":"g6-main-w2-core-q1","type":"shortText","autoMarked":false,"prompt":"Feature chart. Complete the chart with a feature and an example for each system type.","stem":"Rule-based: logic comes from ___\nLearning: logic comes from ___","lookFor":"Both rows name a non-surface feature - that in a rule-based system a person writes the logic, and in a learning system the logic comes from data - and each row carries an example. Watch for surface traits such as 'it looks modern' standing in for a feature.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-core-q2","type":"shortText","autoMarked":false,"prompt":"Classify and justify. Classify two systems and underline the deciding feature.","stem":"This is a ___ system because ___","lookFor":"Classifies both examples correctly with a feature reason: a metro ticket gate is rule-based because a person set fixed rules, and a voice assistant that improves with use is learning because it builds a model from data and handles new phrases. Approaching: one classified correctly, or a surface trait mixed in.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-core-q3","type":"fillBlank","autoMarked":false,"prompt":"Classification record. Record each system, your classification, and the deciding feature.","blanks":["System","Rule-based or learning","Deciding feature"],"lookFor":"Each row pairs a classification with a deciding feature rather than a surface look. The deciding-feature column should say where the logic comes from or how the system handles a new case.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-core-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket. Classify two systems your teacher names and give the feature that separates them.","lookFor":"Secure: classifies both correctly and names a distinguishing feature that is not a surface trait. Sort exit slips secure / partial / not-yet; if under 70 percent distinguish correctly, re-teach with the two-column feature chart.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-core-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch). Find a system that is genuinely hard to classify and argue both sides using features.","lookFor":"Argues both sides using the two features - where the logic comes from, and how the system handles a new case - rather than surface traits. This is the stretch task for students who already classify securely.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"proficient","evidenceType":"product"}]}},"g6-main-w2-lab":{"id":"g6-main-w2-lab","number":4,"week":2,"track":"main","type":"lab","title":"Train a Simple Model (Lab)","summary":"Groups build a training set of safe, non-personal examples, train a classifier, test it on held-back examples, and check how their choices shaped the model.","duration":"45 minutes","strands":["CU"],"objectives":["Train a simple classifier on non-personal examples (objects/drawings/sounds) and test it on new examples.","Explain how the training examples shaped what the model learned.","Run a basic risk and data-safety check on the training set."],"sections":[{"type":"text","body":["Today you become a model trainer. You choose the examples, and the examples decide what your model learns - so choose wisely and keep them safe."],"role":"intro"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"training data","definition":"The examples the model learns from."},{"term":"testing data","definition":"New examples, held back, used to check the model."},{"term":"model","definition":"The pattern the system builds from the training data."},{"term":"classifier","definition":"A model that sorts examples into categories."},{"term":"data-safety rule","definition":"Use only non-personal examples - never faces, voices or names."}],"role":"vocabulary"},{"type":"text","heading":"Train, then test","body":["First you show the model many labelled [[training data]] examples. It finds the pattern and builds a [[model]].","Then you test it on new examples it has never seen. If it still gets them right, it really learned. If not, it only memorised."],"role":"explain"},{"type":"text","heading":"Your examples shape the model","body":["If all your apple pictures are red, the model learns 'red', not 'apple', and fails on a green one. Variety and fairness matter, not just how many.","**Golden rule:** only non-personal examples. No faces, no voices, no names ever go into a training set."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build a training set of safe, non-personal examples, train a model, then test it on new examples and check your data is safe."],"items":["Pick two categories of non-personal items.","Collect and label 8-10 training examples each.","Hide 3 testing examples per category.","Train using training examples only.","Test the held-back examples and log the results.","Complete the data-safety and risk check."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which testing example fooled the model, and why?","How did your choice of examples change what it learned?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write how your training examples shaped the model.","Write one data-safety rule you followed today."],"role":"reflect"}],"worksheet":{"title":"Week 2 Lab worksheet - Train a Simple Model","questions":[{"id":"g6-main-w2-lab-q1","type":"shortText","autoMarked":false,"prompt":"Build and test log. Record your categories, then predict and test each held-back example.","stem":"I predict this will be classified as ___\nThe model actually classified it as ___","lookFor":"Secure: the two categories are named, the prediction is written before the example is tested, and the tested examples are ones held back from training. Approaching: trains and tests but blurs the two sets.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-lab-q2","type":"shortText","autoMarked":false,"prompt":"Data-safety and risk check. Tick the safety checks and write one risk and one improvement.","stem":"My data was safe because ___\nOne risk was ___\nOne improvement is ___","lookFor":"The safety line must confirm non-personal data - all examples were objects or drawings, no faces, voices or names. A secure improvement links quality and variety to accuracy, for example adding varied examples in different sizes, colours or angles so the model learns the real category.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-lab-q3","type":"fillBlank","autoMarked":false,"prompt":"Training and testing record. Log each testing example, your prediction, the result, and whether it was correct.","blanks":["Testing example","Predicted","Model result","Correct?"],"lookFor":"Every logged example is one the model never saw in training, and prediction and result are recorded separately so a wrong prediction is still evidence. If a group has logged training examples here, re-model the split and have them re-run on held-back data.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-lab-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket. How did your training examples change what the model learned? Give one example.","lookFor":"Reward any accurate cause-and-effect from data to model, for example 'all our circles were large, so the model missed a small circle - it learned large as well as round'. Partial: an explanation with no named example.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"emerging","evidenceType":"product"},{"id":"g6-main-w2-lab-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch). Design a 'trick' testing example, predict whether the model will fail, then test it and explain the result.","lookFor":"Predicts whether the model will fail and why before testing, then explains the result against that prediction - the stretch task for groups whose training and testing log is already secure.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"}],"tierProbed":"proficient","evidenceType":"product"}]}},"g6-main-w3-core":{"id":"g6-main-w3-core","number":5,"week":3,"track":"main","type":"core","title":"Structured Prompts to Complete a Task","summary":"Students learn the Goal-Context-Format prompt structure, use it to complete a defined task on a teacher-operated tool, judge whether the task was completed, and make one adjustment to complete it more fully.","duration":"1 x 45-minute period","strands":["SD"],"objectives":["Use a structured prompt to complete a defined task with an AI tool.","Describe the input structure used and whether the task was completed.","Adjust the prompt once to complete the task more fully."],"sections":[{"type":"text","heading":"Structured Prompts to Complete a Task","body":["Ask an AI tool a vague question and you get a vague answer. Learn to structure your prompt and you can actually get a task done. Today you learn the trick: **Goal, Context, Format**."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can write a structured prompt with a clear goal, context and format.","I can say whether the task was completed and why.","I can improve my prompt once to complete the task more fully."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"prompt","definition":"The instruction you give an AI tool."},{"term":"structured prompt","definition":"A prompt with a clear goal, context and format."},{"term":"goal","definition":"What you want the tool to do."},{"term":"context","definition":"The details the tool needs to do it."},{"term":"format","definition":"How you want the answer to look."}],"role":"vocabulary"},{"type":"text","heading":"Goal, Context, Format","body":["A vague prompt like 'tell me about the desert' leaves the tool guessing. A [[structured prompt]] tells it exactly what to do.","**Goal**: what you want. **Context**: the details it needs. **Format**: how the answer should look. Together they make the task far more likely to be completed."],"role":"explain"},{"type":"text","heading":"Check, then improve","body":["Once you get an output, compare it to the task. Did it do everything you asked? If not, change one thing in your prompt and try again.","Two safety rules: never put personal data in a prompt, and always verify the answer - a confident output can still be wrong."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Write a structured prompt for a real task, judge whether it completed the task, and improve it once."],"items":["Underline what 'complete' means for your task.","Write your prompt with Goal, Context and Format.","Watch the teacher run it on the approved tool.","Judge whether the task was completed.","Adjust your prompt once and verify the output."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which part of the structure helped most?","How did you know the task was or was not complete?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the one adjustment that improved your result.","Write one safety rule you used today."],"role":"reflect"}],"worksheet":{"title":"Week 3 - Core - Worksheet | Structured Prompts to Complete a Task","questions":[{"id":"g6-main-w3-core-q1","type":"shortText","prompt":"Write a structured prompt","stem":"Goal: ___\nContext: ___\nFormat: ___","autoMarked":false,"lookFor":"All three parts present and specific: Goal (what to do), Context (details the tool needs), Format (how the answer should look). Emerging (expected) is a prompt with a clear goal, context and format; two of the three parts is approaching; a vague or unstructured prompt is not yet. Structure beats length - a short, clear frame can be stronger than a long rambling one. No personal or identifying data in the context.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-core-q2","type":"shortText","prompt":"Evaluate and adjust","stem":"Task complete? ___ because ___\nMy one adjustment: ___","autoMarked":false,"lookFor":"Look for judgement against the task, not just 'it looks good' - for example 'Not fully - it gave four bullets but I asked for three, and one was off-topic.' The adjustment should be one clear change that improves completion, such as adding 'Give exactly three bullet points, each under 12 words.' Emerging (expected): judges completion accurately against the task and makes one adjustment that improves completion.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-core-q3","type":"shortText","prompt":"Task-completion log","columns":["Structured prompt","Output summary","Task complete?","One adjustment"],"autoMarked":false,"lookFor":"This is the lesson's main evidence. The log should show a structured prompt, a summary of the output, a 'task complete?' judgement made against the task, and one adjustment that improved completion. Accept a partly completed task if the judgement and adjustment are honest and specific.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-core-q4","type":"shortText","prompt":"Exit ticket","stem":"What are the three parts of a structured prompt, and which helped you most today?","autoMarked":false,"lookFor":"Goal (what to do), Context (details the tool needs), Format (how the answer should look). All three must be present, in the student's own wording and in any order or layout. The second half is a personal judgement - accept any one of the three parts as long as a reason is given.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-core-q5","type":"shortText","prompt":"Challenge (stretch)","stem":"Add an 'Audience' part to your prompt and describe how it changed the output.","autoMarked":false,"lookFor":"Stretch task: the student adds a fourth element (Audience) and shows how it improved the output. Look for a named audience in the prompt and a described change in the output that can be traced to it.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]}]}},"g6-main-w3-lab":{"id":"g6-main-w3-lab","number":6,"week":3,"track":"main","type":"lab","title":"Prompt-to-Task Workshop (Lab)","summary":"Students tackle a richer multi-requirement task with two different prompt structures, compare them on completion and accuracy, and turn the stronger one into a reusable template with a verification step and risk check built in.","duration":"1 x 45-minute period","strands":["SD"],"objectives":["Complete a second, richer task and compare which prompt structure worked better.","Design a reusable prompt structure for a class of tasks.","Evaluate the outputs for accuracy and run a basic risk check."],"sections":[{"type":"text","heading":"Prompt-to-Task Workshop (Lab)","body":["You can structure one prompt - now build something reusable. Today you compare prompt structures on a richer task and design a template you and your class can use again and again."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can complete a richer task with a structured prompt and compare two structures.","I can design a reusable prompt template for similar tasks.","I can check an output for accuracy and complete a risk check."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"richer task","definition":"A task with several requirements to complete."},{"term":"prompt structure","definition":"The order and parts of a prompt, such as Goal-Context-Format."},{"term":"reusable template","definition":"A prompt skeleton with slots that works for many similar tasks."},{"term":"verification","definition":"Checking an output against a reliable source."},{"term":"risk check","definition":"A quick check for personal data and possible errors."}],"role":"vocabulary"},{"type":"text","heading":"Compare, then reuse","body":["A [[richer task]] has several requirements, so a weak prompt structure leaves parts unfinished. Run two structures on the same task and compare which completes it and which is more accurate.","Then turn the winner into a [[reusable template]] - a prompt with labelled slots you can fill in for any similar task."],"role":"explain"},{"type":"text","heading":"Build in the checks","body":["Every good template forces two checks: verify the output against a reliable source, and run a [[risk check]] for personal data and errors.","This is how real AI solutions are designed - and it is the foundation for your signature activity in the coming weeks."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Complete a richer task with two structures, compare them, then design a reusable template with checks built in."],"items":["List the three requirements of the task.","Draft two structured prompts with different orders.","Compare which output completed the task and check accuracy.","Turn the stronger structure into a reusable template.","Add a verification step and a risk check."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which structure completed more of the task, and how do you know?","Where should the verify step sit in your template?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the biggest difference between your two structures.","Write how your template forces an accuracy check."],"role":"reflect"}],"worksheet":{"title":"Week 3 - Lab - Worksheet | Prompt-to-Task Workshop (Lab)","questions":[{"id":"g6-main-w3-lab-q1","type":"shortText","prompt":"Compare two structures","stem":"Structure A met ___ of 3\nStructure B met ___ of 3\nThe stronger structure was ___ because ___","autoMarked":false,"lookFor":"The comparison must be on completion or accuracy, not length - for example 'Structure A met all three requirements; Structure B missed the tone, so A was stronger.' Emerging (expected): compares two structures on completion and accuracy with evidence. Watch for the misconception that the longest answer is the best.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-lab-q2","type":"shortText","prompt":"Design a reusable template","stem":"Goal: ___\nContext (no personal data): ___\nFormat: ___\nVerify: ___","autoMarked":false,"lookFor":"Model template: 'Goal: [task]; Context: [details, no personal data]; Format: [exact format]; then Verify: check facts against a source.' The template must include a verify/risk step and use labelled slots rather than one fixed task. Emerging (expected): a clear reusable template with labelled slots.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-lab-q3","type":"shortText","prompt":"Structure comparison record","columns":["Structure","Requirements met","Accurate?","Stronger?"],"autoMarked":false,"lookFor":"Evidence for the comparison: both structures recorded, requirements met marked per structure, an accuracy check against a reliable source, and a stated winner. A record that marks completion but never checks accuracy is only approaching - sounding right is not being right.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-lab-q4","type":"shortText","prompt":"Exit ticket","stem":"Write your reusable template in one line and say how it checks accuracy.","autoMarked":false,"lookFor":"A one-line template with labelled slots (Goal / Context / Format) plus a named verification step - checking the output against a reliable source before use. Privacy (no personal data requested) is a bonus here; both privacy and accuracy must appear in the risk check overall.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]},{"id":"g6-main-w3-lab-q5","type":"shortText","prompt":"Challenge (stretch)","stem":"Test your template on a genuinely different task and note where it needed changing.","autoMarked":false,"lookFor":"Stretch task: groups test the template on a genuinely different task type and report where it needed changing. Look for the insight that a template is a strong starting point, not a guarantee - each new task still needs its output verified.","frameworkRefs":[{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"}]}]}},"g6-main-w4-core":{"id":"g6-main-w4-core","number":7,"week":4,"track":"main","type":"core","title":"Judging Outputs - Correct, Incorrect, Unclear","summary":"Students learn to give every AI output one of three verdicts - correct, incorrect or unclear - and to back each judgement with a reason they can check.","duration":"45 minutes","strands":["CE"],"objectives":["Identify, in a set of outputs, which are incorrect or unclear and say why.","Explain one signal that an output cannot be trusted as-is.","Recommend one action to take when an output is unclear."],"sections":[{"type":"text","heading":"Judging Outputs - Correct, Incorrect, Unclear","body":["An answer can sound perfectly sure of itself and still be wrong. Today you become the judge who decides whether an output is correct, incorrect, or simply unclear - and you learn to back up every judgement with a reason."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can sort outputs into correct, incorrect, and unclear.","I can give a reason for each judgement I make.","I can name one action to take when an output cannot be trusted."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Output","definition":"The text or answer an AI tool produces after you give it a prompt."},{"term":"Verdict","definition":"The judgement you give an output: correct, incorrect, or unclear."},{"term":"Source","definition":"A trusted place, like a textbook or official website, you check an answer against."},{"term":"Hallucination","definition":"When an AI tool states something made up as if it were a fact."},{"term":"Verify","definition":"To check whether something is true using a reliable source."}],"role":"vocabulary"},{"type":"text","heading":"Sounds right is not the same as is right","body":["A language model writes by predicting which words usually come next. That makes its answers smooth and confident, but confidence is a writing style, not proof.","Your job is to separate 'sounds right' from 'is right' by checking the output against the task you set and a source you trust."],"role":"explain"},{"type":"text","heading":"Three verdicts","body":["**Correct** means the output matches the task and agrees with a trusted source.","**Incorrect** means it clashes with something you can check now - a fact, a number, or your instruction.","**Unclear** means it is vague, incomplete, or you cannot [[verify]] it yet, so it needs more checking before use."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["You will triage three short outputs. For each, give a verdict and a six-word reason. Remember: a reason must point to a check, not a feeling."],"items":["Read the task the output was meant to answer.","Read the output carefully.","Check it against the task and any source given.","Write your verdict: correct, incorrect, or unclear.","Add a short reason and, if needed, one action."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which signal most often warned you an output was not trustworthy?","When an output is unclear, is it safer to pause or to proceed?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you will now check before trusting an AI answer.","Describe a time a confident answer turned out to be wrong."],"role":"reflect"}],"worksheet":{"title":"Week 4 - Core - Worksheet | Judging Outputs - Correct, Incorrect, Unclear","questions":[{"id":"g6-main-w4-core-q1","type":"shortText","autoMarked":false,"prompt":"Triage three outputs. For each output, circle a verdict and write a checkable reason.","stem":"This output is ... because when I checked it against ...\nI cannot verify this because ...","lookFor":"Triages at least 2 of the 3 outputs correctly, and every verdict carries a reason tied to the task or to a source rather than to a feeling.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-core-q2","type":"shortText","autoMarked":false,"prompt":"Signal and action. Name one signal that an output cannot be trusted, and the action you would take.","stem":"A warning signal is ...\nMy action would be ...","lookFor":"Any one checkable signal is acceptable - it contradicts the task, has no source, or contains a detail we cannot check - paired with a sensible action such as re-check, re-prompt, or ask a person.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-core-q3","type":"shortText","autoMarked":false,"prompt":"Output-triage record. Record your verdict, reason, and action for each output.","stem":"Output | Verdict | Reason (checkable) | Action","lookFor":"Each row pairs a verdict with a reason tied to task or source, and names a sensible action for any output judged unclear or incorrect.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-core-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket: flag these three outputs correct / incorrect / unclear and give a reason for each.","lookFor":"Correctly triages at least 2 of 3 outputs and gives a valid reason for each judgement. Push any 'it just feels wrong' towards a checkable reason.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-core-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch): find the single detail in a 'correct-looking' output that actually makes it incorrect, and explain how you spotted it.","lookFor":"Isolates the one subtle detail that flips the output from correct to incorrect, and explains the check that exposed it rather than describing a general impression.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"}]}},"g6-main-w4-lab":{"id":"g6-main-w4-lab","number":8,"week":4,"track":"main","type":"lab","title":"Output Triage Clinic (Lab)","summary":"Groups rotate through four output stations, diagnose each as correct, incorrect or unclear, choose a verification action, and rank them all on a trust ladder they must defend.","duration":"45 minutes","strands":["CE"],"objectives":["Apply a triage routine to a set of curated outputs and record correct/incorrect/unclear with reasons.","Rank outputs from most to least trustworthy and defend the order.","Choose a verification action for each untrustworthy output."],"sections":[{"type":"text","heading":"Output Triage Clinic (Lab)","body":["Welcome to the triage clinic. Each output is a patient waiting for a diagnosis - correct, incorrect, or unclear - and a treatment: the action you would take to verify it. By the end you will have ranked them all on a trust ladder."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run the triage routine across a full set of outputs.","I can rank outputs by trustworthiness and defend my order.","I can choose a verification action for outputs I cannot trust."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Triage","definition":"Quickly sorting items by how they need to be handled."},{"term":"Verification action","definition":"The concrete step you take to check whether an output is true."},{"term":"Trust ladder","definition":"An ordering of outputs from most to least trustworthy."},{"term":"Risk check","definition":"Asking what could go wrong if an output were used as-is."}],"role":"vocabulary"},{"type":"text","heading":"Match the check to the output","body":["A fact needs a trusted source. A summary needs comparing back to the original text. A vague instruction needs a clearer prompt before you can even judge it.","Choosing the right check is what turns a guess into a verified judgement."],"role":"explain"},{"type":"text","heading":"Rank and defend","body":["After triaging, place your outputs on the [[trust ladder]] from most to least trustworthy.","Be ready to defend your order using signals, not preferences: what evidence puts one output above another?"],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Rotate through four stations. Triage each output, choose a verification action, then rank them all on the trust ladder and prepare to defend your order."],"items":["Read the task and output at each station.","Assign a verdict and write a checkable reason.","Choose a verification action that fits the output type.","Rank all outputs on the trust ladder.","Agree your group's defence and one risk of the least trustworthy output."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which verification action was hardest to choose, and why?","Did any output move up or down the ladder after you discussed it?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one verification action you will reuse in a future task.","Describe how you would explain your ranking to another group."],"role":"reflect"}],"worksheet":{"title":"Week 4 - Lab - Worksheet | Output Triage Clinic (Lab)","questions":[{"id":"g6-main-w4-lab-q1","type":"shortText","autoMarked":false,"prompt":"Clinic diagnoses. For each station, record the verdict, a checkable reason, and a verification action.","stem":"Verdict:\nReason:\nVerification action:","lookFor":"Triages the full set with valid, checkable reasons that cite the source or the original text used, and matches a suitable check to each output type rather than using one generic check for all.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-lab-q2","type":"shortText","autoMarked":false,"prompt":"Defend your ladder. Explain why your top output is more trustworthy than your bottom output.","stem":"Top is more trustworthy because ...\nBottom is least trustworthy because ...","lookFor":"Justifies the placement with trustworthiness signals - sources, match to the task, checkability - not preference. Any defensible order with signal-based reasons is acceptable.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-lab-q3","type":"shortText","autoMarked":false,"prompt":"Triage clinic record. Complete one row per station output.","stem":"Station | Verdict | Reason | Verification action | Ladder rank","lookFor":"Every station has a verdict, a valid reason, a chosen verification action and a ladder rank, with the ranking consistent with the reasons recorded.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-lab-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket: name one risk of using the least trustworthy output as-is, and who it could affect.","lookFor":"States a concrete risk that follows from the specific weakness they found in that output, and names who would be affected if it were used as-is.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"},{"id":"g6-main-w4-lab-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch): redesign one unclear output's prompt so its result could be triaged as clearly correct or incorrect.","lookFor":"Re-prompts for specific steps or details, so that the new output would be checkable - an unclear output cannot be judged until it is clarified.","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"}],"evidenceType":"product","tierProbed":"emerging"}]}}}};
}

