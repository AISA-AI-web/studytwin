function curriculumChunk3_() {
  return {"grade6":{"g6-bridging-w6-core":{"id":"g6-bridging-w6-core","number":11,"week":6,"track":"bridging","type":"core","title":"Trustworthy AI Helper - Trace the Data & Plan Checks (Part 2 Core)","summary":"Students trace how the data driving their helper shapes its outcome, then plan a trusted-source verification and a risk check before trusting it.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Explain how the data used influences the helper's outcome, and predict a data change's effect.","Plan how you will verify the output and check for basic risks before trusting it."],"sections":[{"type":"text","body":["Your helper works - now make sure it can be trusted. Today you trace how the data shapes its outcome and plan how you will verify it and check its risks."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can explain how the data shapes my helper's outcome and predict a change.","I can plan a verification and a risk check for my helper."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Trace","definition":"To follow how the data leads to the outcome."},{"term":"Verify","definition":"To check a claim against a trusted, independent source."},{"term":"Risk","definition":"A way the output could be wrong, unsafe, biased, or a privacy problem."}],"role":"vocabulary"},{"type":"text","heading":"The data drives the outcome","body":["Change the data and the outcome changes. So you can [[trace]] which data drives which part of the output.","Knowing this helps you trust - or fix - your helper."],"role":"explain"},{"type":"text","heading":"Plan your checks","body":["Verification checks a claim against a trusted source - not by asking the AI again.","A [[risk]] check asks: could this be wrong, unsafe, biased, or a privacy problem, and how would I reduce it?"],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Trace the data's influence, then plan your verification and risk check."],"items":["Name the data that drives one part of your output.","Predict how a data change would alter the outcome.","Choose a claim to verify against a trusted source.","Name one risk and a way to reduce it.","Write your check plan."],"role":"activity"},{"type":"list","heading":"Think about it","items":["How does your data shape your outcome?","What is the most trustworthy way to verify a claim?","What is your helper's biggest risk?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["The data that most shapes my outcome is ...","I will verify ... against ...","My top risk is ... and I will reduce it by ..."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Core - Worksheet | Trustworthy AI Helper - Trace the Data & Plan Checks (Part 2 Core)","questions":[{"id":"g6-bridging-w6-core-aq1","type":"mcq","marks":2,"prompt":"Maya's helper suggests one book for her class. It uses the class survey, in which 9 of the 20 pupils picked adventure and only 4 picked science. Maya then adds 12 more replies from the science club, and every one of them picks science. She runs the helper again on the new data. What is the best prediction of what happens to the suggestion?","options":[{"id":"a","text":"It is likely to change to a science book, because science is now the most-picked genre in the data."},{"id":"b","text":"It stays an adventure book, because the helper already chose adventure the first time."},{"id":"c","text":"It stays an adventure book, because only a new prompt can change what the helper suggests."},{"id":"d","text":"It becomes unpredictable, because the helper now has replies from two different groups."}],"answer":"a","feedback":{"correct":"Exactly - the suggestion follows the data, so once science becomes the most-picked genre the suggestion moves with it.","incorrect":"The helper does not remember its earlier answer and does not need a new prompt; it counts the data it is given again, and science (16) now beats adventure (9)."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-core-aq2","type":"truefalse","marks":1,"prompt":"Ben's helper claims that adventure was the most popular genre in his class. Ben asks the same helper the same question again, gets the same answer, and writes on his plan that the claim is verified. Ben has verified his claim.","answer":false,"feedback":{"correct":"Right - asking the same tool twice only repeats it; verifying means checking the claim against a trusted source outside the tool, such as the survey totals themselves.","incorrect":"A tool that is wrong once will usually be wrong the same way twice, so repeating the question proves nothing - verification means checking the claim against a trusted, independent source."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-core-aq3","type":"matching","marks":4,"prompt":"Each row on the left is a risk a pupil found in their helper. Match each risk to the mitigation that would reduce it.","left":[{"id":"L1","text":"One pupil's reply was entered twice, so that pupil's opinion is counted double."},{"id":"L2","text":"The output names a pupil and says which class they are in."},{"id":"L3","text":"Only the pupils in the chess club answered the survey, so most of the class is missing."},{"id":"L4","text":"The helper states a fact about the class that nobody has checked."}],"right":[{"id":"R1","text":"Check the fact against the survey totals before using it."},{"id":"R2","text":"Delete the repeated reply so that each pupil counts once."},{"id":"R3","text":"Take the personal details out so that the output names nobody."},{"id":"R4","text":"Collect replies from the rest of the class before running the helper again."}],"answer":{"L1":"R2","L2":"R3","L3":"R4","L4":"R1"},"feedback":{"correct":"Well matched - a mitigation has to fix the particular thing that could go wrong, not just be a generally sensible action.","incorrect":"Ask what each risk would do to the output: a double-counted reply needs the duplicate removed, a named pupil needs the personal details taken out, a missing group needs more replies, and an unchecked fact needs verifying."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-core-aq4","type":"ordering","marks":3,"prompt":"Trace how the data leads to the outcome in Maya's book helper. Put these four steps into the order in which they happen.","items":[{"id":"i1","text":"The helper suggests an adventure book to the class."},{"id":"i2","text":"Every pupil's genre choice is collected in the class survey."},{"id":"i3","text":"Adventure comes out as the most-picked genre."},{"id":"i4","text":"The helper counts how many pupils picked each genre."}],"answer":["i2","i4","i3","i1"],"feedback":{"correct":"That is the trace: data first, then the counting, then the result, and the result drives the suggestion - which is why changing the data changes the outcome.","incorrect":"Follow the data forwards: the replies are collected, then counted, the count gives the top genre, and only then does the helper suggest a book."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-core-aq5","type":"multi","marks":3,"prompt":"Which of these belong in a good check plan for an AI helper? Choose all that apply.","options":[{"id":"a","text":"Compare the helper's claim with the survey totals yourself."},{"id":"b","text":"Ask the same helper the question again and accept the answer if it matches the first one."},{"id":"c","text":"Look for a reply that was entered twice and remove it before trusting the result."},{"id":"d","text":"Check whether the output includes details that could identify a pupil, and take them out."},{"id":"e","text":"Ask the helper to say its answer more confidently so that it sounds more reliable."}],"answer":["a","c","d"],"feedback":{"correct":"Yes - a real check plan compares the output with something trustworthy outside the tool and looks for ways the output could be wrong or unfair.","incorrect":"Repeating the question and making the wording sound more confident change nothing about whether the answer is true; the checks that count compare the claim with a trusted source and hunt for risks in the data and the output."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"}]},"formative":{"targets":"Integrated mastery - CE (data influences the outcome) and planning for GE (verification and risk)","check":"Data-influence trace + verification/risk plan on the Log, reviewed against the mastery criteria","successCriteria":"Explains the data's influence on the outcome, predicts a data change, and plans a trustedsource verification and a risk check.","evidence":"Trustworthy AI Helper Log, Part 2 (Core section)."}},"g6-bridging-w6-lab":{"id":"g6-bridging-w6-lab","number":12,"week":6,"track":"bridging","type":"lab","title":"Trustworthy AI Helper - Verify, De-risk & Showcase (Part 2 Lab)","summary":"Students carry out their verification and risk check, refine and re-verify if a check fails, then argue with evidence that their helper can be trusted and reflect across the four skills.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Carry out the verification and risk check, refine the helper if a check fails, and confirm it can be trusted.","Present the Trustworthy AI Helper and reflect on the thinking used across all four skills."],"sections":[{"type":"text","body":["Time to prove it. Today you verify your helper, reduce a risk, and show that it can be trusted then present it and reflect on everything you have learned."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can verify my helper's output and reduce a risk, refining if needed.","I can present my helper and reflect on my thinking."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Mitigation","definition":"A change that reduces a risk."},{"term":"Trustworthy","definition":"Something you can rely on because you have checked it."},{"term":"Evidence","definition":"The proof you give for a claim or a judgement."}],"role":"vocabulary"},{"type":"text","heading":"Verify, then de-risk","body":["Verify a claim in your output against a trusted source. If it fails, refine and re-verify.","Run your risk check and apply a [[mitigation]] - then re-check that it worked."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Verify, de-risk, then showcase and reflect."],"items":["Verify your claim against a trusted source.","If it fails, refine and re-verify.","Run your risk check; apply one mitigation.","Confirm your helper can be trusted, with evidence.","Prepare a one-minute showcase.","Present and reflect."],"role":"activity"},{"type":"list","heading":"Think about it","items":["What did your verification find?","What risk did you reduce, and how?","Which of the four skills was hardest?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My helper is trustworthy because ...","The check that mattered most was ...","The skill I found hardest was ... and I worked through it by ..."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Lab - Worksheet | Trustworthy AI Helper - Verify, De-risk & Showcase (Part 2 Lab)","questions":[{"id":"g6-bridging-w6-lab-aq1","type":"mcq","marks":2,"prompt":"Sam's helper says 'most of our class picked adventure'. He checks the class survey totals: adventure 7, science 11. His verification has failed. What should he do next?","options":[{"id":"a","text":"Refine the helper so that its claim fits the data, then verify the claim again."},{"id":"b","text":"Keep the output as it is and add a note saying that it might be wrong."},{"id":"c","text":"Ask the helper the same question again and use whichever answer it gives."},{"id":"d","text":"Change the survey totals so that they agree with the helper's claim."}],"answer":"a","feedback":{"correct":"Exactly - a failed check is useful information: you refine the helper and then re-verify, rather than keeping an output you know does not match the data.","incorrect":"A failed check means the output is wrong, so warning labels, re-asking the tool, or editing the real totals all leave the mistake in place - refine the helper, then verify again."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-lab-aq2","type":"ordering","marks":4,"prompt":"Sam's first verification failed. Put these five steps into the order he should follow to fix his helper and show that it can be trusted.","items":[{"id":"i1","text":"He checks the new claim against the survey totals again, and this time it matches."},{"id":"i2","text":"He checks the helper's claim against the class survey totals."},{"id":"i3","text":"He uses the passed check as evidence that his helper can be trusted."},{"id":"i4","text":"He finds that the claim does not match the totals."},{"id":"i5","text":"He changes the helper so that its claim follows the data."}],"answer":["i2","i4","i5","i1","i3"],"feedback":{"correct":"That is the verify-refine-re-verify loop: you can only argue that a helper is trustworthy after a check has actually been passed.","incorrect":"Check first, and only then find the problem, change the helper, and check again - the trust argument comes last, because it rests on the check that finally passed."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-lab-aq3","type":"multi","marks":3,"prompt":"Which of these count as evidence that a helper can be trusted? Choose all that apply.","options":[{"id":"a","text":"I checked the claim 'adventure was picked most' against the survey totals, and it matched."},{"id":"b","text":"I removed the duplicate reply, ran the helper again, and now no pupil is counted twice."},{"id":"c","text":"The helper answered very quickly and never hesitated."},{"id":"d","text":"I asked the helper whether it was sure, and it said yes."},{"id":"e","text":"I took the pupils' names out of the output and checked that none were left."}],"answer":["a","b","e"],"feedback":{"correct":"Yes - evidence is a check you actually carried out and the result it gave, not how confident or fast the helper seemed.","incorrect":"Speed and a confident 'yes' from the tool tell you nothing about whether the output is right; evidence is a check you carried out against something trustworthy, and a mitigation you applied and then re-checked."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-lab-aq4","type":"matching","marks":4,"prompt":"In your reflection you look back across the four skills you used. Match each skill to the piece of work that shows it.","left":[{"id":"L1","text":"Data quality"},{"id":"L2","text":"Prompt refinement"},{"id":"L3","text":"Data influence"},{"id":"L4","text":"Verification and risk"}],"right":[{"id":"R1","text":"I showed that the most-picked genre in the survey is what decided the suggestion."},{"id":"R2","text":"I found two replies from the same pupil and removed one before using the data."},{"id":"R3","text":"I checked the claim against the survey totals and took the pupils' names out of the output."},{"id":"R4","text":"My first instruction gave a vague answer, so I rewrote it to ask for one book and a reason."}],"answer":{"L1":"R2","L2":"R4","L3":"R1","L4":"R3"},"feedback":{"correct":"Well matched - each skill leaves a different trace in your work, which is what makes a reflection specific rather than vague.","incorrect":"Cleaning the data is data quality, rewriting the instruction is prompt refinement, showing which data decided the output is data influence, and checking a claim or reducing a risk is verification and risk."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w6-lab-aq5","type":"mcq","marks":2,"prompt":"Leila's helper suggests one book for the whole class, and all of her checks passed. A friend now wants to use the same helper to label which pupils are 'good readers' and which are not. Which rule best fits what this lesson teaches about risk?","options":[{"id":"a","text":"Use the helper to suggest a book for the class, but not to label individual pupils, because a wrong or unfair output would judge a real person."},{"id":"b","text":"Use it for both, as long as you tell people that an AI made the decision."},{"id":"c","text":"Use it for both, because the data behind the helper has already been checked once."},{"id":"d","text":"Stop using the helper altogether, because any output it gives could turn out to be wrong."}],"answer":"a","feedback":{"correct":"Exactly - the same helper carries a much bigger risk when its output labels a person, so the sensible rule limits it to the use where a mistake is easy to spot and easy to undo.","incorrect":"Passing checks for one job does not make a helper safe for every job - announcing that an AI decided, or checking the data once, does not undo the harm of unfairly labelling a pupil, and the book suggestion was already shown to be trustworthy."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"}]},"formative":{"targets":"Integrated mastery confirmation - GE (verification and risk) with CU, SD, CE from earlier, plus reflection","check":"Completed verification + risk mitigation on the Log, a one-minute showcase, and the four-skill reflection","successCriteria":"Verifies a claim against a trusted source, applies a risk mitigation (refining if needed), argues trust with evidence, presents, and reflects across the four skills.","evidence":"Trustworthy AI Helper Log (Part 2 Lab) and observed showcase."}},"g6-main-w1-core":{"id":"g6-main-w1-core","number":1,"week":1,"track":"main","type":"core","title":"Unit Launch - Rule-Based vs Learning Systems","summary":"Students meet the term's big question by sorting three real systems into 'follows fixed rules' or 'learns from data', posting their own questions and helping agree the class responsible-use rules.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Generate at least two questions about how rule-based and learning systems differ.","Classify three systems as 'follows fixed rules' or 'learns from data', justifying each.","Co-construct the unit success criteria and the responsible-use norms for AI tools."],"sections":[{"type":"text","body":["Some machines are told every single step. Others are shown lots of examples and work out the pattern themselves. This term you become a system detective - can you tell which kind you are looking at?"],"role":"intro"},{"type":"list","heading":"I can…","items":["I can ask at least two genuine questions about rule-based and learning systems.","I can sort three systems into 'follows fixed rules' or 'learns from data' and give a reason for each.","I can help write our class responsible-use rules for AI tools."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-based system","definition":"A system that follows fixed steps a person wrote for it."},{"term":"learning system","definition":"A system that finds patterns from many examples instead of fixed rules."},{"term":"data","definition":"The examples or information a learning system is shown."},{"term":"model","definition":"The pattern a learning system builds from its data."},{"term":"example","definition":"One piece of data, like one photo or one email."}],"role":"vocabulary"},{"type":"text","heading":"Two kinds of machine","body":["A [[rule-based system]] is like a recipe. A person writes every step, and the machine follows them exactly. A Salik toll gate charges you when your car passes - a person set that rule.","A [[learning system]] is different. Nobody writes a rule for every case. Instead it is shown many examples - this is [[data]] - and it finds the pattern by itself. The pattern it builds is called a [[model]]."],"role":"explain"},{"authored":true,"type":"diagram","variant":"compare","label":"The distinction the whole unit rests on","heading":"Where did the rule come from?","altText":"Two columns. In a rule-based machine a person writes the rule and the machine follows it. In a learning machine, examples go in and the machine works the rule out for itself.","left":{"title":"Rule-based machine","steps":["A person works out the rule","They write it down as steps","The machine follows the steps"]},"right":{"title":"Learning machine","accent":true,"steps":["A person collects examples","The machine finds the rule in them","The machine uses what it found"]},"caption":"Same job, different source. Ask **who worked out the rule** — that is the question this unit keeps coming back to.","role":"diagram"},{"type":"text","heading":"Why it matters","body":["If you know which kind a system is, you can guess when it might fail. A rule-based system fails when something happens that has no rule. A learning system can fail if it was shown poor or unfair examples.","Neither kind is magic, and neither understands like a person. That is why we always check what a machine tells us."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Time to be a detective. Sort three systems, then post the questions you most want answered this term."],"items":["Watch the two clips your teacher shows and spot which machine was told every step.","Sort the three cards into 'fixed rules' or 'learns from data'.","Write a reason under each card.","Post two questions on the class question wall.","Help agree one class rule for safe AI use."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which system was hardest to sort, and why?","What is one clue that a system learned from examples?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you now understand about how machines make decisions.","Write one question you still have."],"role":"reflect"}],"worksheet":{"title":"Week 1 - Core - Worksheet | Unit Launch - Rule-Based vs Learning Systems","questions":[{"id":"g6-main-w1-core-aq1","type":"mcq","marks":2,"prompt":"A spam filter was built by showing a computer thousands of emails that people had already labelled 'spam' or 'not spam'. Nobody wrote a rule for every email. Which sorting and reason is correct?","options":[{"id":"a","text":"Learns from data, because it found the pattern itself from many labelled example emails."},{"id":"b","text":"Follows fixed rules, because a person had to label the example emails first."},{"id":"c","text":"Learns from data, because it gets faster the more emails you send it."},{"id":"d","text":"Follows fixed rules, because a person wrote a step for every kind of email it might meet."}],"answer":"a","feedback":{"correct":"Right - the logic came from the examples, not from steps a person wrote, which is exactly what makes it a learning system.","incorrect":"People labelled the examples, but nobody wrote a rule for each email - the filter found the pattern in that data itself, so it learns from data."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-core-aq2","type":"matching","marks":4,"prompt":"A photo app was shown 10,000 photos that people had already labelled 'cat' or 'not cat', and it worked out the pattern for itself. A Salik toll gate charges every car that passes, because a person wrote that step. Match each part of the story to the word that names it.","left":[{"id":"L1","text":"The 10,000 labelled photos the app was shown"},{"id":"L2","text":"One single labelled photo out of that collection"},{"id":"L3","text":"The pattern the app built so it can spot cats in photos it has never seen"},{"id":"L4","text":"The toll gate, which charges every car because a person wrote that step"}],"right":[{"id":"R1","text":"data"},{"id":"R2","text":"example"},{"id":"R3","text":"model"},{"id":"R4","text":"rule-based system"}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"feedback":{"correct":"Good - you used the words on a real case: many examples make up the data, the pattern built from them is the model, and written steps make a rule-based system.","incorrect":"The whole collection shown to the app is the data, one photo from it is an example, the pattern built from them is the model, and the toll gate with its written step is the rule-based system."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-core-aq3","type":"multi","marks":3,"prompt":"You want to work out whether a new app follows fixed rules or learns from data. Which questions would actually help you decide? Choose all that would help.","options":[{"id":"a","text":"Was it shown lots of examples that people had already labelled?"},{"id":"b","text":"Did a person write a step for every case the app has to handle?"},{"id":"c","text":"Would the app behave differently if it had been shown different examples?"},{"id":"d","text":"How quickly does the app give you an answer?"},{"id":"e","text":"Which company made the app, and how new is it?"}],"answer":["a","b","c"],"feedback":{"correct":"Yes - good questions go after where the logic came from: written steps, or a pattern found in examples.","incorrect":"Speed and who made it are the same for both kinds. The useful questions ask where the logic came from - written steps, or examples the app learned a pattern from."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-core-aq4","type":"truefalse","marks":1,"prompt":"True or false? A learning system is really just a very long list of fixed rules that a programmer typed in, one rule for every case.","answer":false,"feedback":{"correct":"Correct - no one types a rule for every case; the system is shown many examples and builds the pattern itself.","incorrect":"That is the common mix-up. A learning system has no written rule for each case - it finds the pattern from the examples it is shown."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-core-aq5","type":"fillBlank","marks":2,"prompt":"Fill in each gap with either 'follows fixed rules' or 'learns from data'. A toll gate charges every car as it passes, because a person wrote that step for it, so it ___(1). A spam filter was shown thousands of emails already labelled spam or not spam and worked out the pattern itself, so it ___(2).","blanks":["",""],"feedback":{"correct":"Well sorted - you used the deciding clue each time: who supplied the logic, a person or the examples.","incorrect":"Ask who supplied the logic. A person wrote the toll gate's step, so it follows fixed rules; the filter found its own pattern in the examples, so it learns from data."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","answer":[["follows fixed rules","follows fixed steps","follows rules","fixed rules","is rule-based","rule-based","is a rule-based system","uses fixed rules"],["learns from data","learns from examples","learns","learning","is a learning system","learning system","learns the pattern from data"]]}]},"formative":{"targets":"Baseline for the rule-based vs learning-system distinction and safe-use norms","check":"Diagnostic KWL + question wall + rule/learning sort (not graded)","successCriteria":"Poses at least 2 genuine questions and sorts at least 2 of 3 systems with a reason.","evidence":"Sorted systems + question wall on the baseline sheet."}},"g6-main-w1-lab":{"id":"g6-main-w1-lab","number":2,"week":1,"track":"main","type":"lab","title":"Rule vs Learning - Hands-On Exploration (Lab)","summary":"Working unplugged at two stations, students run a fixed rule-card machine and a learn-from-examples card game, log the differences and design a test that would reveal which kind an unknown system is.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Explore a rule-based demo and a simple learning demo and log the differences you observe.","Devise a test that could tell whether a system follows rules or learns.","Predict what would break each system and check your prediction."],"sections":[{"type":"text","body":["Today you get your hands on two machines - one that never changes and one that learns from examples. Watch closely: their differences will jump out."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run the rule-card machine and the learn-from-examples game and record what each does.","I can log at least three differences I observed between them.","I can design a fair test that would reveal whether a system follows rules or learns."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-card machine","definition":"A fixed stack of if-then cards that always behaves the same way."},{"term":"example card","definition":"A labelled card the group learns a pattern from."},{"term":"pattern","definition":"The rule-of-thumb your group builds from the example cards."},{"term":"test input","definition":"A new input you give a system to see how it behaves."},{"term":"predictable","definition":"Behaves the same way every time for the same input."}],"role":"vocabulary"},{"type":"text","heading":"Two stations, two behaviours","body":["At Station A the [[rule-card machine]] never changes. Feed the same input twice and you get the same output twice. That is a rule-based system.","At Station B nobody gives you rules. You study [[example card]]s, build a [[pattern]], then classify new cards. That is a learning system in miniature."],"role":"explain"},{"type":"text","heading":"Design a fair test","body":["To tell the two apart, give each a brand-new, unusual input. A rule-based machine reacts the same as always or breaks. A learning system tries to match the pattern it built.","The best detectives write down exactly what they will try and what each result would mean."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Run both stations, log the differences, then design a test that would reveal which kind an unknown machine is."],"items":["Take a role: feeder, recorder or tester.","Run Station A with five inputs, including one strange one.","Run Station B: study examples, then sort five new cards.","Log at least three differences.","Write one test that would separate rules from learning."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which station was more predictable, and how did you know?","What made the learning game guess wrongly?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the clearest difference you saw today.","Write what you would test first on a mystery machine."],"role":"reflect"}],"worksheet":{"title":"Week 1 - Lab - Worksheet | Rule vs Learning - Hands-On Exploration (Lab)","questions":[{"id":"g6-main-w1-lab-aq1","type":"mcq","marks":2,"prompt":"Sam is given a mystery machine and wants to find out whether it follows fixed rules or learns. Which test would actually tell him?","options":[{"id":"a","text":"Give it a brand-new, unusual input and watch whether it reacts the same as always or tries to match a pattern."},{"id":"b","text":"Give it only inputs it has handled before and check that the answers are still right."},{"id":"c","text":"Give it the same easy input five times and time how fast each answer comes back."},{"id":"d","text":"Count how many different answers the machine can give altogether."}],"answer":"a","feedback":{"correct":"Exactly - a new, unusual input is what splits them: fixed rules react the same or break, while a learning system reaches for the pattern it built.","incorrect":"Familiar inputs, speed and the number of answers look much the same for both kinds. Only a brand-new, unusual input shows whether the machine follows a written step or matches a pattern."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-lab-aq2","type":"ordering","marks":4,"prompt":"Put these steps in order to run a fair test on a mystery machine.","items":[{"id":"i1","text":"Write down the unusual input you will try and what each possible result would mean."},{"id":"i2","text":"Give that unusual input to the machine."},{"id":"i3","text":"Record exactly what the machine did."},{"id":"i4","text":"Use what you recorded to decide whether the machine follows fixed rules or learns."}],"answer":["i1","i2","i3","i4"],"feedback":{"correct":"That is how a detective works - decide what each result would mean before you test, so the result can't be bent to fit afterwards.","incorrect":"Plan first: write the input and what each result would mean, then test, then record what happened, and only then decide which kind of machine it is."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-lab-aq3","type":"matching","marks":4,"prompt":"Match each thing a group tried at the two stations with what happened.","left":[{"id":"L1","text":"Fed the rule-card machine the same card twice"},{"id":"L2","text":"Fed the rule-card machine a strange card that no rule covered"},{"id":"L3","text":"Gave the card game example cards that were all of one kind"},{"id":"L4","text":"Gave the card game plenty of varied, correctly labelled example cards"}],"right":[{"id":"R1","text":"It gave exactly the same output both times."},{"id":"R2","text":"It stopped, because no step had been written for that card."},{"id":"R3","text":"The pattern it built came out lopsided and it sorted new cards badly."},{"id":"R4","text":"The pattern it built sorted most of the new cards correctly."}],"answer":{"L1":"R1","L2":"R2","L3":"R3","L4":"R4"},"feedback":{"correct":"Good - each machine fails in its own way: fixed rules break on a case with no rule, and a learning system is only as good as the examples it was shown.","incorrect":"The rule-card machine repeats itself and breaks when no rule fits; the card game's guesses follow the examples it was given, so one-sided examples make a lopsided pattern."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-lab-aq4","type":"truefalse","marks":1,"prompt":"True or false? A rule-based machine can still fail: if it meets an input that none of its rules covers, it stops or gives a wrong answer.","answer":true,"feedback":{"correct":"Yes - following fixed rules does not mean never failing; it means failing whenever something turns up that has no rule.","incorrect":"Fixed rules are predictable, not perfect. At Station A the strange card had no rule, so the machine stopped or answered wrongly."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product"},{"id":"g6-main-w1-lab-aq5","type":"fillBlank","marks":2,"prompt":"Fill in the gaps. We tested a mystery machine with a brand-new, unusual input, and it gave exactly the answer it always gives, so we decided it ___(1). The Station B card game behaved differently: it tried to match the ___(2) it had built from the example cards.","blanks":["",""],"feedback":{"correct":"That is the difference in one sentence: fixed rules repeat themselves, while a learning system reaches for the pattern it built from its examples.","incorrect":"An unchanged answer to a brand-new input points to fixed rules; the card game instead matched the pattern it had built from the example cards."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","answer":[["follows fixed rules","follows fixed steps","follows rules","fixed rules","is rule-based","rule-based","is a rule-based system","uses fixed rules"],["pattern","the pattern","patterns"]]}]},"formative":{"targets":"Checks whether students can observe and articulate the rule-based vs learning distinction through investigation","check":"Comparison log with at least three logged differences and one devised test","successCriteria":"Logs at least three real differences and writes a test that would actually separate rules from learning.","evidence":"Completed comparison log and the group's devised test."}},"g6-main-w10-core":{"id":"g6-main-w10-core","number":19,"week":10,"track":"main","type":"core","title":"Showcase, Assessment & Reflection","summary":"Learners present their finished solution with two justified choices, complete a short Term-1 assessment sampling all four strands, and set a goal for next term.","duration":"1 x 45-minute period","strands":["CU","SD","CE","GE"],"objectives":["Present the finished solution and explain at least two design/evaluation choices.","Demonstrate the term's key outcomes in a short assessment task.","State one thing learned and set one goal for next term."],"sections":[{"type":"text","body":["This is your moment to show what you built and what you learned. You will present your finished solution, explain the choices behind it, complete a short assessment, and set a goal to grow even more next term."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can present my finished solution and explain at least two design or evaluation choices.","I can show the term's key outcomes in a short assessment task.","I can state one thing I learned and set one goal for next term."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Pitch","definition":"A short, clear explanation of your solution and its value."},{"term":"Justify","definition":"To give the reason and evidence behind a choice."},{"term":"Assessment","definition":"A task that shows what you have learned across the strands."},{"term":"Reflection","definition":"Thinking about what worked and what you would do next."},{"term":"Goal","definition":"A clear target for your next step of learning."}],"role":"vocabulary"},{"type":"text","heading":"A pitch that tells the truth","body":["A strong [[pitch]] names your user, the problem, how your solution works, and the evidence that it is accurate, useful and safe.","Explain two choices by giving reasons, not just descriptions. Be honest about one limit. Honesty makes your work more trustworthy, not weaker."],"role":"explain"},{"type":"text","heading":"Show the whole term, then look ahead","body":["The short [[assessment]] lets you show all four strands: understanding, building, evaluating and using responsibly, and wider effects.","Finish by naming one thing you learned and setting a [[goal]] for next term, aiming toward the Proficient tier."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Complete the short assessment, then present your solution and justify two choices before setting your next-term goal."],"items":["Set out your evidence from the term.","Complete the short assessment task on your own.","Prepare a 60-second pitch with two justified choices.","Present to your group and answer one 'why' question.","Write one thing learned and one Term-2 goal."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which of your two choices are you proudest of, and why?","What limit of your solution is important to be honest about?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you learned this term.","Set one goal for Term 2 that moves you toward Proficient."],"role":"reflect"}],"worksheet":{"questions":[{"id":"g6-main-w10-core-aq1","type":"mcq","marks":2,"prompt":"In your pitch you have to justify a choice, not just describe it. Which sentence justifies the choice?","options":[{"id":"a","text":"My sorter uses five rules — one each for plastic, paper, metal, glass and food waste."},{"id":"b","text":"I used a rule-based sorter because recycling categories have fixed correct answers, so the rules give the same reliable result every time."},{"id":"c","text":"I used a rule-based sorter because my group voted for that one."},{"id":"d","text":"My sorter was finished on time and looks clear on the screen."}],"answer":"b","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"A justified choice gives the reason behind it — fixed correct answers suit fixed rules — rather than listing what the solution contains.","incorrect":"Listing the rules, reporting a vote or praising the look all describe the solution; a justification says why that choice suited the problem."}},{"id":"g6-main-w10-core-aq2","type":"matching","marks":4,"prompt":"Your Term-1 assessment has to show all four strands. Match each piece of evidence to the strand it shows.","left":[{"id":"l1","text":"I can explain how a system that follows written rules is different from one that learns from examples."},{"id":"l2","text":"I made a working prototype that takes an item and puts it into a category."},{"id":"l3","text":"I ran my solution on six items whose correct answers I already knew, and recorded how many it got right."},{"id":"l4","text":"I described who might be treated unfairly if the whole school used my solution."}],"right":[{"id":"r1","text":"Understanding concepts"},{"id":"r2","text":"Design and build"},{"id":"r3","text":"Evaluate and use responsibly"},{"id":"r4","text":"Wider effects"}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Each strand needs its own evidence: explaining shows concepts, making shows design and build, testing shows evaluation, and thinking about users shows wider effects.","incorrect":"Ask what each piece of evidence proves you can do — explain, build, test or think about who is affected — and the strand follows from that."}},{"id":"g6-main-w10-core-aq3","type":"multi","marks":3,"prompt":"Which of these belong in a 60-second pitch that tells the truth? Select all that apply.","options":[{"id":"a","text":"Name your user and the problem your solution solves."},{"id":"b","text":"Give the evidence that your results were accurate."},{"id":"c","text":"State one honest limit of your solution."},{"id":"d","text":"Promise that your solution never gets anything wrong, so nobody doubts it."},{"id":"e","text":"Describe your two choices without saying why you made them."}],"answer":["a","b","c"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"A truthful pitch names the user and problem, backs its claims with evidence, and is open about one limit.","incorrect":"Promising perfection is not evidence, and a choice with no reason is only a description — neither makes a pitch more convincing."}},{"id":"g6-main-w10-core-aq4","type":"truefalse","marks":1,"prompt":"Admitting one limit of your solution during your pitch makes your work less trustworthy.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Correct — honesty about a limit makes your work more trustworthy, because your audience can believe the claims you do make.","incorrect":"The lesson says the opposite: being honest about a limit strengthens your pitch rather than weakening it."}},{"id":"g6-main-w10-core-aq5","type":"ordering","marks":4,"prompt":"Put the showcase and assessment steps into the order that makes each step possible.","items":[{"id":"s1","text":"Set out your evidence from the term."},{"id":"s2","text":"Complete the short assessment task on your own."},{"id":"s3","text":"Prepare a 60-second pitch with two justified choices."},{"id":"s4","text":"Present to your group and answer one 'why' question."},{"id":"s5","text":"Write one thing you learned and one goal for Term 2."}],"answer":["s1","s2","s3","s4","s5"],"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}],"evidenceType":"product","feedback":{"correct":"Evidence first so you can draw on it, the assessment on your own before you hear other people's ideas, then prepare, present, and reflect once you know how it went.","incorrect":"Each step feeds the next: you need your evidence out before you can use it, and you can only reflect on your learning after you have presented."}}]},"formative":{"targets":"Summative Term-1 task samples all four strands at Emerging; reflection informs Term 2","check":"Short Term-1 performance task marked with the analytic rubric + structured self-reflection","successCriteria":"Demonstrates each strand at Emerging; articulates two justified design/evaluation choices.","evidence":"Assessed task + reflection; results reported per strand."}}}};
}

