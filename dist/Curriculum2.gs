function curriculumChunk2_() {
  return {"grade6":{"g6-bridging-w3-lab":{"id":"g6-bridging-w3-lab","number":6,"week":3,"track":"bridging","type":"lab","title":"Trace-the-Data Investigation (Lab)","summary":"Students run three controlled single data swaps on the ripeness sorter, log the before-and-after outcomes, and use that evidence to identify and verify the most influential change.","duration":"45 minutes","strands":["CE"],"objectives":["Change the data in a worked solution and observe and record the effect on the outcome.","Identify which single data change most alters the outcome, and explain why."],"sections":[{"type":"text","body":["In the Core lesson you predicted how a data change would move the outcome. A prediction is only a guess until you test it. Today you run a fair test: change one thing, watch the outcome, and let the evidence tell you which data matters most."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run a controlled data change and record the outcome before and after.","I can compare data changes and identify which one moved the outcome the most.","I can explain, using my recorded evidence, why that change had the biggest effect."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"controlled change","definition":"Changing one thing at a time so you know what caused the result."},{"term":"before/after","definition":"The outcome measured just before and just after a single change."},{"term":"shift","definition":"How far the outcome moved because of a change."},{"term":"influential","definition":"Having a large effect on the outcome."},{"term":"verify","definition":"To re-test and confirm an effect is real, not a one-off."}],"role":"vocabulary"},{"type":"text","heading":"Change one thing at a time","body":["To find out how much a data batch matters, you must isolate it. Measure the outcome **before**, change only that one batch, and measure again. The difference is the influence of that batch.","If you change two batches at once and the outcome moves, you cannot tell which batch did it. A fair test changes one variable at a time - the same rule scientists use in any experiment."],"role":"explain"},{"type":"text","heading":"Evidence beats opinion","body":["Your log is your evidence. Without a written before-and-after, you are relying on memory, and memory blurs across many swaps.","Once you have run several swaps, the most [[influential]] batch is the one with the biggest [[shift]]. [[Verify]] it by re-running on a fresh fruit - if the effect repeats, you have proof, not a coincidence."],"role":"explain"},{"type":"activity","label":"Hands-on","heading":"Let's try it - hands-on","body":["Work in threes with roles: swapper, recorder, checker. You will run three single data swaps, log each outcome, and find the most influential change."],"items":["Write your Core prediction at the top of the log.","Record the BEFORE outcome for your test fruit.","Swap in one data batch and record the AFTER outcome.","Note the shift: none, a little, or a lot.","Repeat for two more single swaps.","Rank the swaps and star the most influential.","Verify the winner on a fresh fruit and write your conclusion."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Did the evidence match your prediction? Where did it surprise you?","Why might a small batch beat a large one for influence?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write your evidence-based conclusion about the most influential data change.","Note one thing a fair test taught you that a guess could not."],"role":"reflect"}],"worksheet":{"title":"Week 3 - Lab - Worksheet | Trace-the-Data Investigation (Lab)","questions":[{"id":"g6-bridging-w3-lab-aq1","type":"mcq","marks":2,"prompt":"A group swapped in the green-date batch AND the yellow-date batch at the same time. The sorter's answer changed from 'ripe' to 'unripe'. What should they write in their log?","options":[{"id":"a","text":"We cannot tell which batch moved the outcome, so we will redo the test changing one batch at a time."},{"id":"b","text":"Both batches are equally influential, because the outcome moved when we swapped them together."},{"id":"c","text":"The larger batch caused the change, because a bigger batch always has the bigger effect."},{"id":"d","text":"The test worked fine - swapping two batches at once saves time and gives us the same evidence."}],"answer":"a","frameworkRefs":[{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"}],"evidenceType":"product","feedback":{"correct":"Right - with two changes at once the result cannot be attributed to either batch, so the fair test has to be run again one batch at a time.","incorrect":"When two batches change together the shift could have come from either one, or from both; only a single controlled swap tells you which batch did it."}},{"id":"g6-bridging-w3-lab-aq2","type":"ordering","marks":4,"prompt":"Put the steps of one fair data-swap test into the order you should carry them out.","items":[{"id":"i1","text":"Swap in one data batch, and only that batch."},{"id":"i2","text":"Record the outcome for your test fruit before you change anything."},{"id":"i3","text":"Re-run the winning swap on a fresh fruit to check the effect repeats."},{"id":"i4","text":"Compare the two recorded outcomes and write down the size of the shift."},{"id":"i5","text":"Record the outcome for the same test fruit again."}],"answer":["i2","i1","i5","i4","i3"],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"}],"evidenceType":"product","feedback":{"correct":"Exactly - the 'before' has to be recorded first, or there is nothing to compare the 'after' with, and verifying comes last.","incorrect":"A fair test records the before outcome first, changes one batch, records the after outcome, measures the shift, and only then verifies the winner on a fresh fruit."}},{"id":"g6-bridging-w3-lab-aq3","type":"matching","marks":3,"prompt":"Three rows from an investigation log on a sorter trained mostly on brown ripe dates. Match each row to what the evidence in it shows.","left":[{"id":"L1","text":"Added 40 more brown ripe photos. Before: 'ripe'. After: 'ripe'."},{"id":"L2","text":"Added 40 green unripe photos. Before (green date): 'ripe'. After: 'unripe'."},{"id":"L3","text":"Kept the 40 green unripe photos and tested a second, fresh green date. Before: 'ripe'. After: 'unripe'."}],"right":[{"id":"R1","text":"No influence - the batch repeated a pattern the sorter already had plenty of, so nothing shifted."},{"id":"R2","text":"Influential - the batch filled a gap in the data and the outcome changed."},{"id":"R3","text":"Verified - the same change moved the outcome again on a fresh fruit, so the effect is real, not a one-off."}],"answer":{"L1":"R1","L2":"R2","L3":"R3"},"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"}],"evidenceType":"product","feedback":{"correct":"Well read - a row with no shift shows no influence, a row with a shift shows influence, and a repeat of that shift on a fresh fruit is verification.","incorrect":"Read each row's before and after: no movement means no influence, movement means influence, and the same movement repeating on a fresh fruit is what verifies it."}},{"id":"g6-bridging-w3-lab-aq4","type":"truefalse","marks":1,"prompt":"True or false: once a swap has moved the outcome one time, that single result is enough proof that the batch is the most influential one - there is no need to test it again.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"}],"evidenceType":"product","feedback":{"correct":"Correct - one result could be a coincidence, so you re-run the swap on a fresh fruit to verify the effect repeats.","incorrect":"It is false: a single moved outcome might be a one-off, so you verify by re-running the swap on a fresh fruit and checking the effect happens again."}},{"id":"g6-bridging-w3-lab-aq5","type":"multi","marks":3,"prompt":"Your log shows Swap A: no shift, Swap B: a big shift, Swap C: a little shift, and a re-run of Swap B on a fresh date that shifted the same way. Select ALL the conclusions your evidence actually supports.","options":[{"id":"a","text":"Of the three swaps we tested, Swap B was the most influential, because our log shows it produced the biggest before/after shift."},{"id":"b","text":"Swap B's effect is real and not a coincidence, because the re-run on a fresh date moved the outcome the same way."},{"id":"c","text":"Swap B is the most influential data change that exists for any sorter anywhere."},{"id":"d","text":"Swap A and Swap C can never change the outcome of any solution."},{"id":"e","text":"Swap B must be the winner because it is the one we predicted would win before we started."}],"answer":["a","b"],"frameworkRefs":[{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"}],"evidenceType":"product","feedback":{"correct":"Yes - your conclusions stay inside what you actually recorded: the biggest logged shift, confirmed by a repeat run.","incorrect":"A conclusion must not go further than the log: you tested three swaps on one sorter, and a prediction you made beforehand is not evidence - the recorded shifts are."}}]},"formative":{"targets":"Grade 4 Advanced: explains how data influences the outcome of a solution","check":"Investigation log showing before/after outcomes for several single data swaps, plus a ranked conclusion","successCriteria":"Records outcomes for controlled single swaps and identifies, with evidence, the most influential change.","evidence":"Completed investigation log + one-sentence evidence-based conclusion."}},"g6-bridging-w4-core":{"id":"g6-bridging-w4-core","number":7,"week":4,"track":"bridging","type":"core","title":"Misinformation Risks and Verification","summary":"Students learn why fluent AI text is not the same as true text, then name the exact claim at risk in a curated output and pair it with a concrete check against a trusted source.","duration":"45 minutes","strands":["GE"],"objectives":["Explain how an AI output could spread misinformation.","Propose at least one concrete verification strategy and explain why it helps."],"sections":[{"type":"text","heading":"Misinformation Risks and Verification","body":["An AI can write an answer that sounds completely sure and is completely wrong. It is built to sound right, not to be right. Today you learn to spot the exact risk in an output and pair it with a check that makes it trustworthy before you ever share it."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can explain a specific way an AI output could be wrong and spread misinformation.","I can propose a concrete verification step and say why it makes the claim more trustworthy.","I can move from 'it might be wrong' to naming the exact risk and the exact check."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"misinformation","definition":"False information that spreads, whether or not anyone meant to deceive."},{"term":"claim","definition":"A specific statement that could be true or false, like a number or a date."},{"term":"verify","definition":"To confirm a claim against a trusted, independent source."},{"term":"trusted source","definition":"A source kept accurate by people who check facts, like an official website."},{"term":"layered check","definition":"Verifying with more than one independent source for extra reliability."}],"role":"vocabulary"},{"type":"text","heading":"Why fluent is not the same as true","body":["An AI language system predicts the next likely word, over and over, to build fluent text. It is optimised to sound plausible, not to check facts, so it can state a wrong number as confidently as a right one.","That is what makes AI output a [[misinformation]] risk. The output gives no signal for which parts are reliable, so a made-up statistic can look exactly like a real one and spread when people repeat it."],"role":"explain"},{"authored":true,"type":"diagram","variant":"flow","label":"Why a wrong answer can sound right","heading":"Fluent and true are decided separately","altText":"A chain: the model predicts what usually comes next, which makes the answer read smoothly, which is why it sounds right whether or not it is true.","nodes":[{"label":"It predicts what usually comes next","detail":"from the examples it saw"},{"label":"So the answer reads smoothly","detail":"well-formed sentences"},{"label":"So it sounds right","detail":"whether or not it is","accent":true}],"edges":[{"label":"which makes it"},{"label":"which makes it"}],"caption":"Nothing in that chain checks a fact. **Sounding right is produced by the same process whether the answer is true or false**, so it can never be your evidence.","role":"diagram"},{"type":"text","heading":"Name the risk, then check it","body":["Good evaluation is specific. Instead of 'this might be wrong', say exactly what is at risk: the number, the name, the date, or the source.","Then pair that risk with a concrete check against a [[trusted source]] that is independent of the AI. If you can, layer two sources - one source can be wrong too."],"role":"explain"},{"type":"activity","label":"Hands-on","heading":"Let's try it - hands-on","body":["You will study three curated AI outputs. For each, name the exact risk and propose a concrete check. Your teacher will verify one live against a trusted source."],"items":["Read each output and underline the exact claim you doubt.","Name the risk type: number, date, name, or source.","Choose a trusted source that could settle it.","Write the check and why it helps.","Watch one live verification and record the verdict."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which output was the hardest to spot a risk in, and why?","Why is verifying before sharing part of using AI responsibly?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the strongest risk-and-verify pair you made today.","Note one habit you will use before sharing any AI answer."],"role":"reflect"}],"worksheet":{"title":"Misinformation Risks and Verification","questions":[{"id":"g6-bridging-w4-core-aq1","type":"mcq","marks":2,"prompt":"An AI answer reads: \"The festival opened in 2007 and drew 41,000 visitors on its first day.\" Your group has to name the misinformation risk. Which statement names the risk in the way this lesson asks for?","options":[{"id":"a","text":"The answer is probably wrong somewhere, because AI is not always right."},{"id":"b","text":"The date 2007 and the figure 41,000 could be invented, because the system predicts words that sound likely instead of looking facts up."},{"id":"c","text":"The answer is written with no hedging, so the facts inside it are most likely correct."},{"id":"d","text":"There is no risk to name, because the sentence is clear and easy to read."}],"answer":"b","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"Pointing at the exact date and number tells you precisely what to check, which \"it might be wrong\" never does.","incorrect":"Name the exact claim you doubt - the number, date, name or source - because a general worry gives you nothing to verify."}},{"id":"g6-bridging-w4-core-aq2","type":"matching","marks":4,"prompt":"Match each doubtful claim from an AI output to the check that would actually settle it.","left":[{"id":"l1","text":"\"The city's population passed four million last year.\""},{"id":"l2","text":"\"This poem was written by the poet Al Khansa.\""},{"id":"l3","text":"\"The museum stays open until 8pm on Fridays.\""},{"id":"l4","text":"\"A 2021 study found that pupils who sleep more score higher.\""}],"right":[{"id":"r1","text":"Look the figure up in the official population statistics published for that year."},{"id":"r2","text":"Search a library catalogue for the poem's title and see who it is credited to."},{"id":"r3","text":"Read the opening-hours page on the museum's own website."},{"id":"r4","text":"Find the study itself and read whether it exists and says that."},{"id":"r5","text":"Ask the AI whether it is sure, and accept the claim if it repeats it."},{"id":"r6","text":"Ask a friend whether the claim sounds about right to them."}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"A check only works if it targets the exact claim and comes from a source that is independent of the AI.","incorrect":"Match the claim to the source that holds that kind of fact - and remember the AI repeating itself, or a friend's hunch, is not a trusted source."}},{"id":"g6-bridging-w4-core-aq3","type":"truefalse","marks":1,"prompt":"An AI answer that is fluent and sounds confident is good evidence that the facts inside it are correct.","answer":false,"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"Exactly - the system is built to sound plausible, so an invented number reads exactly like a real one.","incorrect":"Fluency is about how the words are chosen, not whether they are true; confident writing can still carry a made-up figure."}},{"id":"g6-bridging-w4-core-aq4","type":"multi","marks":3,"prompt":"Sara has checked an AI claim about a record-breaking building against one official website. She is deciding whether to add a second, independent trusted source. Which of these are good reasons to add one? Select all that apply.","options":[{"id":"a","text":"One source can be out of date, and a second source would reveal that."},{"id":"b","text":"Two sources that do not copy each other are unlikely to carry the same mistake."},{"id":"c","text":"Asking the AI again and getting the same answer counts as a second source."},{"id":"d","text":"A second source makes the claim certain, so no doubt is left at all."},{"id":"e","text":"A check that takes longer is automatically a better check."}],"answer":["a","b"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"Layering helps because the second source can fail separately from the first - that is what independence means.","incorrect":"A second source earns its place only by being independent; repeating the AI, or simply taking longer, adds no new evidence, and even two sources raise confidence rather than give certainty."}},{"id":"g6-bridging-w4-core-aq5","type":"fillBlank","marks":2,"prompt":"Complete the rule this lesson gives: an AI system is built to sound ___ rather than to be ___, so before you share a claim you should check it against a trusted source that is ___ of the AI.","blanks":["what it sounds like","what it is not","what the source must be"],"answer":[["plausible","likely","believable","convincing","right","true","correct","accurate","factual"],["true","correct","accurate","factual","right"],["independent","separate","free"]],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"That is the whole habit in one sentence: plausible is not true, so verify against something the AI did not produce.","incorrect":"The system aims at plausible rather than true, which is why the check has to come from a source independent of the AI."}}]},"formative":{"targets":"Grade 5 Advanced: explains misinformation risks and proposes verification strategies","check":"Risk-and-verify card: name the misinformation risk + a verification step","successCriteria":"Explains a plausible misinformation risk and proposes a workable verification strategy with a reason.","evidence":"Risk-and-verify card."}},"g6-bridging-w4-lab":{"id":"g6-bridging-w4-lab","number":8,"week":4,"track":"bridging","type":"lab","title":"Verify and De-risk Workshop (Lab)","summary":"Groups apply a fixed four-step verification routine to a batch of suspect outputs, record an evidence-backed verdict for each, then compare single-source and two-source checking to judge which is more reliable.","duration":"45 minutes","strands":["GE"],"objectives":["Apply a verification routine to a set of suspect outputs and record the verdict for each.","Compare two verification strategies and judge which is more reliable."],"sections":[{"type":"text","heading":"Verify and De-risk Workshop (Lab)","body":["One suspect output is easy to check. Ten is where you need a system. Today you run a verification routine on a whole batch, reach an evidence-backed verdict on each, and then judge which checking strategy you would actually trust."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run a verification routine on several suspect outputs and record a clear verdict for each.","I can compare two verification strategies and judge which is more reliable, with a reason.","I can back my verdicts with evidence from a trusted source."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"routine","definition":"A fixed set of steps applied the same way to every output."},{"term":"verdict","definition":"Your conclusion on a claim: verified, false, or unclear."},{"term":"evidence","definition":"The trusted-source information that backs your verdict."},{"term":"independent sources","definition":"Sources that do not copy each other, so they are unlikely to share the same error."},{"term":"reliable","definition":"A method you can trust to give the right result repeatedly."}],"role":"vocabulary"},{"type":"text","heading":"A routine keeps you fair","body":["When you check many outputs, it is tempting to judge each one by how confident it sounds. A verification [[routine]] stops that: the same fixed steps apply to every output, so a slick output gets no easy pass.","Our routine has four steps - isolate the claim, pick an independent trusted source, compare, and record a verdict. The [[verdict]] can be verified, false, or unclear, and 'unclear' is an honest answer when the evidence is not there."],"role":"explain"},{"type":"text","heading":"Not all checks are equally reliable","body":["A single-source check is quick, but if that one source is wrong or out of date, your verdict is wrong too. A two-source cross-check is slower but far harder to fool, because two [[independent sources]] rarely share the same mistake.","Judging which strategy is more [[reliable]] means weighing speed against confidence and asking a sharp question: could these sources fail together? The more independent they are, the more you can trust their agreement."],"role":"explain"},{"type":"activity","label":"Hands-on","heading":"Let's try it - hands-on","body":["Work in groups with roles: claim-isolator, source-checker, verdict-recorder, reporter. Run the routine on the whole batch, then compare two strategies on a tricky output."],"items":["Copy the four routine steps onto your sheet.","For each output, isolate the claim and pick a trusted source.","Compare and record a verdict with its evidence.","Choose one tricky output and check it single-source, then two-source.","Judge which strategy is more reliable and why.","For one false output, write the harm and the check that de-risks it."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which verdict was hardest to reach, and what made it hard?","When is the slower two-source check worth the extra time?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["State which verification strategy you would use and the trade-off you accept.","Note one responsible-use habit this workshop reinforced."],"role":"reflect"}],"worksheet":{"title":"Verify and De-risk Workshop (Lab)","questions":[{"id":"g6-bridging-w4-lab-aq1","type":"ordering","marks":4,"prompt":"Your group is handed a new suspect output. Put the four steps of the verification routine in the order the lesson uses.","items":[{"id":"s1","text":"Isolate the exact claim the output is making."},{"id":"s2","text":"Pick a trusted source that is independent of the AI."},{"id":"s3","text":"Compare the claim with what that source says."},{"id":"s4","text":"Record the verdict: verified, false or unclear."}],"answer":["s1","s2","s3","s4"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"Running the same fixed steps on every output is what stops a slick answer getting an easy pass.","incorrect":"The routine gathers evidence before it judges: isolate the claim, choose an independent source, compare, and only then record the verdict."}},{"id":"g6-bridging-w4-lab-aq2","type":"matching","marks":4,"prompt":"Your group has run the routine on four outputs. Match what the source-checker found to the verdict the recorder should write.","left":[{"id":"l1","text":"The official site gives the same tower height as the output."},{"id":"l2","text":"The official site gives a different opening date from the output."},{"id":"l3","text":"No trusted source on the reference sheet mentions the claim at all."},{"id":"l4","text":"Two sites agree, but the second says its figures were taken from the first."}],"right":[{"id":"r1","text":"Verified - an independent trusted source agrees with the claim."},{"id":"r2","text":"False - a trusted source contradicts the claim."},{"id":"r3","text":"Unclear - no source covers it, so there is no evidence either way."},{"id":"r4","text":"Count it as one source - they are not independent, so they could share the same error."},{"id":"r5","text":"Verified - the output sounded confident and nothing has contradicted it."}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"Every verdict is tied to what the evidence showed - including the honest 'unclear' and the copied source that only looks like two.","incorrect":"A verdict reports what the trusted source showed: agreement, contradiction, no evidence at all, or sources that copy each other and therefore count as one."}},{"id":"g6-bridging-w4-lab-aq3","type":"mcq","marks":2,"prompt":"Your group checks the claim \"the festival first ran in 1998\". None of the trusted sources on the reference sheet mention the festival's first year. What should the verdict-recorder write, and why?","options":[{"id":"a","text":"Verified - nothing contradicted the claim, so it stands."},{"id":"b","text":"False - if a trusted source does not mention it, the claim must be made up."},{"id":"c","text":"Unclear - no trusted source covers this claim, so there is no evidence either way."},{"id":"d","text":"Verified - the output gave the year with no hesitation, and confident claims are usually right."}],"answer":"c","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"'Unclear' is an honest verdict: it records that the evidence is missing instead of inventing a judgement.","incorrect":"Missing evidence is not proof that a claim is false, and it is not permission to pass it either - the routine lets you record 'unclear'."}},{"id":"g6-bridging-w4-lab-aq4","type":"multi","marks":3,"prompt":"Your group has ten outputs and limited time, so you will only cross-check some of them with a second source. Which of these are sound reasons for spending the extra time on a particular output? Select all that apply.","options":[{"id":"a","text":"Getting this claim wrong would matter to the people who read it, so confidence is worth more than speed here."},{"id":"b","text":"The one source you used could be out of date, so a single check might miss an error."},{"id":"c","text":"The output sounds confident and polished, so it needs less checking than the others."},{"id":"d","text":"The second source you would add is run by the same organisation as the first."},{"id":"e","text":"Your group has spare time, and spare time is what makes a check reliable."}],"answer":["a","b"],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"You spend the extra time where a wrong verdict would cost most, or where one source could quietly be wrong.","incorrect":"Choose by what is at stake and by how the first source could fail - not by how confident the output sounds, and not by adding a source that would fail alongside the first."}},{"id":"g6-bridging-w4-lab-aq5","type":"fillBlank","marks":2,"prompt":"Complete the trade-off from the lab: a single-source check is ___, but your verdict is wrong if that one source is wrong; a two-source cross-check is ___, yet much harder to fool because the two sources are ___ of each other.","blanks":["a single-source check is ___","a two-source cross-check is ___","the two sources are ___ of each other"],"answer":[["quick","quicker","fast","faster"],["slower","slow","longer"],["independent","separate"]],"frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","feedback":{"correct":"That is the judgement in one line: you trade speed for confidence, and the confidence comes from independence.","incorrect":"The cross-check costs time and buys reliability - two sources that do not copy each other rarely make the same mistake."}}]},"formative":{"targets":"Grade 5 Advanced: explains misinformation risks and proposes verification strategies","check":"Completed verification workshop sheet with verdicts and evidence for a batch, plus a reasoned comparison of two strategies","successCriteria":"Applies the routine to reach evidence-based verdicts and judges which verification strategy is more reliable with a reason.","evidence":"Workshop sheet with per-output verdicts + strategy comparison and judgement."}},"g6-bridging-w5-core":{"id":"g6-bridging-w5-core","number":9,"week":5,"track":"bridging","type":"core","title":"Trustworthy AI Helper - Design & Test the Data (Part 1 Core)","summary":"Students design a small AI helper from three parts - a task, a structured prompt and data - then run a clean-versus-noisy data test and explain how data quality changed the output.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Design a small prompt-driven AI helper: state the task, the structured prompt, and the data it will use.","Test how the quality of the data changes the helper's output, and explain the effect."],"sections":[{"type":"text","body":["Over four lessons (two weeks, Core and Lab) you will build a **Trustworthy AI Helper** and prove it can be trusted.","Today you design it and test how the data quality changes its output."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can design a helper with a clear task, a structured prompt, and a data set.","I can test how data quality changes the output and explain why."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Helper","definition":"A small AI solution that completes a task using a prompt and data."},{"term":"Structured prompt","definition":"A precise instruction: goal, details, and the form of the answer."},{"term":"Data quality","definition":"How accurate, balanced, and complete the data is."}],"role":"vocabulary"},{"type":"text","heading":"A helper has three parts","body":["A [[helper]] is a small solution: a task, a structured prompt, and data.","Its output comes from the data and the prompt, so if the data is poor, the output is poor - even with a good prompt."],"role":"explain"},{"authored":true,"type":"diagram","variant":"parts","label":"The three parts you are designing","heading":"A helper has three parts","whole":"Your trustworthy AI helper","altText":"A bar split into three parts — the data it uses, the prompt that drives it, and the checks that catch mistakes — which together make a helper you can trust.","parts":[{"label":"Its data","detail":"what it draws on"},{"label":"Its prompt","detail":"what you ask it to do"},{"label":"Its checks","detail":"how you catch mistakes","accent":true}],"result":"A helper you can defend","caption":"All three are yours to design. **A helper with no checks is not finished** — it is a helper you are hoping about.","role":"diagram"},{"type":"text","heading":"Test the data quality","body":["Feed your helper clean data, then noisy data, and compare the outputs.","This shows how much the [[data quality]] matters. Poorer data usually gives a poorer, less fair output."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Design your helper, then test clean vs noisy data."],"items":["Write the task.","Write a structured prompt.","Prepare the data.","Run on clean data; note the output.","Run on noisy data; note the output.","Explain the difference."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Why is a good prompt not enough on its own?","How did the noisy data change your output?","What will you build in the Lab?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My helper's task is ...","Data quality mattered because ...","In the Lab I will build ..."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Core - Worksheet | Trustworthy AI Helper - Design & Test the Data (Part 1 Core)","instructions":"Name: __________________________________  Class: ________________  Date: ________________","questions":[{"id":"g6-bridging-w5-core-aq1","type":"mcq","marks":2,"prompt":"Layla's helper has one task: recommend a library book for her class. She has the class reading survey as her data. Which of these is the best structured prompt for that task?","options":[{"id":"a","text":"Suggest a good book."},{"id":"b","text":"Using our class reading survey, suggest one book most of the class would enjoy, and give one sentence saying why."},{"id":"c","text":"Using our class reading survey, suggest some books people might like."},{"id":"d","text":"Suggest one book and write as much as you possibly can about it, in as much detail as you can manage."}],"answer":"b","feedback":{"correct":"That prompt gives the goal, the details (which data to use) and the form of the answer, so the helper knows exactly what to produce.","incorrect":"A structured prompt needs all three: the goal, the details such as which data to use, and the form the answer should take - being longer or politer is not the same as being structured."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-core-aq2","type":"matching","marks":4,"prompt":"Layla's finished helper is described below. Match each part of her description to the part of the helper it is.","left":[{"id":"l1","text":"Recommend one library book that most of the class would enjoy"},{"id":"l2","text":"The 28 completed class reading surveys"},{"id":"l3","text":"Using the class reading survey, name one book and give one sentence saying why"},{"id":"l4","text":"'The Lost Ship' - because 19 pupils chose adventure stories"}],"right":[{"id":"r1","text":"The task"},{"id":"r2","text":"The data"},{"id":"r3","text":"The structured prompt"},{"id":"r4","text":"The output"}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"feedback":{"correct":"A helper is a task, a structured prompt and data - and what comes back out of it is the output, not one of its parts.","incorrect":"The task is the job to be done, the data is what the helper reads, the structured prompt is the instruction you write, and the output is what the helper gives back."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-core-aq3","type":"truefalse","marks":1,"prompt":"Sami's survey data has several entries typed in twice and a few answers copied into the wrong column. He rewrites his prompt so it is very precise. True or false: the precise prompt will make up for the messy data, so the output can be trusted.","answer":false,"feedback":{"correct":"Right - the output is built from the data as well as the prompt, so poor data still gives a poor output however precise the wording is.","incorrect":"A prompt only tells the helper what to do with the data it is given; if the data is wrong, a better-worded instruction cannot invent the right answer."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-core-aq4","type":"ordering","marks":4,"prompt":"Put the steps of a clean-versus-noisy data test in the order you would carry them out.","items":[{"id":"s1","text":"Write the task your helper must do."},{"id":"s2","text":"Write the structured prompt and prepare the clean data."},{"id":"s3","text":"Run the helper on the clean data and note the output."},{"id":"s4","text":"Run the same prompt on the noisy version of the data and note the output."},{"id":"s5","text":"Compare the two outputs and explain how the data quality caused the difference."}],"answer":["s1","s2","s3","s4","s5"],"feedback":{"correct":"Keeping the prompt the same and changing only the data is what makes the difference in the outputs fair to blame on data quality.","incorrect":"Design first, then run the clean data, then run the very same prompt on the noisy data - only then can you compare and explain the difference."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-core-aq5","type":"numeric","marks":2,"tolerance":0,"prompt":"Kareem's helper recommends whichever genre the most survey responses chose. His clean survey has 20 responses: 11 chose adventure and 9 chose sport. By mistake, some of the sport responses are copied and counted again. What is the smallest number of copied sport responses that would make the helper recommend sport instead of adventure?","answer":3,"feedback":{"correct":"Three copies take sport from 9 to 12, just past adventure's 11 - a handful of duplicated rows is enough to flip the recommendation.","incorrect":"Sport needs more than adventure's 11, and two copies only make it 11, which is a tie - so it takes three copies to overturn the real result."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"}]},"formative":{"targets":"Integrated mastery - CU (data quality affects outputs) and SD (design a promptdriven solution)","check":"Helper design planner + clean-vs-noisy data test reviewed against the mastery criteria","successCriteria":"Designs a helper with a clear task, structured prompt and data, and explains how data quality changed the output.","evidence":"Completed helper planner (Trustworthy AI Helper Log, Part 1)."}},"g6-bridging-w5-lab":{"id":"g6-bridging-w5-lab","number":10,"week":5,"track":"bridging","type":"lab","title":"Trustworthy AI Helper - Build & Refine the Prompt (Part 1 Lab)","summary":"Students turn their Week 5 Core design into a working prototype and improve it by changing one part of the prompt at a time, logging each version, change and effect.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Build a working prototype of the helper using the structured prompt and improved data.","Refine the prompt across versions to raise output quality, logging each change and its effect."],"sections":[{"type":"text","body":["Now build it! Today you turn your design into a working helper and make it better by refining the prompt, one change at a time."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can build a working prototype of my helper.","I can refine the prompt across versions and explain what improved."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Prototype","definition":"A first working version you can test and improve."},{"term":"Iterate","definition":"To improve something step by step, testing each change."},{"term":"Version","definition":"One attempt at your prompt that you can compare with the next."}],"role":"vocabulary"},{"type":"text","heading":"Build, run, refine","body":["Run your prompt on the improved data and read the output.","Judge it against your task. Then change one part of the prompt and run it again.","Changing one thing at a time tells you what actually helped."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build your prototype and refine the prompt across versions."],"items":["Run prompt v1 on your data.","Judge it against your task.","Change one part; run again.","Log the change and its effect.","Repeat until it meets the task.","Record your best version."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which change improved your output the most?","Why refine one change at a time?","Is your best prompt precise or just long?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My best prompt version is ...","The change that helped most was ... because ...","Next I will check ..."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Lab - Worksheet | Trustworthy AI Helper - Build & Refine the Prompt (Part 1 Lab)","instructions":"Name: __________________________________  Class: ________________  Date: ________________","questions":[{"id":"g6-bridging-w5-lab-aq1","type":"mcq","marks":2,"prompt":"Sam's prompt v1 is 'Suggest a book.' The output was a vague list. He wants his v2 to show him what actually helped. Which v2 is the best next step?","options":[{"id":"a","text":"Using our class reading survey, suggest a book."},{"id":"b","text":"Using our class reading survey, suggest one book, give one sentence saying why, and keep it friendly."},{"id":"c","text":"Please could you kindly suggest a book for us? Thank you very much!"},{"id":"d","text":"Suggest a film instead."}],"answer":"a","feedback":{"correct":"Only one part of the prompt changed, so any improvement in the output can be pinned on naming the data.","incorrect":"Changing several parts at once hides which one helped, extra politeness adds words but no precision, and changing the task means you are no longer testing the same helper."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-lab-aq2","type":"matching","marks":4,"prompt":"Match each change Sam made to his prompt with the effect you would expect it to have on the output.","left":[{"id":"l1","text":"Added 'using our class reading survey'"},{"id":"l2","text":"Added 'name one book, not a list'"},{"id":"l3","text":"Added 'give one sentence saying why'"},{"id":"l4","text":"Added 'please be as helpful and friendly as you can'"}],"right":[{"id":"r1","text":"The answer is now based on the class's own data instead of a general guess."},{"id":"r2","text":"The answer is a single choice instead of several."},{"id":"r3","text":"The answer now explains the reason behind the choice."},{"id":"r4","text":"The prompt got longer, but the answer is no more useful."}],"answer":{"l1":"r1","l2":"r2","l3":"r3","l4":"r4"},"feedback":{"correct":"Each useful change targets one thing - the data, the number of answers, or the reasoning - while extra friendly words only make the prompt longer.","incorrect":"Ask what each change tells the helper to do differently; a change that adds no new instruction changes the length of the prompt, not the quality of the output."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-lab-aq3","type":"multi","marks":3,"prompt":"Maya claims her v3 is better than her v2, and that her change is what made it better. Which of these count as good evidence for her claim? Select all that apply.","options":[{"id":"a","text":"v3's output names one book, which is what her task asked for."},{"id":"b","text":"v3's prompt has more words in it than v2's."},{"id":"c","text":"v3's output gives a reason, so Maya can judge whether the choice makes sense."},{"id":"d","text":"Only one part of the prompt changed between v2 and v3, so Maya knows what caused the change."},{"id":"e","text":"v3's prompt sounds more polite than v2's."}],"answer":["a","c","d"],"feedback":{"correct":"Better means the output meets the task and can be judged, and a single change is what lets Maya say which edit caused it.","incorrect":"A longer or politer prompt is not evidence of a better output - the evidence is that the output now meets the task, can be judged, and followed one change you can point to."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-lab-aq4","type":"truefalse","marks":1,"prompt":"Omar changes three parts of his prompt at the same time and the output gets much better. True or false: he can still say which of the three changes caused the improvement.","answer":false,"feedback":{"correct":"Right - with three edits made together any of them, or all of them, could be responsible, so he would have to test them one at a time.","incorrect":"A better output only tells you the new prompt as a whole works better; to name the change that helped, you have to change one part at a time."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"},{"id":"g6-bridging-w5-lab-aq5","type":"fillBlank","marks":2,"prompt":"Sam's log: v2 'Using our class reading survey, suggest a book' returned a list with no explanation. v3 'Using our class reading survey, suggest one book and give one sentence saying why' returned a single title with a reason. Complete the explanation: the change from v2 to v3 improved the output because it told the helper to name ___ book and to give a ___.","blanks":["how many books","what else it must give"],"answer":[["one","1","a single","just one","only one","a single book","one book"],["reason","a reason","reason why","justification","an explanation","explanation","sentence","one sentence","a sentence","sentence saying why","why"]],"feedback":{"correct":"Naming how many answers and asking for the thinking behind them is what turned a vague list into something the class can judge.","incorrect":"Compare the two prompts word by word: v3 asks for one book rather than several, and asks the helper to say why it chose it."},"frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product"}]},"formative":{"targets":"Integrated mastery - SD (refine prompts to improve output quality and explain why)","check":"Prompt-refinement log (v1 to best) with a reasoned justification for the key change","successCriteria":"Iterates the prompt to a measurably better output and explains the causal reason for the improvement.","evidence":"Prompt-refinement log (Trustworthy AI Helper Log, Part 1 Lab)."}}}};
}

