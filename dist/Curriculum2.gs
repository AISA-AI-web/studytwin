function curriculumChunk2_() {
  return {"grade6":{"g6-bridging-w4-lab":{"id":"g6-bridging-w4-lab","number":8,"week":4,"track":"bridging","type":"lab","title":"Verify and De-risk Workshop (Lab)","summary":"Groups apply a fixed four-step verification routine to a batch of suspect outputs, record an evidence-backed verdict for each, then compare single-source and two-source checking to judge which is more reliable.","duration":"45 minutes","strands":["GE"],"objectives":["Apply a verification routine to a set of suspect outputs and record the verdict for each.","Compare two verification strategies and judge which is more reliable."],"sections":[{"type":"text","heading":"Verify and De-risk Workshop (Lab)","body":["One suspect output is easy to check. Ten is where you need a system. Today you run a verification routine on a whole batch, reach an evidence-backed verdict on each, and then judge which checking strategy you would actually trust."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run a verification routine on several suspect outputs and record a clear verdict for each.","I can compare two verification strategies and judge which is more reliable, with a reason.","I can back my verdicts with evidence from a trusted source."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"routine","definition":"A fixed set of steps applied the same way to every output."},{"term":"verdict","definition":"Your conclusion on a claim: verified, false, or unclear."},{"term":"evidence","definition":"The trusted-source information that backs your verdict."},{"term":"independent sources","definition":"Sources that do not copy each other, so they are unlikely to share the same error."},{"term":"reliable","definition":"A method you can trust to give the right result repeatedly."}],"role":"vocabulary"},{"type":"text","heading":"A routine keeps you fair","body":["When you check many outputs, it is tempting to judge each one by how confident it sounds. A verification [[routine]] stops that: the same fixed steps apply to every output, so a slick output gets no easy pass.","Our routine has four steps - isolate the claim, pick an independent trusted source, compare, and record a verdict. The [[verdict]] can be verified, false, or unclear, and 'unclear' is an honest answer when the evidence is not there."],"role":"explain"},{"type":"text","heading":"Not all checks are equally reliable","body":["A single-source check is quick, but if that one source is wrong or out of date, your verdict is wrong too. A two-source cross-check is slower but far harder to fool, because two [[independent sources]] rarely share the same mistake.","Judging which strategy is more [[reliable]] means weighing speed against confidence and asking a sharp question: could these sources fail together? The more independent they are, the more you can trust their agreement."],"role":"explain"},{"type":"activity","label":"Hands-on","heading":"Let's try it - hands-on","body":["Work in groups with roles: claim-isolator, source-checker, verdict-recorder, reporter. Run the routine on the whole batch, then compare two strategies on a tricky output."],"items":["Copy the four routine steps onto your sheet.","For each output, isolate the claim and pick a trusted source.","Compare and record a verdict with its evidence.","Choose one tricky output and check it single-source, then two-source.","Judge which strategy is more reliable and why.","For one false output, write the harm and the check that de-risks it."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which verdict was hardest to reach, and what made it hard?","When is the slower two-source check worth the extra time?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["State which verification strategy you would use and the trade-off you accept.","Note one responsible-use habit this workshop reinforced."],"role":"reflect"}],"worksheet":{"title":"Verify and De-risk Workshop (Lab)","questions":[{"id":"g6-bridging-w4-lab-q1","type":"shortText","autoMarked":false,"prompt":"Apply the four-step routine to each suspect output. Record a verdict and the trusted-source evidence for each.","stem":"The claim is ___\nMy verdict is ___\nEvidence: ___","lookFor":"Every verdict must cite the trusted source, not a feeling. Model: 'Verdict: false. The output said the tower was 900 metres; the official source lists a different height, so the claim does not match a trusted source.' Accept 'unclear' as a valid, honest verdict when no source on the reference sheet covers the claim.","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}]},{"id":"g6-bridging-w4-lab-q2","type":"shortText","autoMarked":false,"prompt":"Verify one tricky output single-source, then two-source. Judge which is more reliable and explain using source independence.","stem":"Single-source result: ___\nTwo-source result: ___\nThe more reliable strategy is ___ because ___","lookFor":"Model: single-source was faster but the one source was out of date; the two-source cross-check caught the error, so it is more reliable. Look for reasoning about source independence and the speed-versus-confidence trade-off, not just which was quicker. Agreement raises confidence but is not proof if the sources could fail together.","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}]},{"id":"g6-bridging-w4-lab-q3","type":"shortText","autoMarked":false,"prompt":"Log every suspect output, your verdict, the evidence, and the strategy used.","stem":"Columns: Output | Claim checked | Verdict | Evidence (trusted source) | Strategy used","lookFor":"Mastery: a verdict for each output, each backed by cited trusted-source evidence and a named strategy. Partial: verdicts for most outputs but some lack cited evidence. Not yet: verdicts are guesses with no trusted-source evidence.","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}]},{"id":"g6-bridging-w4-lab-q4","type":"shortText","autoMarked":false,"prompt":"Give a verdict on one output with its evidence, and judge which verification strategy is more reliable and why.","lookFor":"Applies the routine to reach an evidence-based verdict and judges which verification strategy is more reliable with a reason. Reward evidence-backed verdicts; push students who prefer speed to weigh reliability and source independence.","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}]},{"id":"g6-bridging-w4-lab-q5","type":"shortText","autoMarked":false,"prompt":"Design a three-layer verification for a high-stakes claim about a UAE record, and explain when the extra effort is worth it and when it is not.","lookFor":"Stretch target from the pack: designs a three-layer verification for a high-stakes claim and justifies when the extra effort is worth it and when it is not, reasoning about how independent the three sources really are.","frameworkRefs":[{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}]}]}},"g6-bridging-w5-core":{"id":"g6-bridging-w5-core","number":9,"week":5,"track":"bridging","type":"core","title":"Trustworthy AI Helper - Design & Test the Data (Part 1 Core)","summary":"Students design a small AI helper from three parts - a task, a structured prompt and data - then run a clean-versus-noisy data test and explain how data quality changed the output.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Design a small prompt-driven AI helper: state the task, the structured prompt, and the data it will use.","Test how the quality of the data changes the helper's output, and explain the effect."],"sections":[{"type":"text","body":["Over four lessons (two weeks, Core and Lab) you will build a **Trustworthy AI Helper** and prove it can be trusted.","Today you design it and test how the data quality changes its output."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can design a helper with a clear task, a structured prompt, and a data set.","I can test how data quality changes the output and explain why."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Helper","definition":"A small AI solution that completes a task using a prompt and data."},{"term":"Structured prompt","definition":"A precise instruction: goal, details, and the form of the answer."},{"term":"Data quality","definition":"How accurate, balanced, and complete the data is."}],"role":"vocabulary"},{"type":"text","heading":"A helper has three parts","body":["A [[helper]] is a small solution: a task, a structured prompt, and data.","Its output comes from the data and the prompt, so if the data is poor, the output is poor - even with a good prompt."],"role":"explain"},{"type":"text","heading":"Test the data quality","body":["Feed your helper clean data, then noisy data, and compare the outputs.","This shows how much the [[data quality]] matters. Poorer data usually gives a poorer, less fair output."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Design your helper, then test clean vs noisy data."],"items":["Write the task.","Write a structured prompt.","Prepare the data.","Run on clean data; note the output.","Run on noisy data; note the output.","Explain the difference."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Why is a good prompt not enough on its own?","How did the noisy data change your output?","What will you build in the Lab?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My helper's task is ...","Data quality mattered because ...","In the Lab I will build ..."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Core - Worksheet | Trustworthy AI Helper - Design & Test the Data (Part 1 Core)","instructions":"Name: __________________________________  Class: ________________  Date: ________________","questions":[{"id":"g6-bridging-w5-core-q1","type":"shortText","stem":"Task: ...\nStructured prompt (goal | details | form): ...\nData: ...","autoMarked":false,"lookFor":"All three parts present and clear: a single clear task (e.g. 'recommend one library book'), a structured prompt that names the goal, the details and the form of the answer (e.g. 'Using the class survey, suggest one book most pupils would enjoy, in one sentence with a reason'), and named data (e.g. the balanced reading survey). Accept any clear task + structured prompt + named data. Mastery = clear task, structured prompt and named data; partial = two of three, or one unclear.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Write the task, a structured prompt, and the data."},{"id":"g6-bridging-w5-core-q2","type":"shortText","stem":"Clean-data output: ...\nNoisy-data output: ...\nThe difference is because ...","autoMarked":false,"lookFor":"A genuine clean-vs-noisy comparison with a stated data-quality-to-output effect, e.g. 'on clean data it suggested a popular adventure book; on noisy data (a duplicated entry) it over-suggested one title - poorer data gave a less fair output'. Look for the causal link back to the data, not just two different outputs. Watch for the misconception that a good prompt fixes bad data.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Record the output on clean data and on noisy data, and explain the difference."},{"id":"g6-bridging-w5-core-q3","type":"shortText","stem":"Columns: Helper part | My design | Data-quality finding","autoMarked":false,"lookFor":"A completed log covering each helper part (task, structured prompt, data) with a matching data-quality finding. This is the evidence for the formative check: designs a helper with a clear task, structured prompt and data, and explains how data quality changed the output. Record CU and SD as mastery/partial/not-yet.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Record your design and your data-quality test."},{"id":"g6-bridging-w5-core-q4","type":"shortText","autoMarked":false,"lookFor":"One sentence saying the output is produced from the data and the prompt, so poor data gives a poor output even when the prompt is good - the helper does not 'know' the answer. Reject answers implying a strong prompt can fix bad data.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Write one sentence: why does your helper need good data as well as a good prompt?"},{"id":"g6-bridging-w5-core-q5","type":"shortText","autoMarked":false,"lookFor":"A reasoned threshold (a proportion or a number of bad entries) tied to the helper's own data and task, with reasoning about when the pattern the helper relies on would be swamped or skewed - e.g. one duplicated entry in a small survey already tips the recommendation. Reasoning matters more than the number.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Predict how much noise your data can take before the output becomes untrustworthy, and explain your reasoning."}]}},"g6-bridging-w5-lab":{"id":"g6-bridging-w5-lab","number":10,"week":5,"track":"bridging","type":"lab","title":"Trustworthy AI Helper - Build & Refine the Prompt (Part 1 Lab)","summary":"Students turn their Week 5 Core design into a working prototype and improve it by changing one part of the prompt at a time, logging each version, change and effect.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Build a working prototype of the helper using the structured prompt and improved data.","Refine the prompt across versions to raise output quality, logging each change and its effect."],"sections":[{"type":"text","body":["Now build it! Today you turn your design into a working helper and make it better by refining the prompt, one change at a time."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can build a working prototype of my helper.","I can refine the prompt across versions and explain what improved."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Prototype","definition":"A first working version you can test and improve."},{"term":"Iterate","definition":"To improve something step by step, testing each change."},{"term":"Version","definition":"One attempt at your prompt that you can compare with the next."}],"role":"vocabulary"},{"type":"text","heading":"Build, run, refine","body":["Run your prompt on the improved data and read the output.","Judge it against your task. Then change one part of the prompt and run it again.","Changing one thing at a time tells you what actually helped."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Build your prototype and refine the prompt across versions."],"items":["Run prompt v1 on your data.","Judge it against your task.","Change one part; run again.","Log the change and its effect.","Repeat until it meets the task.","Record your best version."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which change improved your output the most?","Why refine one change at a time?","Is your best prompt precise or just long?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My best prompt version is ...","The change that helped most was ... because ...","Next I will check ..."],"role":"reflect"}],"worksheet":{"title":"Week 5 - Lab - Worksheet | Trustworthy AI Helper - Build & Refine the Prompt (Part 1 Lab)","instructions":"Name: __________________________________  Class: ________________  Date: ________________","questions":[{"id":"g6-bridging-w5-lab-q1","type":"shortText","stem":"v1: ... | effect: ...\nv2: ... | change: ... | effect: ...\nBest version: ...","autoMarked":false,"lookFor":"Distinct versions where exactly ONE part of the prompt changes between them, each with its effect, ending in a named best version. Model: v1 'suggest a book' gave a vague list; v2 added 'one book, with a reason, using the survey' and the output became specific and justified. Watch for pairs changing several things at once, or assuming a longer prompt is a better prompt.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Log each prompt version, the change you made, and its effect."},{"id":"g6-bridging-w5-lab-q2","type":"shortText","stem":"Columns: Version | Change made | Effect on the output","autoMarked":false,"lookFor":"A complete log from v1 to the best version with a reasoned justification for the key change. This is the formative evidence for SD: iterates the prompt to a measurably better output and explains the causal reason for the improvement. For trial-and-error, prompt 'name the change and its effect'. Record SD as mastery/partial/not-yet.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Record each version, the change, and the effect on the output."},{"id":"g6-bridging-w5-lab-q3","type":"shortText","autoMarked":false,"lookFor":"Names a specific version, identifies a single change, and gives a causal reason for why that change improved the output (usually added detail, a named data source, or a required form). Reward a one-change improvement with a causal reason; 'it just got better' is partial.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Name your best prompt version and the one change that improved it most, with a reason."},{"id":"g6-bridging-w5-lab-q4","type":"shortText","autoMarked":false,"lookFor":"Recognises that detail added for accuracy can make the prompt longer and harder to follow, while a short clear prompt may leave the output vague - and names the balance they struck. Precise beats long; look for that judgement being made explicitly.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"prompt":"Refine your prompt for accuracy AND clarity at once. Explain the trade-off you had to balance."}]}},"g6-bridging-w6-core":{"id":"g6-bridging-w6-core","number":11,"week":6,"track":"bridging","type":"core","title":"Trustworthy AI Helper - Trace the Data & Plan Checks (Part 2 Core)","summary":"Students trace how the data driving their helper shapes its outcome, then plan a trusted-source verification and a risk check before trusting it.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Explain how the data used influences the helper's outcome, and predict a data change's effect.","Plan how you will verify the output and check for basic risks before trusting it."],"sections":[{"type":"text","body":["Your helper works - now make sure it can be trusted. Today you trace how the data shapes its outcome and plan how you will verify it and check its risks."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can explain how the data shapes my helper's outcome and predict a change.","I can plan a verification and a risk check for my helper."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Trace","definition":"To follow how the data leads to the outcome."},{"term":"Verify","definition":"To check a claim against a trusted, independent source."},{"term":"Risk","definition":"A way the output could be wrong, unsafe, biased, or a privacy problem."}],"role":"vocabulary"},{"type":"text","heading":"The data drives the outcome","body":["Change the data and the outcome changes. So you can [[trace]] which data drives which part of the output.","Knowing this helps you trust - or fix - your helper."],"role":"explain"},{"type":"text","heading":"Plan your checks","body":["Verification checks a claim against a trusted source - not by asking the AI again.","A [[risk]] check asks: could this be wrong, unsafe, biased, or a privacy problem, and how would I reduce it?"],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Trace the data's influence, then plan your verification and risk check."],"items":["Name the data that drives one part of your output.","Predict how a data change would alter the outcome.","Choose a claim to verify against a trusted source.","Name one risk and a way to reduce it.","Write your check plan."],"role":"activity"},{"type":"list","heading":"Think about it","items":["How does your data shape your outcome?","What is the most trustworthy way to verify a claim?","What is your helper's biggest risk?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["The data that most shapes my outcome is ...","I will verify ... against ...","My top risk is ... and I will reduce it by ..."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Core - Worksheet | Trustworthy AI Helper - Trace the Data & Plan Checks (Part 2 Core)","questions":[{"id":"g6-bridging-w6-core-q1","type":"shortText","autoMarked":false,"prompt":"Trace the data: explain how the data influences your outcome and predict a change.","stem":"The data ... drives the outcome because ...\nIf the data changed to ..., the outcome would ...","lookFor":"A specific data-to-outcome link plus a prediction - names which data drives which part of the output and says how the outcome would change if that data changed (model: the survey's most-picked genre drove the book suggestion; swapping in a class that prefers science would change the suggestion to a science book).","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-core-q2","type":"shortText","autoMarked":false,"prompt":"Plan your checks: plan a verification and a risk check.","stem":"Claim to verify: ... | trusted source: ...\nRisk: ... | how I will reduce it: ...","lookFor":"The verification must use a trusted, independent source rather than the same tool, and the named risk must come with a mitigation (model: verify 'most pupils prefer adventure' against the survey totals; risk of a duplicate biasing the suggestion, reduced by de-duplicating the data).","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-core-q3","type":"shortText","autoMarked":false,"prompt":"Trustworthy AI Helper Log - Part 2 (trace + check plan): record your data trace and your verification and risk plan.","stem":"Data -> outcome link | Verification plan | Risk + mitigation","lookFor":"The Core section of the Log is the assessment evidence. Mastery: explains the data's influence on the outcome, predicts a data change, and plans a trusted-source verification and a risk check with a mitigation. Partial: explanation or only one check planned.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-core-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket: explain how your data shapes your outcome, and name one claim you will verify and one risk you will reduce.","lookFor":"Links the data to the outcome, names one claim to be verified against a trusted source, and names one risk together with how it will be reduced.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-core-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch): find the single data change that would most alter your helper's outcome, and explain why it matters most.","lookFor":"Identifies the single data change with the largest effect and justifies it.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"}]}},"g6-bridging-w6-lab":{"id":"g6-bridging-w6-lab","number":12,"week":6,"track":"bridging","type":"lab","title":"Trustworthy AI Helper - Verify, De-risk & Showcase (Part 2 Lab)","summary":"Students carry out their verification and risk check, refine and re-verify if a check fails, then argue with evidence that their helper can be trusted and reflect across the four skills.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Carry out the verification and risk check, refine the helper if a check fails, and confirm it can be trusted.","Present the Trustworthy AI Helper and reflect on the thinking used across all four skills."],"sections":[{"type":"text","body":["Time to prove it. Today you verify your helper, reduce a risk, and show that it can be trusted then present it and reflect on everything you have learned."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can verify my helper's output and reduce a risk, refining if needed.","I can present my helper and reflect on my thinking."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"Mitigation","definition":"A change that reduces a risk."},{"term":"Trustworthy","definition":"Something you can rely on because you have checked it."},{"term":"Evidence","definition":"The proof you give for a claim or a judgement."}],"role":"vocabulary"},{"type":"text","heading":"Verify, then de-risk","body":["Verify a claim in your output against a trusted source. If it fails, refine and re-verify.","Run your risk check and apply a [[mitigation]] - then re-check that it worked."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","body":["Verify, de-risk, then showcase and reflect."],"items":["Verify your claim against a trusted source.","If it fails, refine and re-verify.","Run your risk check; apply one mitigation.","Confirm your helper can be trusted, with evidence.","Prepare a one-minute showcase.","Present and reflect."],"role":"activity"},{"type":"list","heading":"Think about it","items":["What did your verification find?","What risk did you reduce, and how?","Which of the four skills was hardest?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["My helper is trustworthy because ...","The check that mattered most was ...","The skill I found hardest was ... and I worked through it by ..."],"role":"reflect"}],"worksheet":{"title":"Week 6 - Lab - Worksheet | Trustworthy AI Helper - Verify, De-risk & Showcase (Part 2 Lab)","questions":[{"id":"g6-bridging-w6-lab-q1","type":"shortText","autoMarked":false,"prompt":"Verify & de-risk: record your verification and your risk mitigation.","stem":"Claim verified: ... | source: ... | result: ...\nRisk reduced: ... | how: ... | re-check: ...","lookFor":"A trusted source, not a re-ask of the tool, and a mitigation that was actually applied and then re-checked (model: 'adventure is the most-picked genre' verified against the survey totals and it held; a duplicate entry was removed and the helper re-run, making the suggestion fairer). If a check failed, look for a refinement and a re-verify.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-lab-q2","type":"shortText","autoMarked":false,"prompt":"Trust argument: argue, with evidence, why your helper can be trusted.","stem":"My helper can be trusted because ...","lookFor":"Argues trust from the checks actually carried out and cites that evidence, rather than asserting trust on its own.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-lab-q3","type":"shortText","autoMarked":false,"prompt":"Trustworthy AI Helper Log - Part 2 Lab (verify, de-risk, reflect): record your checks and reflect across the four skills.","stem":"Skill used | What I did / found | How trustworthy? (evidence)","lookFor":"Completed verification and risk mitigation on the Log, with evidence, plus reflection across the four skills - data quality, prompt refinement, data influence, and verification/risk. Mastery reflection also names a next step; partial reflects on some skills only.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-lab-q4","type":"shortText","autoMarked":false,"prompt":"Exit ticket: state whether your helper can be trusted and give two reasons (one verification, one risk mitigation).","lookFor":"States a judgement on whether the helper can be trusted and gives two reasons, one verification and one risk mitigation.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"},{"id":"g6-bridging-w6-lab-q5","type":"shortText","autoMarked":false,"prompt":"Challenge (stretch): your helper is safe for one use but risky for another. Explain the difference and propose a rule for when it should and should not be used.","lookFor":"Weighs a fairness/safety trade-off: distinguishes the safe use from the risky one and proposes a workable rule for when the helper should and should not be used.","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":5,"tier":"A","code":"AIF·CU·G5·A"},{"framework":"AIF","strand":"SD","grade":5,"tier":"A","code":"AIF·SD·G5·A"},{"framework":"AIF","strand":"CE","grade":4,"tier":"A","code":"AIF·CE·G4·A"},{"framework":"AIF","strand":"GE","grade":5,"tier":"A","code":"AIF·GE·G5·A"}],"evidenceType":"product","tierProbed":"advanced"}]}},"g6-main-w1-core":{"id":"g6-main-w1-core","number":1,"week":1,"track":"main","type":"core","title":"Unit Launch - Rule-Based vs Learning Systems","summary":"Students meet the term's big question by sorting three real systems into 'follows fixed rules' or 'learns from data', posting their own questions and helping agree the class responsible-use rules.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Generate at least two questions about how rule-based and learning systems differ.","Classify three systems as 'follows fixed rules' or 'learns from data', justifying each.","Co-construct the unit success criteria and the responsible-use norms for AI tools."],"sections":[{"type":"text","body":["Some machines are told every single step. Others are shown lots of examples and work out the pattern themselves. This term you become a system detective - can you tell which kind you are looking at?"],"role":"intro"},{"type":"list","heading":"I can…","items":["I can ask at least two genuine questions about rule-based and learning systems.","I can sort three systems into 'follows fixed rules' or 'learns from data' and give a reason for each.","I can help write our class responsible-use rules for AI tools."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-based system","definition":"A system that follows fixed steps a person wrote for it."},{"term":"learning system","definition":"A system that finds patterns from many examples instead of fixed rules."},{"term":"data","definition":"The examples or information a learning system is shown."},{"term":"model","definition":"The pattern a learning system builds from its data."},{"term":"example","definition":"One piece of data, like one photo or one email."}],"role":"vocabulary"},{"type":"text","heading":"Two kinds of machine","body":["A [[rule-based system]] is like a recipe. A person writes every step, and the machine follows them exactly. A Salik toll gate charges you when your car passes - a person set that rule.","A [[learning system]] is different. Nobody writes a rule for every case. Instead it is shown many examples - this is [[data]] - and it finds the pattern by itself. The pattern it builds is called a [[model]]."],"role":"explain"},{"type":"text","heading":"Why it matters","body":["If you know which kind a system is, you can guess when it might fail. A rule-based system fails when something happens that has no rule. A learning system can fail if it was shown poor or unfair examples.","Neither kind is magic, and neither understands like a person. That is why we always check what a machine tells us."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Time to be a detective. Sort three systems, then post the questions you most want answered this term."],"items":["Watch the two clips your teacher shows and spot which machine was told every step.","Sort the three cards into 'fixed rules' or 'learns from data'.","Write a reason under each card.","Post two questions on the class question wall.","Help agree one class rule for safe AI use."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which system was hardest to sort, and why?","What is one clue that a system learned from examples?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write one thing you now understand about how machines make decisions.","Write one question you still have."],"role":"reflect"}],"worksheet":{"title":"Week 1 - Core - Worksheet | Unit Launch - Rule-Based vs Learning Systems","questions":[{"id":"g6-main-w1-core-m-w1-core-q1","type":"shortText","autoMarked":false,"title":"Sort three systems","prompt":"Write each system in the correct column and give one reason.","stem":"This follows fixed rules because ___\nThis learns from data because ___","lookFor":"Sorts at least 2 of the 3 systems correctly with a sensible reason. The traffic-light timer is fixed rules - it changes lights on a set timer that a person programmed; accept 'learns' only if the student describes a smart signal that adapts to traffic data. The spam-email filter learns from data - it was trained on many example emails marked spam or not spam, and no person wrote a rule for every email.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-core-m-w1-core-q2","type":"shortText","autoMarked":false,"title":"My two questions","prompt":"Write two genuine questions about rule-based and learning systems for the question wall.","lookFor":"Poses at least two genuine, on-topic questions, for example 'How many examples does a system need before it learns well?'. Any genuine, on-topic question counts - reward curiosity over neatness.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-core-m-w1-core-q3","type":"shortText","autoMarked":false,"title":"System sort record","prompt":"Complete the table for the three systems you sorted. For each row record: System | Fixed rules or learns from data | My reason.","lookFor":"Each row carries a reason, not a guess - press for where the logic comes from. Model rows: traffic-light timer, fixed rules, 'it changes lights on a set timer that a person programmed'; spam-email filter, learns from data, 'it was trained on many example emails marked spam or not spam'. Accept 'learns' for the traffic-light timer only if the student describes a smart signal that adapts to traffic data.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-core-m-w1-core-q4","type":"shortText","autoMarked":false,"title":"Exit ticket","prompt":"In one sentence, how is a learning system different from a rule-based system?","lookFor":"Names where the logic comes from: a rule-based system does exactly what a person has written into it step by step, while a learning system is shown many examples and finds the pattern in that data. Watch for the misconception that a learning system is just a big set of fixed rules a programmer typed in.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-core-m-w1-core-q5","type":"shortText","autoMarked":false,"title":"Challenge (stretch)","prompt":"Invent your own system card and swap with a partner - can they classify and justify it?","lookFor":"Invents a fourth system card that can genuinely be classified, and challenges another pair to classify and justify it. Strong responses can explain which clue in their own card settles the classification.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]}]}},"g6-main-w1-lab":{"id":"g6-main-w1-lab","number":2,"week":1,"track":"main","type":"lab","title":"Rule vs Learning - Hands-On Exploration (Lab)","summary":"Working unplugged at two stations, students run a fixed rule-card machine and a learn-from-examples card game, log the differences and design a test that would reveal which kind an unknown system is.","duration":"45 minutes","strands":["CU","SD","CE","GE"],"objectives":["Explore a rule-based demo and a simple learning demo and log the differences you observe.","Devise a test that could tell whether a system follows rules or learns.","Predict what would break each system and check your prediction."],"sections":[{"type":"text","body":["Today you get your hands on two machines - one that never changes and one that learns from examples. Watch closely: their differences will jump out."],"role":"intro"},{"type":"list","heading":"I can…","items":["I can run the rule-card machine and the learn-from-examples game and record what each does.","I can log at least three differences I observed between them.","I can design a fair test that would reveal whether a system follows rules or learns."],"role":"objectives"},{"type":"vocabulary","heading":"Words to know","terms":[{"term":"rule-card machine","definition":"A fixed stack of if-then cards that always behaves the same way."},{"term":"example card","definition":"A labelled card the group learns a pattern from."},{"term":"pattern","definition":"The rule-of-thumb your group builds from the example cards."},{"term":"test input","definition":"A new input you give a system to see how it behaves."},{"term":"predictable","definition":"Behaves the same way every time for the same input."}],"role":"vocabulary"},{"type":"text","heading":"Two stations, two behaviours","body":["At Station A the [[rule-card machine]] never changes. Feed the same input twice and you get the same output twice. That is a rule-based system.","At Station B nobody gives you rules. You study [[example card]]s, build a [[pattern]], then classify new cards. That is a learning system in miniature."],"role":"explain"},{"type":"text","heading":"Design a fair test","body":["To tell the two apart, give each a brand-new, unusual input. A rule-based machine reacts the same as always or breaks. A learning system tries to match the pattern it built.","The best detectives write down exactly what they will try and what each result would mean."],"role":"explain"},{"type":"activity","label":"Let's try it - hands-on","heading":"Let's try it - hands-on","body":["Run both stations, log the differences, then design a test that would reveal which kind an unknown machine is."],"items":["Take a role: feeder, recorder or tester.","Run Station A with five inputs, including one strange one.","Run Station B: study examples, then sort five new cards.","Log at least three differences.","Write one test that would separate rules from learning."],"role":"activity"},{"type":"list","heading":"Think about it","items":["Which station was more predictable, and how did you know?","What made the learning game guess wrongly?"],"role":"discuss"},{"type":"list","heading":"My reflection","items":["Write the clearest difference you saw today.","Write what you would test first on a mystery machine."],"role":"reflect"}],"worksheet":{"title":"Week 1 - Lab - Worksheet | Rule vs Learning - Hands-On Exploration (Lab)","questions":[{"id":"g6-main-w1-lab-m-w1-lab-q1","type":"shortText","autoMarked":false,"title":"Station comparison","prompt":"Log what each station did for the same kind of input.","stem":"Station A always ___\nStation B changed when ___","lookFor":"Records behaviour actually observed, e.g. 'Station A always gave the same output; Station B's guesses changed as we saw more example cards.' Any accurate observed difference is valid.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-lab-m-w1-lab-q2","type":"shortText","autoMarked":false,"title":"Design a test","prompt":"Write a test that would tell whether a system follows rules or learns, and what each result would mean.","lookFor":"Designs a test that would truly separate rules from learning: give the system a brand-new, unusual input; if it always reacts the same way it is rule-based, if it adapts using patterns it likely learned. Accept any test using a novel input to reveal adaptation; if the test does not separate the two, model one strong test and have the group revise.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-lab-m-w1-lab-q3","type":"shortText","autoMarked":false,"title":"Difference log","prompt":"Record the differences you observed between the two stations. For each row record: What we tried | Station A did | Station B did.","lookFor":"Logs at least three accurate differences with detail rather than one repeated observation. Look for the unusual input at Station A being noted: it had no rule for it, so it stopped or gave a wrong answer.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-lab-m-w1-lab-q4","type":"shortText","autoMarked":false,"title":"Exit ticket","prompt":"What one input would you give a mystery machine to find out if it learns? Why?","lookFor":"Chooses a brand-new or unusual input and says what each outcome would mean - the same reaction every time points to fixed rules, while an attempt to match a pattern points to learning. A named input with a reason beats a general statement about testing.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]},{"id":"g6-main-w1-lab-m-w1-lab-q5","type":"shortText","autoMarked":false,"title":"Challenge (stretch)","prompt":"Add an unfair set of example cards to Station B and explain how it changed the pattern the group learned.","lookFor":"Adds a deliberately unfair set of example cards and explains how it changed the learned pattern. Strong responses reach the idea that quality and fairness of examples matter, not just how many there are - a few odd or wrong cards can make the guesses worse.","evidenceType":"product","tierProbed":"emerging","frameworkRefs":[{"framework":"AIF","strand":"CU","grade":6,"tier":"E","code":"AIF·CU·G6·E"},{"framework":"AIF","strand":"SD","grade":6,"tier":"E","code":"AIF·SD·G6·E"},{"framework":"AIF","strand":"CE","grade":6,"tier":"E","code":"AIF·CE·G6·E"},{"framework":"AIF","strand":"GE","grade":6,"tier":"E","code":"AIF·GE·G6·E"}]}]}}}};
}

